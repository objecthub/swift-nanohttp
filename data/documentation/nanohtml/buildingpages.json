{"abstract":[{"text":"Write small web pages as Swift code.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTML/documentation/NanoHTML"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTML/documentation/NanoHTML/BuildingPages"},"kind":"article","metadata":{"modules":[{"name":"NanoHTML"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Building Pages"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A page is built from element types (","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Html","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Body","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/H1","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/A","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Table","isActive":true,"type":"reference"},{"text":", …) whose content is a block. Text","type":"text"},{"text":" ","type":"text"},{"text":"is a string, attributes are set by methods of the element. ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/htmlHandler(_:)","isActive":true,"type":"reference"},{"text":" runs the block for every request and","type":"text"},{"text":" ","type":"text"},{"text":"answers with the page, as ","type":"text"},{"code":"text/html; charset=utf-8","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server[\"/\"] = htmlHandler { _ in","  Html {","    Head {","      Title(\"Demo\")","    }","    Body {","      H1(\"Routes\")","      Ul {","        for route in server.routes.sorted() {","          Li { A(route).href(route) }","        }","      }","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The block receives the request, so a page can show what was asked for: ","type":"text"},{"code":"htmlHandler { request in ... }","type":"codeVoice"},{"text":". It may","type":"text"},{"text":" ","type":"text"},{"text":"throw; the error is answered like the error of any other handler.","type":"text"}],"type":"paragraph"},{"anchor":"Text-attributes-and-content","level":3,"text":"Text, attributes and content","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"An element with text is written ","type":"text"},{"code":"P(\"text\")","type":"codeVoice"},{"text":", an element with content ","type":"text"},{"code":"Div { ... }","type":"codeVoice"},{"text":". In a block, a string is text","type":"text"},{"text":" ","type":"text"},{"text":"too: ","type":"text"},{"code":"P { \"Hello, \"; B(\"world\") }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Attributes are methods that return the changed element, so they follow the element, also after a block:","type":"text"},{"text":" ","type":"text"},{"code":"A(\"Sign in\").href(\"/login\")","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Form { ... }.method(\"POST\").action(\"/login\")","type":"codeVoice"},{"text":". There are methods for the usual","type":"text"},{"text":" ","type":"text"},{"text":"attributes (","type":"text"},{"code":"href","type":"codeVoice"},{"text":", ","type":"text"},{"code":"src","type":"codeVoice"},{"text":", ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"value","type":"codeVoice"},{"text":", ","type":"text"},{"code":"placeholder","type":"codeVoice"},{"text":", ","type":"text"},{"code":"style","type":"codeVoice"},{"text":", ","type":"text"},{"code":"width","type":"codeVoice"},{"text":", …), numbers where numbers make","type":"text"},{"text":" ","type":"text"},{"text":"sense (","type":"text"},{"code":"Img().width(300)","type":"codeVoice"},{"text":"), and ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLElement/attribute(_:_:)","isActive":true,"type":"reference"},{"text":" for any other: ","type":"text"},{"code":"Div().attribute(\"lang\", \"de\")","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"class","type":"codeVoice"},{"text":" adds to the class names that are there: ","type":"text"},{"code":"Div().class(\"card\").class(\"wide\")","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"class=\"card wide\"","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Every other attribute that is set again replaces its value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Attributes without a value are methods with an optional condition: ","type":"text"},{"code":"Input().autofocus()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Button(\"Save\").disabled(isBusy)","type":"codeVoice"},{"text":". A value of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" leaves an attribute out: ","type":"text"},{"code":"A(\"x\").title(maybeTitle)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLElement/data(_:_:)","isActive":true,"type":"reference"},{"text":" sets ","type":"text"},{"code":"data-","type":"codeVoice"},{"text":" attributes, ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLElement/aria(_:_:)","isActive":true,"type":"reference"},{"text":" sets ","type":"text"},{"code":"aria-","type":"codeVoice"},{"text":" attributes, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLElement/on(_:_:)","isActive":true,"type":"reference"},{"text":" the script of an event: ","type":"text"},{"code":"Button(\"x\").on(\"click\", \"go()\")","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://NanoHTML/documentation/NanoHTML/CustomElement","isActive":true,"type":"reference"},{"text":" writes an element that has no type of its own, for example a web component:","type":"text"},{"text":" ","type":"text"},{"code":"CustomElement(\"my-widget\") { ... }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Loops-and-conditions","level":3,"text":"Loops and conditions","type":"heading"},{"inlineContent":[{"text":"A block can contain ","type":"text"},{"code":"for","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if let","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":", so that a page is built from data:","type":"text"}],"type":"paragraph"},{"code":["let people = [\"Ada\": 36, \"Grace\": 85]","let table = Table {","  Thead { Tr { Th(\"Name\"); Th(\"Age\") } }","  Tbody {","    for (name, age) in people.sorted(by: { $0.key < $1.key }) where age > 18 {","      Tr { Td(name); Td(\"\\(age)\") }","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Functions can return nodes (","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLNode","isActive":true,"type":"reference"},{"text":"); ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Fragment","isActive":true,"type":"reference"},{"text":" returns several nodes without an element around them.","type":"text"}],"type":"paragraph"},{"anchor":"Escaping","level":3,"text":"Escaping","type":"heading"},{"inlineContent":[{"text":"Text and attribute values are ","type":"text"},{"inlineContent":[{"text":"escaped","type":"text"}],"type":"strong"},{"text":" when the page is rendered: ","type":"text"},{"code":"P(request.path)","type":"codeVoice"},{"text":" is safe, also if the path","type":"text"},{"text":" ","type":"text"},{"text":"contains ","type":"text"},{"code":"<script>","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Raw","isActive":true,"type":"reference"},{"text":" is the only way to write HTML as it is. Use it for markup that you wrote, for example","type":"text"},{"text":" ","type":"text"},{"code":"Raw(\"&copy;\")","type":"codeVoice"},{"text":", never for text from a request, a file or a database.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The content of ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Script","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Style","isActive":true,"type":"reference"},{"text":" is code: it is written as it is, and only a ","type":"text"},{"code":"</script","type":"codeVoice"},{"text":" that would end the","type":"text"},{"text":" ","type":"text"},{"text":"element early is changed to ","type":"text"},{"code":"<\\/script","type":"codeVoice"},{"text":". A script that is built from untrusted text is unsafe all the same, and so is a","type":"text"},{"text":" ","type":"text"},{"text":"URL in ","type":"text"},{"code":"href","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"src","type":"codeVoice"},{"text":" that you did not check (","type":"text"},{"code":"javascript:","type":"codeVoice"},{"text":" URLs are not filtered); event attributes are scripts too.","type":"text"}],"type":"paragraph"},{"anchor":"The-elements","level":3,"text":"The elements","type":"heading"},{"inlineContent":[{"text":"The element types are the ones of HTML that are not obsolete, with the tag name in capitalized form: ","type":"text"},{"code":"Div","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Ul","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Li","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Table","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Tr","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Td","type":"codeVoice"},{"text":", ","type":"text"},{"code":"H1","type":"codeVoice"},{"text":"…","type":"text"},{"code":"H6","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Form","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Input","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Button","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Select","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Option","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Img","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Script","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Style","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Meta","type":"codeVoice"},{"text":", and so on. Two names differ from the tag because the framework ","type":"text"},{"code":"Foundation","type":"codeVoice"},{"text":" has types of that name: ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/DataValue","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"<data>","type":"codeVoice"},{"text":" and ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/ProgressBar","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"<progress>","type":"codeVoice"},{"text":". Some names are also names of types in SwiftUI and AppKit (","type":"text"},{"code":"Button","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Label","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Form","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Table","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Menu","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Section","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Canvas","type":"codeVoice"},{"text":"): in a file that imports one of those frameworks, write the","type":"text"},{"text":" ","type":"text"},{"text":"module name, ","type":"text"},{"code":"NanoHTML.Button(...)","type":"codeVoice"},{"text":". Elements that were removed from HTML (","type":"text"},{"code":"center","type":"codeVoice"},{"text":", ","type":"text"},{"code":"font","type":"codeVoice"},{"text":", ","type":"text"},{"code":"marquee","type":"codeVoice"},{"text":", …) have no","type":"text"},{"text":" ","type":"text"},{"text":"type: use ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/CustomElement","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Elements that have no content (","type":"text"},{"code":"Br","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Img","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Input","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Meta","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hr","type":"codeVoice"},{"text":", …) have no end tag, and cannot be given","type":"text"},{"text":" ","type":"text"},{"text":"content. ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/Html","isActive":true,"type":"reference"},{"text":" writes the document type, ","type":"text"},{"code":"<!DOCTYPE html>","type":"codeVoice"},{"text":", before itself, so a handler that returns a fragment sends","type":"text"},{"text":" ","type":"text"},{"text":"a fragment.","type":"text"}],"type":"paragraph"},{"anchor":"Pages-as-responses","level":3,"text":"Pages as responses","type":"heading"},{"inlineContent":[{"identifier":"doc://NanoHTML/documentation/NanoHTML/htmlHandler(_:)","isActive":true,"type":"reference"},{"text":" is a shortcut. To answer with a page from any handler, use ","type":"text"},{"code":"NanoHTTPResponse.html(_:status:headers:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.notFoundHandler = { request in","  .html(Html { Body { P(\"There is nothing at \\(request.path).\") } }, status: 404)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A page is rendered at once, so the response has a length and the connection can be used again.","type":"text"}],"type":"paragraph"},{"anchor":"Things-to-know","level":3,"text":"Things to know","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Pages are values and share nothing. Building them needs no locks, on a server that uses a thread per connection as","type":"text"},{"text":" ","type":"text"},{"text":"well as on one that runs on one thread.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Attributes are written in the order in which they were set, so the output is the same on every run.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A page that is built from a template language, or a bundled file, is often the better choice for anything bigger.","type":"text"},{"text":" ","type":"text"},{"text":"This module is meant for small status and admin pages and for the user interface of a tool.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Coming-from-the-builder-of-1x","level":3,"text":"Coming from the builder of 1.x","type":"heading"},{"inlineContent":[{"text":"The closures and global variables of 1.x (","type":"text"},{"code":"html { body { h1 { inner = \"x\" } } }","type":"codeVoice"},{"text":") are gone, which also ends their clashes","type":"text"},{"text":" ","type":"text"},{"text":"with member names (","type":"text"},{"code":"name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"type","type":"codeVoice"},{"text":") and the lock that rendered pages one at a time.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"1.x","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"2.0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"html { body { ... } }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Html { Body { ... } }","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"h1 { inner = \"x\" }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"H1(\"x\")","type":"codeVoice"},{"text":" (the text is escaped)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a { href = u; inner = t }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"A(t).href(u)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"p { inner = htmlText }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"P { Raw(htmlText) }","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"classs = \"c\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"idd = \"i\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"forr = \"f\"","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":".class(\"c\")","type":"codeVoice"},{"text":", ","type":"text"},{"code":".id(\"i\")","type":"codeVoice"},{"text":", ","type":"text"},{"code":".for(\"f\")","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ul(items) { item in li { ... } }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Ul { for item in items { Li { ... } } }","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"element(\"x\", [\"data-id\": \"7\"]) { ... }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"CustomElement(\"x\") { ... }.data(\"id\", \"7\")","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"htmlHandler { ... }","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"htmlHandler { request in ... }","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"htmlHandler { ... }(request)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"htmlHandler { request in ... }","type":"codeVoice"},{"text":" (the block gets the request)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"center","type":"codeVoice"},{"text":", ","type":"text"},{"code":"font","type":"codeVoice"},{"text":", ","type":"text"},{"code":"marquee","type":"codeVoice"},{"text":", …","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"a style, or ","type":"text"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/CustomElement","isActive":true,"type":"reference"}],"type":"paragraph"}]]],"type":"table"}],"kind":"content"}],"references":{"doc://NanoHTML/documentation/NanoHTML":{"abstract":[{"text":"Build web pages in Swift: elements are values, text is escaped, and nothing is shared between pages.","type":"text"}],"identifier":"doc://NanoHTML/documentation/NanoHTML","kind":"symbol","role":"collection","title":"NanoHTML","type":"topic","url":"/documentation/nanohtml"},"doc://NanoHTML/documentation/NanoHTML/A":{"abstract":[{"text":"The ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" element: a link.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"A"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/A","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"A"}],"role":"symbol","title":"A","type":"topic","url":"/documentation/nanohtml/a"},"doc://NanoHTML/documentation/NanoHTML/Body":{"abstract":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" element: the content of the document.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Body"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/Body","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Body"}],"role":"symbol","title":"Body","type":"topic","url":"/documentation/nanohtml/body"},"doc://NanoHTML/documentation/NanoHTML/CustomElement":{"abstract":[{"text":"An element with a name of your choosing, for example a web component: ","type":"text"},{"code":"CustomElement(\"my-widget\")","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Its content and attributes are set like those of any other element. A name that is not valid","type":"text"},{"text":" ","type":"text"},{"text":"(letters, digits and ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", starting with a letter) leaves only the content.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomElement"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/CustomElement","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CustomElement"}],"role":"symbol","title":"CustomElement","type":"topic","url":"/documentation/nanohtml/customelement"},"doc://NanoHTML/documentation/NanoHTML/DataValue":{"abstract":[{"text":"The ","type":"text"},{"code":"data","type":"codeVoice"},{"text":" element: a value in a machine-readable form (the type is not called ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":", which is a Foundation type).","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"DataValue"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/DataValue","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DataValue"}],"role":"symbol","title":"DataValue","type":"topic","url":"/documentation/nanohtml/datavalue"},"doc://NanoHTML/documentation/NanoHTML/Fragment":{"abstract":[{"text":"Several nodes without an element around them, for example the result of a function that","type":"text"},{"text":" ","type":"text"},{"text":"returns the rows of a table.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Fragment"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/Fragment","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Fragment"}],"role":"symbol","title":"Fragment","type":"topic","url":"/documentation/nanohtml/fragment"},"doc://NanoHTML/documentation/NanoHTML/H1":{"abstract":[{"text":"The ","type":"text"},{"code":"h1","type":"codeVoice"},{"text":" element: a heading of level 1.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"H1"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/H1","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"H1"}],"role":"symbol","title":"H1","type":"topic","url":"/documentation/nanohtml/h1"},"doc://NanoHTML/documentation/NanoHTML/HTMLElement":{"abstract":[{"text":"An element of a page: a tag, attributes and content.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTMLElement"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLElement","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTMLElement"}],"role":"symbol","title":"HTMLElement","type":"topic","url":"/documentation/nanohtml/htmlelement"},"doc://NanoHTML/documentation/NanoHTML/HTMLElement/aria(_:_:)":{"abstract":[{"text":"Sets an ARIA attribute: ","type":"text"},{"code":"aria(\"label\", \"Close\")","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"aria-label=\"Close\"","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"aria"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"typeIdentifier","p