{"abstract":[{"text":"Returns a handler that answers with a page that a block builds. The block runs for","type":"text"},{"text":" ","type":"text"},{"text":"every request and receives the request, so that the page can show what the request","type":"text"},{"text":" ","type":"text"},{"text":"asked for.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTML/documentation/NanoHTML"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTML/documentation/NanoHTML/htmlHandler(_:)"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTML11htmlHandlery0A4HTTP0A12HTTPResponseVAC0A11HTTPRequestCKcAA8HTMLNode_pAGKcF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"htmlHandler"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTML8HTMLNodeP","text":"HTMLNode"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}],"modules":[{"name":"NanoHTML"}],"role":"symbol","roleHeading":"Function","symbolKind":"func","title":"htmlHandler(_:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"htmlHandler"},{"kind":"text","text":"("},{"kind":"attribute","text":"@"},{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLBuilder","kind":"attribute","preciseIdentifier":"s:8NanoHTML11HTMLBuilderO","text":"HTMLBuilder"},{"kind":"text","text":" "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"page"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" ("},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLNode","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTML8HTMLNodeP","text":"HTMLNode"},{"kind":"text","text":") -> "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Builds the page for a request.","type":"text"}],"type":"paragraph"}],"name":"page"}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"code":["let server = NanoHTTPServer()","server[\"/hello/:name\"] = htmlHandler { request in","  Html {","    Head { Title(\"Hello\") }","    Body {","      H1(\"Hello, \\(request.params[\"name\"] ?? \"world\")!\") // text is escaped","      Ul {","        for header in request.availableHeaders.sorted() {","          Li(\"\\(header): \\(request.header(header) ?? \"\")\")","        }","      }","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The block can throw: the error is answered like the error of any other handler. The","type":"text"},{"text":" ","type":"text"},{"text":"pages are built from values and share nothing, so the handler can run on several","type":"text"},{"text":" ","type":"text"},{"text":"threads at the same time, and needs no locks on a server that runs on one thread.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTML/documentation/NanoHTML":{"abstract":[{"text":"Build web pages in Swift: elements are values, text is escaped, and nothing is shared between pages.","type":"text"}],"identifier":"doc://NanoHTML/documentation/NanoHTML","kind":"symbol","role":"collection","title":"NanoHTML","type":"topic","url":"/documentation/nanohtml"},"doc://NanoHTML/documentation/NanoHTML/BuildingPages":{"abstract":[{"text":"Write small web pages as Swift code.","type":"text"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/BuildingPages","kind":"article","role":"collectionGroup","title":"Building Pages","type":"topic","url":"/documentation/nanohtml/buildingpages"},"doc://NanoHTML/documentation/NanoHTML/HTMLBuilder":{"abstract":[{"text":"The result builder for the content of elements. Inside a block, every expression is a","type":"text"},{"text":" ","type":"text"},{"text":"node or text, and ","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"else","type":"codeVoice"},{"text":", ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" decide what a page contains:","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTMLBuilder"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLBuilder","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTMLBuilder"}],"role":"symbol","title":"HTMLBuilder","type":"topic","url":"/documentation/nanohtml/htmlbuilder"},"doc://NanoHTML/documentation/NanoHTML/HTMLNode":{"abstract":[{"text":"A part of a page: an element, text, or several of them.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTMLNode"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/HTMLNode","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTMLNode"}],"role":"symbol","title":"HTMLNode","type":"topic","url":"/documentation/nanohtml/htmlnode"},"doc://NanoHTML/documentation/NanoHTML/htmlHandler(_:)":{"abstract":[{"text":"Returns a handler that answers with a page that a block builds. The block runs for","type":"text"},{"text":" ","type":"text"},{"text":"every request and receives the request, so that the page can show what the request","type":"text"},{"text":" ","type":"text"},{"text":"asked for.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"htmlHandler"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTML8HTMLNodeP","text":"HTMLNode"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTML/documentation/NanoHTML/htmlHandler(_:)","kind":"symbol","role":"symbol","title":"htmlHandler(_:)","type":"topic","url":"/documentation/nanohtml/htmlhandler(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client","type":"text"},{"text":" ","type":"text"},{"text":"and the variables of the route that matched. The server creates one for every request","type":"text"},{"text":" ","type":"text"},{"text":"and hands it to middleware and handlers. A request is a reference type, compared and","type":"text"},{"text":" ","type":"text"},{"text":"hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler":{"abstract":[{"text":"A function that answers a request. It runs on the thread of the connection that sent","type":"text"},{"text":" ","type":"text"},{"text":"the request, one request at a time per connection, and many handlers run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time for different connections (unless the server has only one thread). A handler may","type":"text"},{"text":" ","type":"text"},{"text":"block (a slow handler delays only its own connection) but must protect state that it","type":"text"},{"text":" ","type":"text"},{"text":"shares with other handlers.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"role":"symbol","title":"NanoHTTPRequestHandler","type":"topic","url":"/documentation/nanohttp/nanohttprequesthandler"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Essentials","generated":true,"identifiers":["doc://NanoHTML/documentation/NanoHTML/BuildingPages"],"title":"Essentials"}],"variants":[{"paths":["/documentation/nanohtml/htmlhandler(_:)"],"traits":[{"interfaceLanguage":"swift"}]}]}