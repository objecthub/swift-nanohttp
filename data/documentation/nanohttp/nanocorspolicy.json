://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy/init(allowedOrigins:allowedMethods:allowedHeaders:exposedHeaders:allowsCredentials:maxAge:)","kind":"symbol","role":"symbol","title":"init(allowedOrigins:allowedMethods:allowedHeaders:exposedHeaders:allowsCredentials:maxAge:)","type":"topic","url":"/documentation/nanohttp/nanocorspolicy/init(allowedorigins:allowedmethods:allowedheaders:exposedheaders:allowscredentials:maxage:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy/maxAge":{"abstract":[{"text":"How long a browser may remember the answer to a preflight request, in seconds. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" leaves it out.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxAge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy/maxAge","kind":"symbol","role":"symbol","title":"maxAge","type":"topic","url":"/documentation/nanohttp/nanocorspolicy/maxage"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie":{"abstract":[{"text":"A cookie that a response asks the client to store (","type":"text"},{"code":"Set-Cookie","type":"codeVoice"},{"text":", RFC 6265).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPCookie"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPCookie"}],"role":"symbol","title":"NanoHTTPCookie","type":"topic","url":"/documentation/nanohttp/nanohttpcookie"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError":{"abstract":[{"text":"An error that a handler throws to answer a request with an error status code.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPError"}],"role":"symbol","title":"NanoHTTPError","type":"topic","url":"/documentation/nanohttp/nanohttperror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware":{"abstract":[{"text":"A function that wraps the handling of requests, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","isActive":true,"type":"reference"},{"text":". It receives the","type":"text"},{"text":" ","type":"text"},{"text":"request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", which stands for the rest of the chain: the following middleware, the router and","type":"text"},{"text":" ","type":"text"},{"text":"the handler. Calling ","type":"text"},{"code":"next(request)","type":"codeVoice"},{"text":" lets the request through and gives the response; a middleware","type":"text"},{"text":" ","type":"text"},{"text":"may change the request before, change the response afterwards, catch an error that ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" throws, or","type":"text"},{"text":" ","type":"text"},{"text":"answer the request itself and never call ","type":"text"},{"code":"next","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPMiddleware"}],"role":"symbol","title":"NanoHTTPMiddleware","type":"topic","url":"/documentation/nanohttp/nanohttpmiddleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser":{"abstract":[{"text":"Reads HTTP requests from a socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParser"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParser"}],"role":"symbol","title":"NanoHTTPParser","type":"topic","url":"/documentation/nanohttp/nanohttpparser"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError":{"abstract":[{"text":"The reasons why ","type":"text"},{"code":"NanoHTTPParser","type":"codeVoice"},{"text":" refuses a request. A server answers requests that fail with","type":"text"},{"text":" ","type":"text"},{"text":"one of these errors with the matching HTTP status code and closes the connection; failures of","type":"text"},{"text":" ","type":"text"},{"text":"the connection itself (peer closed, reset) surface as ","type":"text"},{"code":"NanoSocketError","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParserError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParserError"}],"role":"symbol","title":"NanoHTTPParserError","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client and the","type":"text"},{"text":" ","type":"text"},{"text":"variables of the route that matched. The server creates one for every request and hands it to","type":"text"},{"text":" ","type":"text"},{"text":"middleware and handlers. A request is a reference type, compared and hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler":{"abstract":[{"text":"A function that answers a request. It runs on the thread of the connection that sent the request,","type":"text"},{"text":" ","type":"text"},{"text":"one request at a time per connection, and many handlers run at the same time for different","type":"text"},{"text":" ","type":"text"},{"text":"connections (unless the server has only one thread). A handler may block (a slow handler delays only","type":"text"},{"text":" ","type":"text"},{"text":"its own connection) but must protect state that it shares with other handlers.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"role":"symbol","title":"NanoHTTPRequestHandler","type":"topic","url":"/documentation/nanohttp/nanohttprequesthandler"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse":{"abstract":[{"text":"The answer to a request: a status code, headers and a body. Use the static functions to create","type":"text"},{"text":" ","type":"text"},{"text":"the common responses:","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponse"}],"role":"symbol","title":"NanoHTTPResponse","type":"topic","url":"/documentation/nanohttp/nanohttpresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)":{"abstract":[{"text":"A body that a function writes to the connection, for content that is not available as a whole","type":"text"},{"text":" ","type":"text"},{"text":"or too large to hold in memory. Whatever the function writes is sent at once. Its length is not","type":"text"},{"text":" ","type":"text"},{"text":"known, so the body is sent in chunks (","type":"text"},{"code":"Transfer-Encoding: chunked","type":"codeVoice"},{"text":") and the connection can be used for","type":"text"},{"text":" ","type":"text"},{"text":"the next request; an HTTP/1.0 client, which does not know chunks, gets the body up to the end of the","type":"text"},{"text":" ","type":"text"},{"text":"connection. If the handler sets a ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" header, the body is sent with that length instead: the","type":"text"},{"text":" ","type":"text"},{"text":"function has to write exactly that many bytes, or the connection is closed after the response.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A22HTTPResponseBodyWriterP","text":"NanoHTTPResponseBodyWriter"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contentType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","kind":"symbol","role":"symbol","title":"NanoHTTPResponse.Body.custom(_:contentType:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/body-swift.enum/custom(_:contenttype:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter":{"abstract":[{"text":"Receives the body of a response while a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","isActive":true,"type":"reference"},{"text":" function","type":"text"},{"text":" ","type":"text"},{"text":"produces it. The writer is the connection: whatever is written is sent to the client at once, so the","type":"text"},{"text":" ","type":"text"},{"text":"function can stream content of any size.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"role":"symbol","title":"NanoHTTPResponseBodyWriter","type":"topic","url":"/documentation/nanohttp/nanohttpresponsebodywriter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware":{"abstract":[{"text":"Functions that wrap the handling of every request, in the order of the array: the first one is the","type":"text"},{"text":" ","type":"text"},{"text":"outermost. A middleware receives the request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", the rest of the chain: the middleware after it,","type":"text"},{"text":" ","type":"text"},{"text":"and finally the router and the handler. It lets the request through by calling ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", and can","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"middleware"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPMiddlewarea","text":"NanoHTTPMiddleware"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","kind":"symbol","role":"symbol","title":"middleware","type":"topic","url":"/documentation/nanohttp/nanohttpserver/middleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware":{"abstract":[{"text":"Middleware for the usual jobs of a server that web pages talk to. They are values of the type","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","isActive":true,"type":"reference"},{"text":": add them to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoMiddleware"}],"role":"symbol","title":"NanoMiddleware","type":"topic","url":"/documentation/nanohttp/nanomiddleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware/cors(_:)":{"abstract":[{"text":"Lets the pages of other sites use the server, as the policy says. A request that has an ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" ","type":"text"},{"text":"header is a request of a page; the middleware","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cors"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10CORSPolicyV","text":"NanoCORSPolicy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPMiddlewarea","text":"NanoHTTPMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware/cors(_:)","kind":"symbol","role":"symbol","title":"cors(_:)","type":"topic","url":"/documentation/nanohttp/nanomiddleware/cors(_:)"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Requests-and-responses","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","doc://NanoHTTP/docum