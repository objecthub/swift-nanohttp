c://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/automatic","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.HostPolicy.automatic","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/hostpolicy-swift.enum/automatic"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/any":{"abstract":[{"text":"Every ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":". This is the default.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"any"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/any","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.OriginPolicy.any","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.enum/any"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/sameOrigin":{"abstract":[{"text":"Only pages of the server itself: the ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" of a request has to be the address that the request was","type":"text"},{"text":" ","type":"text"},{"text":"sent to (its ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":"). A request from the page of another site, and one from a page that has no origin","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Origin: null","type":"codeVoice"},{"text":": a local file, a sandboxed frame) is refused.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sameOrigin"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/sameOrigin","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.OriginPolicy.sameOrigin","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.enum/sameorigin"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/hostPolicy-swift.property":{"abstract":[{"text":"Which ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":" headers the server answers. A web page can reach a server on this machine too: with","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"DNS rebinding","type":"text"}],"type":"emphasis"},{"text":" the page’s own domain is made to point to ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":", and the browser then sends","type":"text"},{"text":" ","type":"text"},{"text":"requests to the server with that domain as ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":", and lets the page read the answers. A server that","type":"text"},{"text":" ","type":"text"},{"text":"only accepts its own names is not fooled. The default is ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/any","isActive":true,"type":"reference"},{"text":", which accepts every","type":"text"},{"text":" ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":"; ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/automatic","isActive":true,"type":"reference"},{"text":" is what a server that is used from the browser of the same machine","type":"text"},{"text":" ","type":"text"},{"text":"should switch on. Requests that are refused get ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hostPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV10HostPolicyO","text":"HostPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/hostPolicy-swift.property","kind":"symbol","role":"symbol","title":"hostPolicy","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/hostpolicy-swift.property"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/originPolicy-swift.property":{"abstract":[{"text":"Which ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" headers the server answers, for the requests that change something (everything but","type":"text"},{"text":" ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HEAD","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OPTIONS","type":"codeVoice"},{"text":") and for WebSocket handshakes. A browser sends the ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" of the page","type":"text"},{"text":" ","type":"text"},{"text":"with them, so that a page of another site that makes the browser send a request to this server","type":"text"},{"text":" ","type":"text"},{"text":"(a form that is submitted, a ","type":"text"},{"code":"fetch","type":"codeVoice"},{"text":", a WebSocket) can be told from the pages of the server itself.","type":"text"},{"text":" ","type":"text"},{"text":"Requests without an ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" (from tools that are not browsers) are always served. The default is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/any","isActive":true,"type":"reference"},{"text":"; ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/sameOrigin","isActive":true,"type":"reference"},{"text":" refuses requests that come from pages of other","type":"text"},{"text":" ","type":"text"},{"text":"sites with ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"originPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV12OriginPolicyO","text":"OriginPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/originPolicy-swift.property","kind":"symbol","role":"symbol","title":"originPolicy","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.property"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)":{"abstract":[{"text":"Serves a connection: calls the handler of its first request, sends the response and, as long as","type":"text"},{"text":" ","type":"text"},{"text":"the connection is kept alive, does the same for the following requests. Returns when the","type":"text"},{"text":" ","type":"text"},{"text":"connection has ended. Runs on the thread of the connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"connection"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPConnectionV","text":"NanoHTTPConnection"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","kind":"symbol","role":"symbol","title":"handle(connection:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/handle(connection:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/response(for:to:)":{"abstract":[{"text":"The response for a request whose handler (or middleware) threw ","type":"text"},{"code":"error","type":"codeVoice"},{