eepAlive","type":"codeVoice"},{"text":" forces it to","type":"text"},{"text":" ","type":"text"},{"text":"close. The response says ","type":"text"},{"code":"Connection: close","type":"codeVoice"},{"text":" if the connection is going to be","type":"text"},{"text":" ","type":"text"},{"text":"closed. A response to a ","type":"text"},{"code":"HEAD","type":"codeVoice"},{"text":" request has no body. A response whose body is a","type":"text"},{"text":" ","type":"text"},{"text":"socket session (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:_:)","isActive":true,"type":"reference"},{"text":", WebSocket) runs the","type":"text"},{"text":" ","type":"text"},{"text":"session first and ends the connection afterwards.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection":{"abstract":[{"text":"A request that has been read from a connection, together with the handler that will","type":"text"},{"text":" ","type":"text"},{"text":"answer it. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" drives the connection with it:","type":"text"},{"text":" ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" writes the response and returns the connection for the next request, or","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the connection has ended.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","t