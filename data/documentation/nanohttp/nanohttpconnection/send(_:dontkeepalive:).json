nanohttpresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:_:)":{"abstract":[{"text":"A ","type":"text"},{"code":"101 Switching Protocols","type":"codeVoice"},{"text":" response. After the response was sent, ","type":"text"},{"code":"socketSession","type":"codeVoice"},{"text":" ","type":"text"},{"text":"runs on the thread of the connection and owns the socket until it returns; the","type":"text"},{"text":" ","type":"text"},{"text":"connection is closed afterwards.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchProtocols"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], ("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A6SocketC","text":"NanoSocket"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:_:)","kind":"symbol","role":"symbol","title":"switchProtocols(_:_:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/switchprotocols(_:_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)":{"abstract":[{"text":"Serves a connection: calls the handler of its first request, sends the response and,","type":"text"},{"text":" ","type":"text"},{"text":"as long as the connection is kept alive, does the same for the following requests.","type":"text"},{"text":" ","type":"text"},{"text":"Returns when the connection has ended. Runs on the thread of the connection.","type":"text"}],"fragments":[{"kind":"keyword","text"