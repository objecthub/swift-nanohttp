{"abstract":[{"text":"A cookie that a response asks the client to store (","type":"text"},{"code":"Set-Cookie","type":"codeVoice"},{"text":", RFC 6265).","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A10HTTPCookieV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPCookie"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoHTTPCookie"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"NanoHTTPCookie"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPCookie"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"code":["let server = NanoHTTPServer()","server.get[\"/login\"] = { request in","  var response = NanoHTTPResponse.seeOther(\"/home\")","  response.setCookie(NanoHTTPCookie(name: \"session\", value: \"a1b2c3\", maxAge: 3600))","  // Set-Cookie: session=a1b2c3; Path=/; Max-Age=3600; HttpOnly; SameSite=Lax","  return response","}","server.get[\"/home\"] = { request in","  .ok(.text(\"Hello, \\(request.cookie(\"session\") ?? \"stranger\")\"))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A new cookie is made for the common case: it is sent for every path (","type":"text"},{"code":"Path=/","type":"codeVoice"},{"text":"), is","type":"text"},{"text":" ","type":"text"},{"text":"hidden from scripts (","type":"text"},{"code":"HttpOnly","type":"codeVoice"},{"text":"), and is not sent along with requests that other sites","type":"text"},{"text":" ","type":"text"},{"text":"cause (","type":"text"},{"code":"SameSite=Lax","type":"codeVoice"},{"text":"). It is not ","type":"text"},{"code":"Secure","type":"codeVoice"},{"text":", because that would keep browsers from","type":"text"},{"text":" ","type":"text"},{"text":"sending it back to a server that does not speak TLS (the browsers that accept a","type":"text"},{"text":" ","type":"text"},{"code":"Secure","type":"codeVoice"},{"text":" cookie from ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" are the exception): set ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/secure","isActive":true,"type":"reference"},{"text":" when the server","type":"text"},{"text":" ","type":"text"},{"text":"runs behind a proxy that terminates TLS. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/sameSite-swift.property","isActive":true,"type":"reference"},{"text":" set to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/SameSite-swift.enum/unrestricted","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"is only accepted by browsers together with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/secure","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The value can be any text: the characters that RFC 6265 does not allow in a cookie","type":"text"},{"text":" ","type":"text"},{"text":"(spaces, ","type":"text"},{"code":";","type":"codeVoice"},{"text":", ","type":"text"},{"code":",","type":"codeVoice"},{"text":", quotes, backslashes, ","type":"text"},{"code":"%","type":"codeVoice"},{"text":", and everything that is not ASCII) are","type":"text"},{"text":" ","type":"text"},{"text":"percent-encoded when the cookie is sent, and ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/cookies","isActive":true,"type":"reference"},{"text":" decodes them","type":"text"},{"text":" ","type":"text"},{"text":"again. A cookie that cannot be sent safely is left out of the response, and a warning","type":"text"},{"text":" ","type":"text"},{"text":"is logged: a name that is not a token (it has a space, ","type":"text"},{"code":"=","type":"codeVoice"},{"text":", ","type":"text"},{"code":";","type":"codeVoice"},{"text":" or a control","type":"text"},{"text":" ","type":"text"},{"text":"character, for example), and a ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"domain","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":";","type":"codeVoice"},{"text":" or a control character,","type":"text"},{"text":" ","type":"text"},{"text":"which would add attributes of the sender’s choosing.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/SQ":{"identifier":"doc://NanoHTTP/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy":{"abstract":[{"text":"The rules of ","type":"text"},{"inlineContent":[{"text":"cross-origin resource sharing","type":"text"}],"type":"emphasis"},{"text":" (CORS), which decide what the pages of","type":"text"},{"text":" ","type":"text"},{"text":"other sites may do with a server: a browser lets a page read the answer of another","type":"text"},{"text":" ","type":"text"},{"text":"site’s server only if the answer says that the page’s origin is allowed. Use it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware/cors(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoCORSPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoCORSPolicy"}],"role":"symbol","title":"NanoCORSPolicy","type":"topic","url":"/documentation/nanohttp/nanocorspolicy"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie":{"abstract":[{"text":"A cookie that a response asks the client to store (","type":"text"},{"code":"Set-Cookie","type":"codeVoice"},{"text":", RFC 6265).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPCookie"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPCookie"}],"role":"symbol","title":"NanoHTTPCookie","type":"topic","url":"/documentation/nanohttp/nanohttpcookie"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/Equatable-Implementations":{"abstract":[],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/Equatable-Implementations","kind":"article","role":"collectionGroup","title":"Equatable Implementations","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/equatable-implementations"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/SameSite-swift.enum":{"abstract":[{"text":"The ","type":"text"},{"code":"SameSite","type":"codeVoice"},{"text":" attribute: when the client sends the cookie along with requests that","type":"text"},{"text":" ","type":"text"},{"text":"are caused by other sites.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SameSite"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/SameSite-swift.enum","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SameSite"}],"role":"symbol","title":"NanoHTTPCookie.SameSite","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/samesite-swift.enum"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/SameSite-swift.enum/unrestricted":{"abstract":[{"text":"With every request. Browsers only accept this together with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/secure","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"(Not called ","type":"text"},{"code":"none","type":"codeVoice"},{"text":": ","type":"text"},{"code":"sameSite: .none","type":"codeVoice"},{"text":" would mean ","type":"text"},{"code":"Optional.none","type":"codeVoice"},{"text":", no attribute at","type":"text"},{"text":" ","type":"text"},{"text":"all.)","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unrestricted"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/SameSite-swift.enum/unrestricted","kind":"symbol","role":"symbol","title":"NanoHTTPCookie.SameSite.unrestricted","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/samesite-swift.enum/unrestricted"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/domain":{"abstract":[{"text":"The site (and its subdomains) that the cookie is sent to; without it only the host","type":"text"},{"text":" ","type":"text"},{"text":"that set the cookie receives it.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"domain"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/domain","kind":"symbol","role":"symbol","title":"domain","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/domain"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/expired(name:path:domain:)":{"abstract":[{"text":"A cookie that deletes the cookie of the same name, path and domain at the client: it","type":"text"},{"text":" ","type":"text"},{"text":"is empty and has ended.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expired"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"domain"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPCookieV","text":"NanoHTTPCookie"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/expired(name:path:domain:)","kind":"symbol","role":"symbol","title":"expired(name:path:domain:)","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/expired(name:path:domain:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/expires":{"abstract":[{"text":"When the cookie ends. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/maxAge","isActive":true,"type":"reference"},{"text":" takes precedence in browsers that know it.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"expires"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/expires","kind":"symbol","role":"symbol","title":"expires","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/expires"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/httpOnly":{"abstract":[{"text":"Whether the cookie is hidden from scripts of the page (","type":"text"},{"code":"document.cookie","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"httpOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/httpOnly","kind":"symbol","role":"symbol","title":"httpOnly","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/httponly"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/init(name:value:path:domain:maxAge:expires:secure:httpOnly:sameSite:)":{"abstract":[{"text":"Creates a cookie.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"domain"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"maxAge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"expires"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"secure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"httpOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sameSite"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPCookieV8SameSiteO","text":"SameSite"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/init(name:value:path:domain:maxAge:expires:secure:httpOnly:sameSite:)","kind":"symbol","role":"symbol","title":"init(name:value:path:domain:maxAge:expires:secure:httpOnly:sameSite:)","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/init(name:value:path:domain:maxage:expires:secure:httponly:samesite:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/maxAge":{"abstract":[{"text":"How long the cookie lives, in seconds; ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (or less) deletes it. Without it (and","type":"text"},{"text":" ","type":"text"},{"text":"without ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/expires","isActive":true,"type":"reference"},{"text":") the cookie lasts until the client ends its session.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxAge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/maxAge","kind":"symbol","role":"symbol","title":"maxAge","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/maxage"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/name":{"abstract":[{"text":"The name of the cookie; it has to be a token (letters, digits and ","type":"text"},{"code":"!#$%&'*+-.^_","type":"codeVoice"},{"text":"|~`).","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/name","kind":"symbol","role":"symbol","title":"name","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/name"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/path":{"abstract":[{"text":"The paths of the site that the cookie is sent for, and their sub-paths. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" leaves","type":"text"},{"text":" ","type":"text"},{"text":"it to the client, which uses the directory of the request.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/path","kind":"symbol","role":"symbol","title":"path","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/path"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/sameSite-swift.property":{"abstract":[{"text":"Whether the cookie is sent with requests that other sites cause, ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for no attribute.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sameSite"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPCookieV8SameSiteO","text":"SameSite"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/sameSite-swift.property","kind":"symbol","role":"symbol","title":"sameSite","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/samesite-swift.property"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/secure":{"abstract":[{"text":"Whether the cookie is only sent over a secure connection (","type":"text"},{"code":"https","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"secure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/secure","kind":"symbol","role":"symbol","title":"secure","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/secure"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/value":{"abstract":[{"text":"The text of the cookie, see the type’s documentation for how it is encoded.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie/value","kind":"symbol","role":"symbol","title":"value","type":"topic","url":"/documentation/nanohttp/nanohttpcookie/value"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError":{"abstract":[{"text":"An error that a handler throws to answer a request with an error status code.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPError"}],"role":"symbol","title":"NanoHTTPError","type":"topic","url":"/documentation/nanohttp/nanohttperror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware":{"abstract":[{"text":"A function that wraps the handling of requests, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","isActive":true,"type":"reference"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"receives the request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", which stands for the rest of the chain: the following","type":"text"},{"text":" ","type":"text"},{"text":"middleware, the router and the handler. Calling ","type":"text"},{"code":"next(request)","type":"codeVoice"},{"text":" lets the request","type":"text"},{"text":" ","type":"text"},{"text":"through and gives the response; a middleware may change the request before, change the","type":"text"},{"text":" ","type":"text"},{"text":"response afterwards, catch an error that ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" throws, or answer the request itself","type":"text"},{"text":" ","type":"text"},{"text":"and never call ","type":"text"},{"code":"next","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPMiddleware"}],"role":"symbol","title":"NanoHTTPMiddleware","type":"topic","url":"/documentation/nanohttp/nanohttpmiddleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser":{"abstract":[{"text":"Reads HTTP requests from a socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParser"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParser"}],"role":"symbol","title":"NanoHTTPParser","type":"topic","url":"/documentation/nanohttp/nanohttpparser"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError":{"abstract":[{"text":"The reasons why ","type":"text"},{"code":"NanoHTTPParser","type":"codeVoice"},{"text":" refuses a request. A server answers requests that","type":"text"},{"text":" ","type":"text"},{"text":"fail with one of these errors with the matching HTTP status code and closes the","type":"text"},{"text":" ","type":"text"},{"text":"connection; failures of the connection itself (peer closed, reset) surface as","type":"text"},{"text":" ","type":"text"},{"code":"NanoSocketError","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParserError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParserError"}],"role":"symbol","title":"NanoHTTPParserError","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client","type":"text"},{"text":" ","type":"text"},{"text":"and the variables of the route that matched. The server creates one for every request","type":"text"},{"text":" ","type":"text"},{"text":"and hands it to middleware and handlers. A request is a reference type, compared and","type":"text"},{"text":" ","type":"text"},{"text":"hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/cookies":{"abstract":[{"text":"The cookies that the client sent (the ","type":"text"},{"code":"Cookie","type":"codeVoice"},{"text":" header), by name. The values are","type":"text"},{"text":" ","type":"text"},{"text":"percent-decoded once, as the values of the query and the route variables are, which","type":"text"},{"text":" ","type":"text"},{"text":"is how ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie","isActive":true,"type":"reference"},{"text":" writes them; a pair of quotes around a value is removed.","type":"text"},{"text":" ","type":"text"},{"text":"If a name appears twice the first cookie counts: it is the one with the most","type":"text"},{"text":" ","type":"text"},{"text":"specific path. Entries without a name or without ","type":"text"},{"code":"=","type":"codeVoice"},{"text":" are ignored.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cookies"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/cookies","kind":"symbol","role":"symbol","title":"cookies","type":"topic","url":"/documentation/nanohttp/nanohttprequest/cookies"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler":{"abstract":[{"text":"A function that answers a request. It runs on the thread of the connection that sent","type":"text"},{"text":" ","type":"text"},{"text":"the request, one request at a time per connection, and many handlers run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time for different connections (unless the server has only one thread). A handler may","type":"text"},{"text":" ","type":"text"},{"text":"block (a slow handler delays only its own connection) but must protect state that it","type":"text"},{"text":" ","type":"text"},{"text":"shares with other handlers.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"role":"symbol","title":"NanoHTTPRequestHandler","type":"topic","url":"/documentation/nanohttp/nanohttprequesthandler"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse":{"abstract":[{"text":"The answer to a request: a status code, headers and a body. Use the static functions","type":"text"},{"text":" ","type":"text"},{"text":"to create the common responses:","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponse"}],"role":"symbol","title":"NanoHTTPResponse","type":"topic","url":"/documentation/nanohttp/nanohttpresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)":{"abstract":[{"text":"A body that a function writes to the connection, for content that is not available as","type":"text"},{"text":" ","type":"text"},{"text":"a whole or too large to hold in memory. Whatever the function writes is sent at once.","type":"text"},{"text":" ","type":"text"},{"text":"Its length is not known, so the body is sent in chunks (","type":"text"},{"code":"Transfer-Encoding: chunked","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and the connection can be used for the next request; an HTTP/1.0 client, which does","type":"text"},{"text":" ","type":"text"},{"text":"not know chunks, gets the body up to the end of the connection. If the handler sets a","type":"text"},{"text":" ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" header, the body is sent with that length instead: the function has","type":"text"},{"text":" ","type":"text"},{"text":"to write exactly that many bytes, or the connection is closed after the response.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A22HTTPResponseBodyWriterP","text":"NanoHTTPResponseBodyWriter"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contentType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","kind":"symbol","role":"symbol","title":"NanoHTTPResponse.Body.custom(_:contentType:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/body-swift.enum/custom(_:contenttype:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter":{"abstract":[{"text":"Receives the body of a response while a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"function produces it. The writer is the connection: whatever is written is sent to the","type":"text"},{"text":" ","type":"text"},{"text":"client at once, so the function can stream content of any size.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"role":"symbol","title":"NanoHTTPResponseBodyWriter","type":"topic","url":"/documentation/nanohttp/nanohttpresponsebodywriter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware":{"abstract":[{"text":"Functions that wrap the handling of every request, in the order of the array: the","type":"text"},{"text":" ","type":"text"},{"text":"first one is the outermost. A middleware receives the request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", the rest","type":"text"},{"text":" ","type":"text"},{"text":"of the chain: the middleware after it, and finally the router and the handler. It","type":"text"},{"text":" ","type":"text"},{"text":"lets the request through by calling ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", and can","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"middleware"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPMiddlewarea","text":"NanoHTTPMiddleware"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","kind":"symbol","role":"symbol","title":"middleware","type":"topic","url":"/documentation/nanohttp/nanohttpserver/middleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware":{"abstract":[{"text":"Middleware for the usual jobs of a server that web pages talk to. They are values of","type":"text"},{"text":" ","type":"text"},{"text":"the type ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","isActive":true,"type":"reference"},{"text":": add them to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoMiddleware"}],"role":"symbol","title":"NanoMiddleware","type":"topic","url":"/documentation/nanohttp/nanomiddleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware/cors(_:)":{"abstract":[{"text":"Lets the pages of other sites use the server, as the policy says. A request that has","type":"text"},{"text":" ","type":"text"},{"text":"