{"abstract":[{"text":"The answer to a request that is sent later, from any thread.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A20HTTPDeferredResponseC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPDeferredResponse"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoHTTPDeferredResponse"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NanoHTTPDeferredResponse"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPDeferredResponse"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" normally answers a request before it returns.","type":"text"},{"text":" ","type":"text"},{"text":"A subclass that hands its requests to other threads (a pool of workers, a queue that","type":"text"},{"text":" ","type":"text"},{"text":"another runtime serves, a long-running job) calls ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection/deferResponse()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"instead, passes the result on, and returns. Whoever has the answer calls","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/send(_:dontKeepAlive:)","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["// file scope","final class ExampleQueueServer: NanoHTTPServer {","  let workers = DispatchQueue(label: \"workers\", attributes: .concurrent)","","  override func handle(connection: NanoHTTPConnection) {","    let pending = connection.deferResponse()","    let response = connection.response() // the route that matches; it may do the work itself","    self.workers.async {","      pending.send(response)","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"What the server does meanwhile, in both threading modes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The server ","type":"text"},{"inlineContent":[{"text":"writes the answer itself","type":"text"}],"type":"strong"},{"text":", on a thread of its own (the thread of a","type":"text"},{"text":" ","type":"text"},{"text":"connection, or the only thread of the server), and waits for the next request of the","type":"text"},{"text":" ","type":"text"},{"text":"connection there. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/send(_:dontKeepAlive:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"returns at once: the thread that answers never waits for a client that is slow to","type":"text"},{"text":" ","type":"text"},{"text":"read the response or to send its next request. The next request of a connection that","type":"text"},{"text":" ","type":"text"},{"text":"is kept alive arrives in ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" again, like any","type":"text"},{"text":" ","type":"text"},{"text":"other request.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A connection that waits for its answer is ","type":"text"},{"inlineContent":[{"text":"not read and does not time out","type":"text"}],"type":"strong"},{"text":": neither","type":"text"},{"text":" ","type":"text"},{"text":"the idle timeout nor the read timeout applies, and a request that the client has","type":"text"},{"text":" ","type":"text"},{"text":"already sent behind the first (pipelining) is not handled before the first has been","type":"text"},{"text":" ","type":"text"},{"text":"answered. It counts as an open connection","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections","isActive":true,"type":"reference"},{"text":"), and it ends when the server stops.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A token that is released without an answer (its owner forgot it, or failed)","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"closes the connection","type":"text"}],"type":"strong"},{"text":" and logs a warning, so that no connection waits for ever","type":"text"},{"text":" ","type":"text"},{"text":"for an answer that nobody will send.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The token can be used from any thread, once: the first call of ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/send(_:dontKeepAlive:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/close()","isActive":true,"type":"reference"},{"text":" counts, later calls do nothing. The answer can also be sent before","type":"text"},{"text":" ","type":"text"},{"code":"handle(connection:)","type":"codeVoice"},{"text":" has returned.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed":{"abstract":[{"text":"Follow a request from the socket to your handler and back.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed","kind":"article","role":"collectionGroup","title":"How a Request Is Served","type":"topic","url":"/documentation/nanohttp/howarequestisserved"},"doc://NanoHTTP/documentation/NanoHTTP/Logging":{"abstract":[{"text":"See what the server reports, and send it where you want it.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Logging","kind":"article","role":"collectionGroup","title":"Logging","type":"topic","url":"/documentation/nanohttp/logging"},"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending":{"abstract":[{"text":"Look at every request before it is routed, and replace parts of the server by subclassing.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending","kind":"article","role":"collectionGroup","title":"Middleware and Extending the Server","type":"topic","url":"/documentation/nanohttp/middlewareandextending"},"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger":{"abstract":[{"text":"A logger that prints one line for every message, such as ","type":"text"},{"code":"[WARNING] Unable to accept a connection","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"for command-line tools and for tests. By default the lines are printed to the standard output, and every line is","type":"text"},{"text":" ","type":"text"},{"text":"flushed: when the output goes to a pipe or a file (","type":"text"},{"code":"tool | tee log","type":"codeVoice"},{"text":"), the standard output is buffered, and the","type":"text"},{"text":" ","type":"text"},{"text":"lines would otherwise show up late.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoConsoleLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoConsoleLogger"}],"role":"symbol","title":"NanoConsoleLogger","type":"topic","url":"/documentation/nanohttp/nanoconsolelogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection":{"abstract":[{"text":"A request that has been read from a connection, together with the handler that will answer it.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" drives the connection with it: ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" writes the","type":"text"},{"text":" ","type":"text"},{"text":"response and returns the connection for the next request, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the connection has ended.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPConnection"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPConnection"}],"role":"symbol","title":"NanoHTTPConnection","type":"topic","url":"/documentation/nanohttp/nanohttpconnection"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection/deferResponse()":{"abstract":[{"text":"Promises to answer the request later, from any thread, with the returned","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse","isActive":true,"type":"reference"},{"text":". Call it in ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(and nowhere else), before it returns; the connection is not answered when ","type":"text"},{"code":"handle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"returns. Calling it again for the same request returns the same token.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deferResponse"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A20HTTPDeferredResponseC","text":"NanoHTTPDeferredResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection/deferResponse()","kind":"symbol","role":"symbol","title":"deferResponse()","type":"topic","url":"/documentation/nanohttp/nanohttpconnection/deferresponse()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse":{"abstract":[{"text":"The answer to a request that is sent later, from any thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPDeferredResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPDeferredResponse"}],"role":"symbol","title":"NanoHTTPDeferredResponse","type":"topic","url":"/documentation/nanohttp/nanohttpdeferredresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/close()":{"abstract":[{"text":"Closes the connection without an answer. Does nothing if the request has been","type":"text"},{"text":" ","type":"text"},{"text":"answered or closed before; returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" then.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/close()","kind":"symbol","role":"symbol","title":"close()","type":"topic","url":"/documentation/nanohttp/nanohttpdeferredresponse/close()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/request":{"abstract":[{"text":"The request that waits for its answer.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/request","kind":"symbol","role":"symbol","title":"request","type":"topic","url":"/documentation/nanohttp/nanohttpdeferredresponse/request"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/send(_:dontKeepAlive:)":{"abstract":[{"text":"Hands the answer to the server, which writes it and then waits for the next request","type":"text"},{"text":" ","type":"text"},{"text":"of the connection. Returns at once, and can be called from any thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dontKeepAlive"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/send(_:dontKeepAlive:)","kind":"symbol","role":"symbol","title":"send(_:dontKeepAlive:)","type":"topic","url":"/documentation/nanohttp/nanohttpdeferredresponse/send(_:dontkeepalive:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/server":{"abstract":[{"text":"The server that the request came to, unless it has been released.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"server"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC","text":"NanoHTTPServerIO"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/server","kind":"symbol","role":"symbol","title":"server","type":"topic","url":"/documentation/nanohttp/nanohttpdeferredresponse/server"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger":{"abstract":[{"text":"Receives the messages that a server reports: a response that could not be written, a pause in","type":"text"},{"text":" ","type":"text"},{"text":"accepting connections, a handler that threw an error, a WebSocket client that broke the protocol.","type":"text"},{"text":" ","type":"text"},{"text":"Set the logger of a server with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPLogger"}],"role":"symbol","title":"NanoHTTPLogger","type":"topic","url":"/documentation/nanohttp/nanohttplogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO":{"abstract":[{"text":"The part of a server that deals with sockets and threads: it listens at a port, accepts","type":"text"},{"text":" ","type":"text"},{"text":"connections, reads the requests of each connection on a thread of its own, hands them to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)","isActive":true,"type":"reference"},{"text":" and writes the responses. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" builds routing on top of it;","type":"text"},{"text":" ","type":"text"},{"text":"subclass this class to use the server without routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServerIO"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServerIO"}],"role":"symbol","title":"NanoHTTPServerIO","type":"topic","url":"/documentation/nanohttp/nanohttpserverio"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger":{"abstract":[{"text":"Receives what the server reports: a response that could not be written, a pause in accepting","type":"text"},{"text":" ","type":"text"},{"text":"connections, a handler that threw an error, a WebSocket client that broke the protocol. The default","type":"text"},{"text":" ","type":"text"},{"text":"is a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger","isActive":true,"type":"reference"},{"text":", which writes to the unified logging system (the console of Xcode, the Console","type":"text"},{"text":" ","type":"text"},{"text":"app). A command-line tool that should print to its terminal uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","isActive":true,"type":"reference"},{"text":"; a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger","isActive":true,"type":"reference"},{"text":" switches logging off.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"logger"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPLoggerP","text":"NanoHTTPLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","kind":"symbol","role":"symbol","title":"logger","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/logger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections":{"abstract":[{"text":"The most connections the server serves at the same time (WebSocket sessions included). When","type":"text"},{"text":" ","type":"text"},{"text":"that many are open, a new connection is answered with ","type":"text"},{"code":"503 Service Unavailable","type":"codeVoice"},{"text":" and closed.","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" accepts any number; every connection uses a thread and a file descriptor. The default","type":"text"},{"text":" ","type":"text"},{"text":"is 128.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxConnections"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections","kind":"symbol","role":"symbol","title":"maxConnections","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/maxconnections"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)":{"abstract":[{"text":"Chooses the handler for a request and returns it with the variables that the request’s route","type":"text"},{"text":" ","type":"text"},{"text":"defined (see ","type":"text"},{"code":"NanoHTTPRequest.params","type":"codeVoice"},{"text":"). The implementation of this class answers every request","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":"; ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" overrides it to route.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dispatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)","kind":"symbol","role":"symbol","title":"dispatch(request:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/dispatch(request:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)":{"abstract":[{"text":"Serves a connection: calls the handler of its first request, sends the response and, as long as","type":"text"},{"text":" ","type":"text"},{"text":"the connection is kept alive, does the same for the following requests. Returns when the","type":"text"},{"text":" ","type":"text"},{"text":"connection has ended. Runs on the thread of the connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"connection"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPConnectionV","text":"NanoHTTPConnection"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","kind":"symbol","role":"symbol","title":"handle(connection:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/handle(connection:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoLogLevel":{"abstract":[{"text":"How important a message of the server is.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoLogLevel"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoLogLevel","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoLogLevel"}],"role":"symbol","title":"NanoLogLevel","type":"topic","url":"/documentation/nanohttp/nanologlevel"},"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger":{"abstract":[{"text":"A logger that writes to the unified logging system of Apple’s platforms (","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":"): the messages","type":"text"},{"text":" ","type":"text"},{"text":"appear in the console of Xcode and in the Console app, with the subsystem ","type":"text"},{"code":"org.objecthub.NanoHTTP","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It is the default logger of a server.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoOSLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoOSLogger"}],"role":"symbol","title":"NanoOSLogger","type":"topic","url":"/documentation/nanohttp/nanooslogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger":{"abstract":[{"text":"A logger that discards everything: use it to switch logging off.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSilentLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoSilentLogger"}],"role":"symbol","title":"NanoSilentLogger","type":"topic","url":"/documentation/nanohttp/nanosilentlogger"},"doc://NanoHTTP/documentation/NanoHTTP/ThreadingAndLifecycle":{"abstract":[{"text":"Start and stop servers, and know which code runs on which thread.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/ThreadingAndLifecycle","kind":"article","role":"collectionGroup","title":"Threading and Lifecycle","type":"topic","url":"/documentation/nanohttp/threadingandlifecycle"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Running-a-server","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","doc://NanoHTTP/documentation/NanoHTTP/ThreadingAndLifecycle","doc://NanoHTTP/documentation/NanoHTTP/Logging","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger","doc://NanoHTTP/documentation/NanoHTTP/NanoLogLevel","doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger","doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger","doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection","doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed"],"title":"Running a server"}],"topicSections":[{"anchor":"Instance-Properties","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/request","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/server"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/close()","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse/send(_:dontKeepAlive:)"],"title":"Instance Methods"}],"variants":[{"paths":["/documentation/nanohttp/nanohttpdeferredresponse"],"traits":[{"interfaceLanguage":"swift"}]}]}