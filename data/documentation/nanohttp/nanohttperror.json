,"type":"text"},{"text":" ","type":"text"},{"text":"may change the request before, change the response afterwards, catch an error that ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" throws, or","type":"text"},{"text":" ","type":"text"},{"text":"answer the request itself and never call ","type":"text"},{"code":"next","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPMiddleware"}],"role":"symbol","title":"NanoHTTPMiddleware","type":"topic","url":"/documentation/nanohttp/nanohttpmiddleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser":{"abstract":[{"text":"Reads HTTP requests from a socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParser"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParser"}],"role":"symbol","title":"NanoHTTPParser","type":"topic","url":"/documentation/nanohttp/nanohttpparser"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError":{"abstract":[{"text":"The reasons why ","type":"text"},{"code":"NanoHTTPParser","type":"codeVoice"},{"text":" refuses a request. A server answers requests that fail with","type":"text"},{"text":" ","type":"text"},{"text":"one of these errors with the matching HTTP status code and closes the connection; failures of","type":"text"},{"text":" ","type":"text"},{"text":"the connection itself (peer closed, reset) surface as ","type":"text"},{"code":"NanoSocketError","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParserError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParserError"}],"role":"symbol","title":"NanoHTTPParserError","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client and the","type":"text"},{"text":" ","type":"text"},{"text":"variables of the route that matched. The server creates one for every request and hands it to","type":"text"},{"text":" ","type":"text"},{"text":"middleware and handlers. A request is a reference type, compared and hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler":{"abstract":[{"text":"A function that answers a request. It runs on the thread of the connection that sent the request,","type":"text"},{"text":" ","type":"text"},{"text":"one request at a time per connection, and many handlers run at the same time for different","type":"text"},{"text":" ","type":"text"},{"text":"connections (unless the server has only one thread). A handler may block (a slow handler delays only","type":"text"},{"text":" ","type":"text"},{"text":"its own connection) but must protect state that it shares with other handlers.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"symbol","navigatorTitle":[{"kind":"identifier"