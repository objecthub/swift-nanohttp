text":"custom"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A22HTTPResponseBodyWriterP","text":"NanoHTTPResponseBodyWriter"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contentType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","kind":"symbol","role":"symbol","title":"NanoHTTPResponse.Body.custom(_:contentType:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/body-swift.enum/custom(_:contenttype:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter":{"abstract":[{"text":"Receives the body of a response while a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","isActive":true,"type":"reference"},{"text":" function","type":"text"},{"text":" ","type":"text"},{"text":"produces it. The writer is the connection: whatever is written is sent to the client at once, so the","type":"text"},{"text":" ","type":"text"},{"text":"function can stream content of any size.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"role":"symbol","title":"NanoHTTPResponseBodyWriter","type":"topic","url":"/documentation/nanohttp/nanohttpresponsebodywriter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/errorHandler":{"abstract":[{"text":"Decides how the errors of handlers and middleware are answered. It 