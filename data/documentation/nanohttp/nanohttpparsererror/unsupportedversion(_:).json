nd closes the","type":"text"},{"text":" ","type":"text"},{"text":"connection; failures of the connection itself (peer closed, reset) surface as","type":"text"},{"text":" ","type":"text"},{"code":"NanoSocketError","type":"codeVoice"},{"text":". The error conforms to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":": its ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" ","type":"text"},{"text":"says in English what is wrong with the request. Text that the client sent is quoted","type":"text"},{"text":" ","type":"text"},{"text":"and escaped in it, so a control character cannot get into a log through it.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParserError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParserError"}],"role":"symbol","title":"NanoHTTPParserError","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError/unsupportedVersion(_:)":{"abstract":[{"text":"The protocol version is not one that this server speaks, HTTP/1.0 and HTTP/1.1","type":"text"},{"text":" ","type":"text"},{"text":"(HTTP status 505).","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unsupportedVersion"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError/unsupportedVersion(_:)","kind":"symbol","role":"symbol","title":"NanoHTTPParserError.unsupportedVersion(_:)","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror/unsupportedversion(_:)"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["/documentation/nanohttp/nanohttpparsererror/unsup