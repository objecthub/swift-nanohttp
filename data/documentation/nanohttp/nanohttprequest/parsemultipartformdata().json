t":"Discussion","type":"heading"},{"inlineContent":[{"text":"The body is read as RFC 2046 and RFC 7578 describe it, and is binary safe: a part","type":"text"},{"text":" ","type":"text"},{"text":"ends at the line break that precedes the next boundary line, and every byte before","type":"text"},{"text":" ","type":"text"},{"text":"that belongs to the part, line breaks and ","type":"text"},{"code":"--","type":"codeVoice"},{"text":" included. Text before the first","type":"text"},{"text":" ","type":"text"},{"text":"boundary and after the closing boundary is ignored. A boundary can be quoted","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"boundary=\"a b\"","type":"codeVoice"},{"text":"), and the names and file names of the parts can contain quotes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"\\\"","type":"codeVoice"},{"text":"), ","type":"text"},{"code":";","type":"codeVoice"},{"text":", ","type":"text"},{"code":"=","type":"codeVoice"},{"text":" and ","type":"text"},{"code":":","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A body is refused as a whole (the result is empty) if it has no closing boundary, if","type":"text"},{"text":" ","type":"text"},{"text":"the headers of a part are not followed by an empty line, or if it exceeds","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxMultipartParts","isActive":true,"type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxMultipartHeaderBytes","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/Examples":{"abstract":[{"text":"Six small programs that show how the pieces fit together, and that you can run.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Examples","kind":"article","role":"article","title":"Examples","type":"topic","url":"/documentation/nanohttp/examples"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxBodyBytes":{"abstract":[{"text":"The largest accepted request body in bytes (the value of ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":"). The","type":"text"},{"text":" ","type":"text"},{"text":"body is held in memory, so keep this as small as the application allows.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxBodyBytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxBodyBytes","kind":"symbol","role":"symbol","title":"maxBodyBytes","type":"topic","url":"/documentation/nanohttp/nanohttpparser/limits-swift.struct/maxbodybytes"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxMultipartHeaderBytes":{"abstract":[{"text":"The most bytes that ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/parseMultiPartFormData()","isActive":true,"type":"reference"},{"text":" accepts for","type":"text"},{"text":" ","type":"text"},{"text":"the headers of one part of a ","type":"text"},{"code":"multipart/form-data","type":"codeVoice"},{"text":" body, including line breaks.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxMultipartHeaderBytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxMultipartHeaderBytes","kind":"symbol","role":"symbol","title":"maxMultipartHeaderBytes","type":"topic","url":"/documentation/nanohttp/nanohttpparser/limits-swift.struct/maxmultipartheaderbytes"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxMultipartParts":{"abstract":[{"text":"The most parts that ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/parseMultiPartFormData()","isActive":true,"type":"reference"},{"text":" accepts in a","type":"text"},{"text":" ","type":"text"},{"code":"multipart/form-data","type":"codeVoice"},{"text":" body. A body with more parts is refused as a whole. The","type":"text"},{"text":" ","type":"text"},{"text":"parts cost memory (every one has headers of its own), and a body of the permitted","type":"text"},{"text":" ","type":"text"},{"text":"size can hold millions of empty ones.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxMultipartParts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxMultipartParts","kind":"symbol","role":"symbol","title":"maxMultipartParts","type":"topic","url":"/documentation/nanohttp/nanohttpparser/limits-swift.struct/maxmultipartparts"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client","type":"text"},{"text":" ","type":"text"},{"text":"and the variables of the route that matched. The server creates one for every request","type":"text"},{"text":" ","type":"text"},{"text":"and hands it to middleware and handlers. A request is a reference type, compared and","type":"text"},{"text":" ","type":"text"},{"text":"hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/MultiPart":{"abstract":[{"text":"One part of a ","type":"text"},{"code":"multipart/form-data","type":"codeVoice"},{"text":" body (an uploaded file or a form field): its","type":"text"},{"text":" ","type":"text"},{"text":"headers and its content. See ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/parseMultiPartFormData()","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultiPart"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/MultiPart","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultiPart"}],"role":"symbol","title":"NanoHTTPRequest.MultiPart","type":"topic","url":"/documentation/nanohttp/nanohttprequest/multipart"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/parseMultiPartFormData()":{"abstract":[{"text":"The parts of a ","type":"text"},{"code":"multipart/form-data","type":"codeVoice"},{"text":" body (a form with file uploads), in order.","type":"text"},{"text":" ","type":"text"},{"text":"Returns an empty array if the request has another content type or the body is","type":"text"},{"text":" ","type":"text"},{"text":"malformed. The whole body is in memory, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct/maxBodyBytes","isActive":true,"type":"reference"},{"text":".","t