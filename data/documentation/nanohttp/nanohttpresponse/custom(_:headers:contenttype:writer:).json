ets the body up to the end of the connection. If the handler sets a","type":"text"},{"text":" ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" header, the body is sent with that length instead: the function has","type":"text"},{"text":" ","type":"text"},{"text":"to write exactly that many bytes, or the connection is closed after the response.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A22HTTPResponseBodyWriterP","text":"NanoHTTPResponseBodyWriter"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contentType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","kind":"symbol","role":"symbol","title":"NanoHTTPResponse.Body.custom(_:contentType:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/body-swift.enum/custom(_:contenttype:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/custom(_:headers:contentType:writer:)":{"abstract":[{"text":"A response whose body is written by ","type":"text"},{"code":"writer","type":"codeVoice"},{"text":", see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The writer receives an object it writes bytes, data or files to:","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","t