":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a","type":"text"},{"text":" ","type":"text"},{"text":"(potentially empty) sequence of path segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["/documentation/nanohttp/nanohttprouter/route(_:path:)"],"traits":[{"interfaceLanguage":"swift"}]}]}