path/edit","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"routeWithRawParams"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> (params"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], rawParams"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], handler"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"},{"kind":"text","text":")?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/routeWithRawParams(_:path:)","kind":"symbol","role":"symbol","title":"routeWithRawParams(_:path:)","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter/routewithrawparams(_:path:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["/documentation/nanohttp