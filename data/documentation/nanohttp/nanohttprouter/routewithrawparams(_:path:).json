 that can be used: ","type":"text"},{"inlineContent":[{"text":"variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" being an anonymous variable) and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"path variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" being an anonymous path variable). A variable matches one","type":"text"},{"text":" ","type":"text"},{"text":"full path segment and its value is being url-decoded: ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/users/7","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"but not ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a (potentially empty) sequence of path","type":"text"},{"text":" ","type":"text"},{"text":"segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":": ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":". The values are also available as the client sent","type":"text"},{"text":" ","type":"text"},{"text":"them, still percent-encoded (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/routeWithRawParams(_:path:)","isActive":true,"type":"reference"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url