"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":". The values are also available as the client sent","type":"text"},{"text":" ","type":"text"},{"text":"them, still percent-encoded (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/routeWithRawParams(_:path:)","isActive":true,"type":"reference"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/register(_:path:handler:)":{"abstract":[{"text":"Registers a handler for ","type":"text"},{"code":"path","type":"codeVoice"},{"text":". ","type":"text"},{"code":"method","type":"codeVoice"},{"text":" is the HTTP method in upper case, or","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for all methods. ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" is a sequence of segments separated by ","type":"text"},{"code":"/","type":"codeVoice"},{"text":"; empty","type":"text"},{"text":" ","type":"text"},{"text":"segments are ignored, and everything after a ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" is ignored. A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" handler","type":"text"},{"text":" ","type":"text"},{"text":"removes the registration.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"register"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s: