{"abstract":[{"text":"Finds the handler for a request. Fixed segments win over variables, and the search","type":"text"},{"text":" ","type":"text"},{"text":"backtracks: ","type":"text"},{"code":"/a/b/c","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/a/:x/d","type":"codeVoice"},{"text":" both match ","type":"text"},{"code":"/a/b/d","type":"codeVoice"},{"text":". A route for ","type":"text"},{"code":"method","type":"codeVoice"},{"text":" is tried","type":"text"},{"text":" ","type":"text"},{"text":"before a route for all methods. A ","type":"text"},{"code":"HEAD","type":"codeVoice"},{"text":" request that has no route of its own is","type":"text"},{"text":" ","type":"text"},{"text":"answered by the route for ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":", before the route for all methods is tried.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/route(_:path:)"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A17HTTPSegmentRouterC5route_4pathSDyS2SG_AA0A12HTTPResponseVAA0A11HTTPRequestCKctSgSS_SStF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"route"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"},{"kind":"text","text":")?"}],"modul