{"code":"NanoHTTPRouter","type":"codeVoice"},{"text":" protocol. Routing is based","type":"text"},{"text":" ","type":"text"},{"text":"on path segments that are matched in sequence. There are two differnt types of placeholders","type":"text"},{"text":" ","type":"text"},{"text":"that can be used: ","type":"text"},{"inlineContent":[{"text":"variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" being an anonymous variable) and ","type":"text"},{"inlineContent":[{"text":"path variables","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"(with ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" being an anonymous path variable). A variable matches one full path segment","type":"text"},{"text":" ","type":"text"},{"text":"and its value is being url-decoded: ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/users/7","type":"codeVoice"},{"text":", but not ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a","type":"text"},{"text":" ","type":"text"},{"text":"(potentially empty) sequence of path segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documen