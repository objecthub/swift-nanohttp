{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A10HTTPServerC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NanoHTTPServer"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Create a server, register handlers for methods and paths, and start it:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.get[\"/hello\"] = { _ in .ok(.text(\"Hello, world!\")) }","server.get[\"/users/:id\"] = { request in .ok(.text(\"User \\(request.params[\"id\"] ?? \"?\")\")) }","server.post[\"/echo\"] = { request in .ok(.data(Data(request.body), contentType: \"application/octet-stream\")) }","try server.start(8080)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A handler is a function from ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","isActive":true,"type":"reference"},{"text":" to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse","isActive":true,"type":"reference"},{"text":". Every connection is served","type":"text"},{"text":" ","type":"text"},{"text":"by its own thread, so handlers of different connections run at the same time; a handler that","type":"text"},{"text":" ","type":"text"},{"text":"shares state with others has to protect it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The server is a subclass of ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","isActive":true,"type":"reference"},{"text":", which provides the listening socket, the","type":"text"},{"text":" ","type":"text"},{"text":"connections and the lifecycle (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/stop()","isActive":true,"type":"reference"},{"text":"); this class adds routing, middleware and a handler for unknown paths.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed":{"abstract":[{"text":"Follow a request from the socket to your handler and back.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed","kind":"article","role":"collectionGroup","title":"How a Request Is Served","type":"topic","url":"/documentation/nanohttp/howarequestisserved"},"doc://NanoHTTP/documentation/NanoHTTP/Logging":{"abstract":[{"text":"See what the server reports, and send it where you want it.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Logging","kind":"article","role":"collectionGroup","title":"Logging","type":"topic","url":"/documentation/nanohttp/logging"},"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending":{"abstract":[{"text":"Look at every request before it is routed, and replace parts of the server by subclassing.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending","kind":"article","role":"collectionGroup","title":"Middleware and Extending the Server","type":"topic","url":"/documentation/nanohttp/middlewareandextending"},"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger":{"abstract":[{"text":"A logger that prints one line for every message, such as ","type":"text"},{"code":"[WARNING] Unable to accept a connection","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"for command-line tools and for tests. By default the lines are printed to the standard output, and every line is","type":"text"},{"text":" ","type":"text"},{"text":"flushed: when the output goes to a pipe or a file (","type":"text"},{"code":"tool | tee log","type":"codeVoice"},{"text":"), the standard output is buffered, and the","type":"text"},{"text":" ","type":"text"},{"text":"lines would otherwise show up late.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoConsoleLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoConsoleLogger"}],"role":"symbol","title":"NanoConsoleLogger","type":"topic","url":"/documentation/nanohttp/nanoconsolelogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection":{"abstract":[{"text":"A request that has been read from a connection, together with the handler that will answer it.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" drives the connection with it: ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" writes the","type":"text"},{"text":" ","type":"text"},{"text":"response and returns the connection for the next request, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the connection has ended.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPConnection"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPConnection"}],"role":"symbol","title":"NanoHTTPConnection","type":"topic","url":"/documentation/nanohttp/nanohttpconnection"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse":{"abstract":[{"text":"The answer to a request that is sent later, from any thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPDeferredResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPDeferredResponse"}],"role":"symbol","title":"NanoHTTPDeferredResponse","type":"topic","url":"/documentation/nanohttp/nanohttpdeferredresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError":{"abstract":[{"text":"An error that a handler throws to answer a request with an error status code.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPError"}],"role":"symbol","title":"NanoHTTPError","type":"topic","url":"/documentation/nanohttp/nanohttperror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger":{"abstract":[{"text":"Receives the messages that a server reports: a response that could not be written, a pause in","type":"text"},{"text":" ","type":"text"},{"text":"accepting connections, a handler that threw an error, a WebSocket client that broke the protocol.","type":"text"},{"text":" ","type":"text"},{"text":"Set the logger of a server with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPLogger"}],"role":"symbol","title":"NanoHTTPLogger","type":"topic","url":"/documentation/nanohttp/nanohttplogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client and the","type":"text"},{"text":" ","type":"text"},{"text":"variables of the route that matched. The server creates one for every request and hands it to","type":"text"},{"text":" ","type":"text"},{"text":"middleware and handlers. A request is a reference type, compared and hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse":{"abstract":[{"text":"The answer to a request: a status code, headers and a body. Use the static functions to create","type":"text"},{"text":" ","type":"text"},{"text":"the common responses:","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponse"}],"role":"symbol","title":"NanoHTTPResponse","type":"topic","url":"/documentation/nanohttp/nanohttpresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter":{"abstract":[{"text":"Maps methods and paths to handlers. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","isActive":true,"type":"reference"},{"text":" unless","type":"text"},{"text":" ","type":"text"},{"code":"initialRouter()","type":"codeVoice"},{"text":" is overridden. A router has to be safe to use from several threads: routes are","type":"text"},{"text":" ","type":"text"},{"text":"looked up on the threads of the connections, and may be registered while the server is running.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRouter"}],"role":"symbol","title":"NanoHTTPRouter","type":"topic","url":"/documentation/nanohttp/nanohttprouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter":{"abstract":[{"text":"Class ","type":"text"},{"code":"NanoHTTPSegmentRouter","type":"codeVoice"},{"text":" implements the ","type":"text"},{"code":"NanoHTTPRouter","type":"codeVoice"},{"text":" protocol. Routing is based","type":"text"},{"text":" ","type":"text"},{"text":"on path segments that are matched in sequence. There are two differnt types of placeholders","type":"text"},{"text":" ","type":"text"},{"text":"that can be used: ","type":"text"},{"inlineContent":[{"text":"variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" being an anonymous variable) and ","type":"text"},{"inlineContent":[{"text":"path variables","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"(with ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" being an anonymous path variable). A variable matches one full path segment","type":"text"},{"text":" ","type":"text"},{"text":"and its value is being url-decoded: ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/users/7","type":"codeVoice"},{"text":", but not ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a","type":"text"},{"text":" ","type":"text"},{"text":"(potentially empty) sequence of path segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute":{"abstract":[{"text":"Registers handlers for one HTTP method: ","type":"text"},{"code":"server.get[\"/a\", \"/b\"] = handler","type":"codeVoice"},{"text":" registers ","type":"text"},{"code":"handler","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"GET requests to both paths, ","type":"text"},{"code":"server.get[\"/a\"] = nil","type":"codeVoice"},{"text":" removes the handler of ","type":"text"},{"code":"/a","type":"codeVoice"},{"text":" again.","type":"text"},{"text":" ","type":"text"},{"text":"Reading the subscript always gives ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MethodRoute"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MethodRoute"}],"role":"symbol","title":"NanoHTTPServer.MethodRoute","type":"topic","url":"/documentation/nanohttp/nanohttpserver/methodroute"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/delete":{"abstract":[{"text":"Registers handlers for DELETE requests: ","type":"text"},{"code":"server.delete[\"/items/:id\"] = ...","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPServerC11MethodRouteV","text":"MethodRoute"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/delete","kind":"symbol","role":"symbol","title":"delete","type":"topic","url":"/documentation/nanohttp/nanohttpserver/delete"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/dispatch(request:)":{"abstract":[{"text":"Finds the handler for a request. Without middleware: the route that matches the method and path, else","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/notFoundHandler","isActive":true,"type":"reference"},{"text":", else a ","type":"text"},{"code":"404","type":"codeVoice"},{"text":". With middleware, the handler is the chain of the middleware around","type":"text"},{"text":" ","type":"text"},{"text":"that: the router is asked when the last middleware calls ","type":"text"},{"code":"next","type":"codeVoice"},{"text":". Returns the variables of the route","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"request.params","type":"codeVoice"},{"text":"; they are set by the chain when there is middleware) and the handler.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dispatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/dispatch(request:)","kind":"symbol","role":"symbol","title":"dispatch(request:)","type":"topic","url":"/documentation/nanohttp/nanohttpserver/dispatch(request:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/errorHandler":{"abstract":[{"text":"Decides how the errors of handlers and middleware are answered. It receives the error and the request and","type":"text"},{"text":" ","type":"text"},{"text":"returns the response, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to leave the error to the default: the response of a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","isActive":true,"type":"reference"},{"text":", or ","type":"text"},{"code":"500 Internal Server Error","type":"codeVoice"},{"text":" for other errors (see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/response(for:to:)","isActive":true,"type":"reference"},{"text":"). Errors that middleware catches do not get here.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"errorHandler"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"},{"kind":"text","text":"?)?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/errorHandler","kind":"symbol","role":"symbol","title":"errorHandler","type":"topic","url":"/documentation/nanohttp/nanohttpserver/errorhandler"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/get":{"abstract":[{"text":"Registers handlers for GET requests: ","type":"text"},{"code":"server.get[\"/items\"] = ...","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"get"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPServerC11MethodRouteV","text":"MethodRoute"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/get","kind":"symbol","role":"symbol","title":"get","type":"topic","url":"/documentation/nanohttp/nanohttpserver/get"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/head":{"abstract":[{"text":"Registers handlers for HEAD requests: ","type":"text"},{"code":"server.head[\"/items\"] = ...","type":"codeVoice"},{"text":". A HEAD request is answered by a","type":"text"},{"text":" ","type":"text"},{"text":"handler registered for HEAD, or else by the handler for GET (with the body of its response left out,","type":"text"},{"text":" ","type":"text"},{"text":"as HEAD wants), or else by a handler for all methods. Registering a handler for HEAD is only needed to","type":"text"},{"text":" ","type":"text"},{"text":"answer it differently from GET.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"head"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPServerC11MethodRouteV","text":"MethodRoute"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/head","kind":"symbol","role":"symbol","title":"head","type":"topic","url":"/documentation/nanohttp/nanohttpserver/head"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/init(configuration:)":{"abstract":[{"text":"Creates a server that is not running yet; see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV","text":"Configuration"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/init(configuration:)","kind":"symbol","role":"symbol","title":"init(configuration:)","type":"topic","url":"/documentation/nanohttp/nanohttpserver/init(configuration:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/initialRouter()":{"abstract":[{"text":"Creates the router of a new server: a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","isActive":true,"type":"reference"},{"text":". Override in a subclass to use a","type":"text"},{"text":" ","type":"text"},{"text":"different ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialRouter"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPRouterP","text":"NanoHTTPRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/initialRouter()","kind":"symbol","role":"symbol","title":"initialRouter()","type":"topic","url":"/documentation/nanohttp/nanohttpserver/initialrouter()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware":{"abstract":[{"text":"Functions that wrap the handling of every request, in the order of the array: the first one is the","type":"text"},{"text":" ","type":"text"},{"text":"outermost. A middleware receives the request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", the rest of the chain: the middleware after it,","type":"text"},{"text":" ","type":"text"},{"text":"and finally the router and the handler. It lets the request through by calling ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", and can","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"middleware"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPMiddlewarea","text":"NanoHTTPMiddleware"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","kind":"symbol","role":"symbol","title":"middleware","type":"topic","url":"/documentation/nanohttp/nanohttpserver/middleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/notFoundHandler":{"abstract":[{"text":"The handler for reque