{"abstract":[{"text":"Registers handlers for HEAD requests: ","type":"text"},{"code":"server.head[\"/items\"] = ...","type":"codeVoice"},{"text":". A HEAD request","type":"text"},{"text":" ","type":"text"},{"text":"is answered by a handler registered for HEAD, or else by the handler for GET (with","type":"text"},{"text":" ","type":"text"},{"text":"the body of its response left out, as HEAD wants), or else by a handler for all","type":"text"},{"text":" ","type":"text"},{"text":"methods. Registering a handler for HEAD is only needed to answer it differently from","type":"text"},{"text":" ","type":"text"},{"text":"GET.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/head"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A10HTTPServerC4headAC11MethodRouteVvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"head"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPServerC11MethodRouteV","text":"MethodRoute"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Property","symbolKind":"property","title":"head"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"head"},{"kind":"text","text":": "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPServerC11MethodRouteV","text":"MethodRoute"}]}],"kind":"declarations"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://Nan