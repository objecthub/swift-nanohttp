{"abstract":[{"text":"The router that receives the registrations.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute/router"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A10HTTPServerC11MethodRouteV6routerAA0A10HTTPRouter_pvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"router"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPRouterP","text":"NanoHTTPRouter"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Property","symbolKind":"property","title":"router"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"router"},{"kind":"text","text":": "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPRouterP","text":"NanoHTTPRouter"}]}],"kind":"declarations"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter":{"abstract":[{"text":"Maps methods and paths to handlers. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"unless ","type":"text"},{"code":"initialRouter()","type":"codeVoice"},{"text":" is overridden. A router has to be safe to use from several","type":"text"},{"text":" ","type":"text"},{"text":"threads: routes are looked up on the threads of the connections, and may be registered","type":"text"},{"text":" ","type":"text"},{"text":"while the server is running.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRouter"}],"role":"symbol","title":"NanoHTTPRouter","type":"topic","url":"/documentation/nanohttp/nanohttprouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter":{"abstract":[{"text":"Class ","type":"text"},{"code":"NanoHTTPSegmentRouter","type":"codeVoice"},{"text":" implements the ","type":"text"},{"code":"NanoHTTPRouter","type":"codeVoice"},{"text":" protocol. Routing is","type":"text"},{"text":" ","type":"text"},{"text":"based on path segments that are matched in sequence. There are two differnt types of","type":"text"},{"text":" ","type":"text"},{"text":"placeholders that can be used: ","type":"text"},{"inlineContent":[{"text":"variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" being an anonymous variable) and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"path variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" being an anonymous path variable). A variable matches one","type":"text"},{"text":" ","type":"text"},{"text":"full path segment and its value is being url-decoded: ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/users/7","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"but not ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a (potentially empty) sequence of path","type":"text"},{"text":" ","type":"text"},{"text":"segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":": ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute":{"abstract":[{"text":"Registers handlers for one HTTP method: ","type":"text"},{"code":"server.get[\"/a\", \"/b\"] = handler","type":"codeVoice"},{"text":" registers","type":"text"},{"text":" ","type":"text"},{"code":"handler","type":"codeVoice"},{"text":" for GET requests to both paths, ","type":"text"},{"code":"server.get[\"/a\"] = nil","type":"codeVoice"},{"text":" removes the","type":"text"},{"text":" ","type":"text"},{"text":"handler of ","type":"text"},{"code":"/a","type":"codeVoice"},{"text":" again. Reading the subscript always gives ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MethodRoute"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MethodRoute"}],"role":"symbol","title":"NanoHTTPServer.MethodRoute","type":"topic","url":"/documentation/nanohttp/nanohttpserver/methodroute"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute/router":{"abstract":[{"text":"The router that receives the registrations.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"router"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPRouterP","text":"NanoHTTPRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute/router","kind":"symbol","role":"symbol","title":"router","type":"topic","url":"/documentation/nanohttp/nanohttpserver/methodroute/router"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["/documentation/nanohttp/nanohttpserver/methodroute/router"],"traits":[{"interfaceLanguage":"swift"}]}]}