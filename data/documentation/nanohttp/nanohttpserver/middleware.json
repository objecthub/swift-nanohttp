{"abstract":[{"text":"Functions that wrap the handling of every request, in the order of the array: the first one is the","type":"text"},{"text":" ","type":"text"},{"text":"outermost. A middleware receives the request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", the rest of the chain: the middleware after it,","type":"text"},{"text":" ","type":"text"},{"text":"and finally the router and the handler. It lets the request through by calling ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", and can","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A10HTTPServerC10middlewareSayAA0A12HTTPResponseVAA0A11HTTPRequestC_AfHKXEtKcGvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"middleware"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPMiddlewarea","text":"NanoHTTPMiddleware"},{"kind":"text","text":"]"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Property","symbolKind":"property","title":"middleware"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"middleware"},{"kind":"text","text":": ["},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPMiddlewarea","text":"NanoHTTPMiddleware"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"answer the request itself and not call ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" (a check that fails),","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"change the request before it calls ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" (add ","type":"text"},{"code":"request.custom[\"user\"]","type":"codeVoice"},{"text":", rewrite the path: the request","type":"text"},{"text":" ","type":"text"},{"text":"is routed after the middleware has run),","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"change the response that ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" returns (add a header, measure how long it took), and","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"catch an error that ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" throws, or throw one itself.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["let server = NanoHTTPServer()","server.middleware.append { request, next in","  guard request.header(\"x-api-key\") == \"secret\" else {","    throw NanoHTTPError.unauthorized(\"API key required\")","  }","  var response = try next(request)","  response.headers[\"X-Served-By\"] = \"nano\"","  return response","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Middleware sees every request, including those that no route matches. It runs before the request is","type":"text"},{"text":" ","type":"text"},{"text":"routed, so the variables of the route (","type":"text"},{"code":"request.params","type":"codeVoice"},{"text":") are known only after ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" has returned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Middleware runs on the threads of the connections. Configure it before starting the server.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, fil