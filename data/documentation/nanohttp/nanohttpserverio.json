{"abstract":[{"text":"The part of a server that deals with sockets and threads: it listens at a port,","type":"text"},{"text":" ","type":"text"},{"text":"accepts connections, reads the requests of each connection on a thread of its own,","type":"text"},{"text":" ","type":"text"},{"text":"hands them to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)","isActive":true,"type":"reference"},{"text":" and writes the responses. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"builds routing on top of it; subclass this class to use the server without routing.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServerIO"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServerIO"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NanoHTTPServerIO"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServerIO"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The lifecycle is ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/stop()","isActive":true,"type":"reference"},{"text":". Both can be called from any thread, and","type":"text"},{"text":" ","type":"text"},{"text":"a server can be started again after it was stopped. How the server listens and how","type":"text"},{"text":" ","type":"text"},{"text":"much it accepts is set with its ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/configuration-swift.property","isActive":true,"type":"reference"},{"text":"; by default it listens at the","type":"text"},{"text":" ","type":"text"},{"text":"loopback address only.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A connection serves one request at a time, on a thread of its own. Requests of different","type":"text"},{"text":" ","type":"text"},{"text":"connections are served concurrently, so code that handles requests must be thread-safe.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Requests are limited in size (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits","isActive":true,"type":"reference"},{"text":"), and requests that exceed","type":"text"},{"text":" ","type":"text"},{"text":"a limit or cannot be parsed are answered by the server itself with ","type":"text"},{"code":"400","type":"codeVoice"},{"text":", ","type":"text"},{"code":"413","type":"codeVoice"},{"text":", ","type":"text"},{"code":"414","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"431","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed":{"abstract":[{"text":"Follow a request from the socket to your handler and back.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HowARequestIsServed","kind":"article","role":"collectionGroup","title":"How a Request Is Served","type":"topic","url":"/documentation/nanohttp/howarequestisserved"},"doc://NanoHTTP/documentation/NanoHTTP/Logging":{"abstract":[{"text":"See what the server reports, and send it where you want it.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Logging","kind":"article","role":"collectionGroup","title":"Logging","type":"topic","url":"/documentation/nanohttp/logging"},"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending":{"abstract":[{"text":"Look at every request before it is routed, and replace parts of the server by subclassing.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending","kind":"article","role":"collectionGroup","title":"Middleware and Extending the Server","type":"topic","url":"/documentation/nanohttp/middlewareandextending"},"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger":{"abstract":[{"text":"A logger that prints one line for every message, such as","type":"text"},{"text":" ","type":"text"},{"code":"[WARNING] Unable to accept a connection","type":"codeVoice"},{"text":", for command-line tools and for tests. By","type":"text"},{"text":" ","type":"text"},{"text":"default the lines are printed to the standard output, and every line is flushed: when","type":"text"},{"text":" ","type":"text"},{"text":"the output goes to a pipe or a file (","type":"text"},{"code":"tool | tee log","type":"codeVoice"},{"text":"), the standard output is","type":"text"},{"text":" ","type":"text"},{"text":"buffered, and the lines would otherwise show up late.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoConsoleLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":