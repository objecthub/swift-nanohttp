text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPParserV","text":"NanoHTTPParser"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPParserV6LimitsV","text":"Limits"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits","kind":"symbol","role":"symbol","title":"limits","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/limits"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger":{"abstract":[{"text":"Receives what the server reports: a response that could not be written, a pause in","type":"text"},{"text":" ","type":"text"},{"text":"accepting connections, a handler that threw an error, a WebSocket client that","type":"text"},{"text":" ","type":"text"},{"text":"broke the protocol. The default is a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger","isActive":true,"type":"reference"},{"text":", which writes to the unified","type":"text"},{"text":" ","type":"text"},{"text":"logging system (the console of Xcode, the Console app). A command-line tool that","type":"text"},{"text":" ","type":"text"},{"text":"should print to its terminal uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","isActive":true,"type":"reference"},{"text":"; a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"switches logging off.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"logger"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPLoggerP","text":"NanoHTTPLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","kind":"symbol","role":"symbo