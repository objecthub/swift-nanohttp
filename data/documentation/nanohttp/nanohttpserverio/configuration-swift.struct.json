{"abstract":[{"text":"How a server listens and what it accepts. Change it before ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"running server keeps the configuration it was started with.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Configuration"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"NanoHTTPServerIO.Configuration"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Configuration"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"code":["let server = NanoHTTPServer()","server.configuration.listenAddress = .allInterfaces   // reachable from the network","server.configuration.limits.maxBodyBytes = 1024 * 1024","try server.start(8080)"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger":{"abstract":[{"text":"A logger that prints one line for every message, such as ","type":"text"},{"code":"[WARNING] Unable to accept a connection","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"for command-line tools and for tests. By default the lines are printed to the standard output, and every line is","type":"text"},{"text":" ","type":"text"},{"text":"flushed: when the output goes to a pipe or a file (","type":"text"},{"code":"tool | tee log","type":"codeVoice"},{"text":"), the standard output is buffered, and the","type":"text"},{"text":" ","type":"text"},{"text":"lines would otherwise show up late.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoConsoleLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoConsoleLogger"}],"role":"symbol","title":"NanoConsoleLogger","type":"topic","url":"/documentation/nanohttp/nanoconsolelogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct":{"abstract":[{"text":"Upper bounds for the size of a request.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Limits"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser/Limits-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Limits"}],"role":"symbol","title":"NanoHTTPParser.Limits","type":"topic","url":"/documentation/nanohttp/nanohttpparser/limits-swift.struct"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError":{"abstract":[{"text":"The reasons why ","type":"text"},{"code":"NanoHTTPParser","type":"codeVoice"},{"text":" refuses a request. A server answers requests that fail with","type":"text"},{"text":" ","type":"text"},{"text":"one of these errors with the matching HTTP status code and closes the connection; failures of","type":"text"},{"text":" ","type":"text"},{"text":"the connection itself (peer closed, reset) surface as ","type":"text"},{"code":"NanoSocketError","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParserError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParserError"}],"role":"symbol","title":"NanoHTTPParserError","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO":{"abstract":[{"text":"The part of a server that deals with sockets and threads: it listens at a port, accepts","type":"text"},{"text":" ","type":"text"},{"text":"connections, reads the requests of each connection on a thread of its own, hands them to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)","isActive":true,"type":"reference"},{"text":" and writes the responses. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" builds routing on top of it;","type":"text"},{"text":" ","type":"text"},{"text":"subclass this class to use the server without routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServerIO"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServerIO"}],"role":"symbol","title":"NanoHTTPServerIO","type":"topic","url":"/documentation/nanohttp/nanohttpserverio"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct":{"abstract":[{"text":"How a server listens and what it accepts. Change it before ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"running server keeps the configuration it was started with.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Configuration"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"role":"symbol","title":"NanoHTTPServerIO.Configuration","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum":{"abstract":[{"text":"The ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":" headers that a server answers, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/hostPolicy-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HostPolicy"}],"role":"symbol","title":"NanoHTTPServerIO.Configuration.HostPolicy","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/hostpolicy-swift.enum"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/any":{"abstract":[{"text":"Every ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":", and requests without one. This is the default.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"any"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/any","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.HostPolicy.any","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/hostpolicy-swift.enum/any"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/automatic":{"abstract":[{"text":"A server that listens at the loopback address only answers ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"[::1]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(at any port, so that a tunnel to another port works); a server that listens at other addresses","type":"text"},{"text":" ","type":"text"},{"text":"answers every ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":", because the names under which it is reached are not known.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"automatic"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/automatic","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.HostPolicy.automatic","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/hostpolicy-swift.enum/automatic"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum":{"abstract":[{"text":"The ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" headers that a server answers, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/originPolicy-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OriginPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OriginPolicy"}],"role":"symbol","title":"NanoHTTPServerIO.Configuration.OriginPolicy","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.enum"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/any":{"abstract":[{"text":"Every ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":". This is the default.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"any"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/any","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.OriginPolicy.any","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.enum/any"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/sameOrigin":{"abstract":[{"text":"Only pages of the server itself: the ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" of a request has to be the address that the request was","type":"text"},{"text":" ","type":"text"},{"text":"sent to (its ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":"). A request from the page of another site, and one from a page that has no origin","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Origin: null","type":"codeVoice"},{"text":": a local file, a sandboxed frame) is refused.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sameOrigin"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/sameOrigin","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.OriginPolicy.sameOrigin","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.enum/sameorigin"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum":{"abstract":[{"text":"The threads that run a server.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Threading"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Threading"}],"role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/perConnection":{"abstract":[{"text":"A thread accepts connections, and every connection has a thread of its own. Requests of","type":"text"},{"text":" ","type":"text"},{"text":"different connections are served at the same time, so handlers that share state need locks.","type":"text"},{"text":" ","type":"text"},{"text":"A slow handler delays only its own connection. This is the default.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"perConnection"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/perConnection","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.perConnection","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum/perconnection"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls the middleware","type":"text"},{"text":" ","type":"text"},{"text":"and the handlers, and writes the responses, one request at a time. Handlers, middleware and","type":"text"},{"text":" ","type":"text"},{"text":"everything else that runs in them need no locks, because they never run at the same time.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority);","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.singleThread","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum/singlethread"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS":{"abstract":[{"text":"The priority of the thread that accepts connections.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"acceptQoS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@NSQualityOfService","text":"QualityOfService"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","kind":"symbol","role":"symbol","title":"acceptQoS","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/acceptqos"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/connectionQoS":{"abstract":[{"text":"The priority of the threads that serve the connections.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectionQoS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@NSQualityOfService","text":"QualityOfService"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/connectionQoS","kind":"symbol","role":"symbol","title":"connectionQoS","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/connectionqos"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/hostPolicy-swift.property":{"abstract":[{"text":"Which ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":" headers the server answers. A web page can reach a server on this machine too: with","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"DNS rebinding","type":"text"}],"type":"emphasis"},{"text":" the page’s own domain is made to point to ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":", and the browser then sends","type":"text"},{"text":" ","type":"text"},{"text":"requests to the server with that domain as ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":", and lets the page read the answers. A server that","type":"text"},{"text":" ","type":"text"},{"text":"only accepts its own names is not fooled. The default is ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/any","isActive":true,"type":"reference"},{"text":", which accepts every","type":"text"},{"text":" ","type":"text"},{"code":"Host","type":"codeVoice"},{"text":"; ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/HostPolicy-swift.enum/automatic","isActive":true,"type":"reference"},{"text":" is what a server that is used from the browser of the same machine","type":"text"},{"text":" ","type":"text"},{"text":"should switch on. Requests that are refused get ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hostPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV10HostPolicyO","text":"HostPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/hostPolicy-swift.property","kind":"symbol","role":"symbol","title":"hostPolicy","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/hostpolicy-swift.property"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/idleTimeout":{"abstract":[{"text":"How long a connection may wait for a request to begin: after it was accepted, and after a","type":"text"},{"text":" ","type":"text"},{"text":"response when the connection is kept alive. A connection that stays silent that long is closed","type":"text"},{"text":" ","type":"text"},{"text":"without an answer. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever. The default is 60 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"idleTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/idleTimeout","kind":"symbol","role":"symbol","title":"idleTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/idletimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/init()":{"abstract":[{"text":"Creates the configuration of a new server: loopback only, default limits.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/init()","kind":"symbol","role":"symbol","title":"init()","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/init()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits":{"abstract":[{"text":"The largest requests the server accepts. A request that exceeds a limit is answered with","type":"text"},{"text":" ","type":"text"},{"code":"413","type":"codeVoice"},{"text":", ","type":"text"},{"code":"414","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"431","type":"codeVoice"},{"text":" and the connection is closed.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"limits"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPParserV","text":"NanoHTTPParser"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPParserV6LimitsV","text":"Limits"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits","kind":"symbol","role":"symbol","title":"limits","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/limits"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/listenAddress":{"abstract":[{"text":"Where the server listens. The default is ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/NanoListenAddress/loopback","isActive":true,"type":"reference"},{"text":": only programs on this","type":"text"},{"text":" ","type":"text"},{"text":"machine can connect. Use ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/NanoListenAddress/allInterfaces","isActive":true,"type":"reference"},{"text":" for a server that is meant to","type":"text"},{"text":" ","type":"text"},{"text":"be reached from other devices.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"listenAddress"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC0A13ListenAddressO","text":"NanoListenAddress"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/listenAddress","kind":"symbol","role":"symbol","title":"listenAddress","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/listenaddress"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger":{"abstract":[{"text":"Receives what the server reports: a response that could not be written, a pause in accepting","type":"text"},{"text":" ","type":"text"},{"text":"connections, a handler that threw an error, a WebSocket client that broke the protocol. The default","type":"text"},{"text":" ","type":"text"},{"text":"is a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger","isActive":true,"type":"reference"},{"text":", which writes to the unified logging system (the console of Xcode, the Console","type":"text"},{"text":" ","type":"text"},{"text":"app). A command-line tool that should print to its terminal uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","isActive":true,"type":"reference"},{"text":"; a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger","isActive":true,"type":"reference"},{"text":" switches logging off.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"logger"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPLoggerP","text":"NanoHTTPLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","kind":"symbol","role":"symbol","title":"logger","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/logger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections":{"abstract":[{"text":"The most connections the server serves at the same time (WebSocket sessions included). When","type":"text"},{"text":" ","type":"text"},{"text":"that many are open, a new connection is answered with ","type":"text"},{"code":"503 Service Unavailable","type":"codeVoice"},{"text":" and closed.","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" accepts any number; every connection uses a thread and a file descriptor. The default","type":"text"},{"text":" ","type":"text"},{"text":"is 128.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxConnections"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections","kind":"symbol","role":"symbol","title":"maxConnections","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/maxconnections"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/originPolicy-swift.property":{"abstract":[{"text":"Which ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" headers the server answers, for the requests that change something (everything but","type":"text"},{"text":" ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HEAD","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OPTIONS","type":"codeVoice"},{"text":") and for WebSocket handshakes. A browser sends the ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" of the page","type":"text"},{"text":" ","type":"text"},{"text":"with them, so that a page of another site that makes the browser send a request to this server","type":"text"},{"text":" ","type":"text"},{"text":"(a form that is submitted, a ","type":"text"},{"code":"fetch","type":"codeVoice"},{"text":", a WebSocket) can be told from the pages of the server itself.","type":"text"},{"text":" ","type":"text"},{"text":"Requests without an ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" (from tools that are not browsers) are always served. The default is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/any","isActive":true,"type":"reference"},{"text":"; ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/OriginPolicy-swift.enum/sameOrigin","isActive":true,"type":"reference"},{"text":" refuses requests that come from pages of other","type":"text"},{"text":" ","type":"text"},{"text":"sites with ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"originPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV12OriginPolicyO","text":"OriginPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/originPolicy-swift.property","kind":"symbol","role":"symbol","title":"originPolicy","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/originpolicy-swift.property"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/readTimeout":{"abstract":[{"text":"How long the server waits for more of a request once it has begun: the longest pause between two","type":"text"},{"text":" ","type":"text"},{"text":"parts of the request that arrive. A request that stalls longer is answered with ","type":"text"},{"code":"408 Request Timeout","type":"codeVoice"},{"text":". It is a pause, not the total time: a request that keeps arriving, slowly, is not cut","type":"text"},{"text":" ","type":"text"},{"text":"off. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever. The default is 30 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"readTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/readTimeout","kind":"symbol","role":"symbol","title":"readTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/readtimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout":{"abstract":[{"text":"How long a write to a connection that has been turned over to a session, such as a WebSocket, may be blocked","type":"text"},{"text":" ","type":"text"},{"text":"because the peer does not read: a write that makes no progress for that long fails, and the session ends. It is","type":"text"},{"text":" ","type":"text"},{"text":"shorter than ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","isActive":true,"type":"reference"},{"text":" because a message that is sent to many sessions (a chat, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"must not be held up for long by one client that has stopped reading, and on a server with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" a client that has stopped reading holds up the whole server for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or","type":"text"},{"text":" ","type":"text"},{"text":"zero) waits forever. The default is 5 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessionWriteTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","kind":"symbol","role":"symbol","title":"sessionWriteTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/sessionwritetimeout"},"doc://NanoHTTP/documentati