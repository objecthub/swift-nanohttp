{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls the middleware","type":"text"},{"text":" ","type":"text"},{"text":"and the handlers, and writes the responses, one request at a time. Handlers, middleware and","type":"text"},{"text":" ","type":"text"},{"text":"everything else that runs in them need no locks, because they never run at the same time.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority);","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses the calling thread.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV9ThreadingO12singleThreadyA2GmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Case","symbolKind":"case","title":"NanoHTTPServerIO.Configuration.Threading.singleThread"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["ma