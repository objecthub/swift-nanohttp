{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls","type":"text"},{"text":" ","type":"text"},{"text":"the middleware and the handlers, and writes the responses, one request at a","type":"text"},{"text":" ","type":"text"},{"text":"time. Handlers, middleware and everything else that runs in them need no locks,","type":"text"},{"text":" ","type":"text"},{"text":"because they never run at the same time. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority); ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses","type":"text"},{"text":" ","type":"text"},{"text":"the calling thread.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV9ThreadingO12singleThreadyA2GmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Case","symbolKind":"case","title":"NanoHTTPServerIO.Configuration.Thr