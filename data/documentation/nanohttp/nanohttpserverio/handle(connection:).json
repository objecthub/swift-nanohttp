{"abstract":[{"text":"Serves a connection: calls the handler of its first request, sends the response and, as long as","type":"text"},{"text":" ","type":"text"},{"text":"the connection is kept alive, does the same for the following requests. Returns when the","type":"text"},{"text":" ","type":"text"},{"text":"connection has ended. Runs on the thread of the connection.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC6handle10connectionyAA0A14HTTPConnectionV_tF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"connection"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPConnectionV","text":"NanoHTTPConnection"},{"kind":"text","text":")"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","title":"handle(connection:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"connection"},{"kind":"text","text":": "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A14HTTPConnectionV","text":"NanoHTTPConnection"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"A server with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" calls it for every request that arrives:","type":"text"},{"text":" ","type":"text"},{"text":"it returns after the response has been sent, and the connection, if it is kept alive, is left open","type":"text"},{"text":" ","type":"text"},{"text":"for the server to wait for the next request.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Override to wrap the handling (to measure the time of requests, for example) and call ","type":"text"},{"code":"super","type":"codeVoice"},{"text":". An","type":"text"},{"text":" ","type":"text"},{"text":"override that does not call ","type":"text"},{"code":"super","type":"codeVoice"},{"text":" can answer later, from another thread, instead: it calls","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection/deferResponse()","isActive":true,"type":"reference"},{"text":", passes the result on and returns. The server calls it again for","type":"text"},{"text":" ","type":"text"},{"text":"the next request of the connection after the answer has been sent (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection":{"abstract":[{"text":"A request that has been read from a connection, together with the handler that will answer it.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" drives the connection with it: ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" writes the","type":"text"},{"text":" ","type":"text"},{"text":"response and returns the connection for the next request, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the connection has ended.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPConnection"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPConnection"}],"role":"symbol","title":"NanoHTTPConnection","type":"topic","url":"/documentation/nanohttp/nanohttpconnection"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection/deferResponse()":{"abstract":[{"text":"Promises to answer the request later, from any thread, with the returned","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPDeferredResponse","isActive":true,"type":"reference"},{"text":". Call it in ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/handle(connection:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(and nowhere else), before it returns; the connection is not answered when ","type":"text"},{"code":"handle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"returns. Calling it again for the same request returns the same token.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deferResponse"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A20HTTPDeferredResponseC","text":"NanoHTTPDeferredResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPConnection/deferResponse()","kind":"symbol","role":"symbol","title":"deferResponse()","type"