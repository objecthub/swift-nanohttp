P/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS":{"abstract":[{"text":"The priority of the thread that accepts connections.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"acceptQoS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@NSQualityOfService","text":"QualityOfService"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","kind":"symbol","role":"symbol","title":"acceptQoS","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/acceptqos"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)":{"abstract":[{"text":"Chooses the handler for a request and returns it with the variables that the request’s route","type":"text"},{"text":" ","type":"text"},{"text":"defined (see ","type":"text"},{"code":"NanoHTTPRequest.params","type":"codeVoice"},{"text":"). The implementation of this class answers every request","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":"; ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" overrides it to route.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dispatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A11HTTPRequestC","text":"NanoHTTPRequest"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"Nan