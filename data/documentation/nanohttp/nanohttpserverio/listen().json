{"abstract":[{"text":"Accepts connections until the server is stopped or the listening socket fails. Runs on the","type":"text"},{"text":" ","type":"text"},{"text":"accepting thread; the server calls it by itself after ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/listen()"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC6listenyyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":"()"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","title":"listen()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"A failed attempt to accept does not stop the server unless the listening socket itself is","type":"text"},{"text":" ","type":"text"},{"text":"gone: an interrupted call or an aborted connection is simply retried, and running out of file","type":"text"},{"text":" ","type":"text"},{"text":"descriptors or memory pauses accepting (with a growing delay of up to a second) until the","type":"text"},{"text":" ","type":"text"},{"text":"shortage is over. Connections that arrive during the shortage can be lost, because the system","type":"text"},{"text":" ","type":"text"},{"text":"discards a connection it cannot hand out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" this thread also serves the connections.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO":{"abstract":[{"text":"The part of a server that deals with sockets and threads: it listens at a port, accepts","type":"text"},{"text":" ","type":"text"},{"text":"connections, reads the requests of each connection on a thread of its own, hands them to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)","isActive":true,"type":"reference"},{"text":" and writes the responses. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" builds routing on top of it;","type":"text"},{"text":" ","type":"text"},{"text":"subclass this class to use the server without routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServerIO"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServerIO"}],"role":"symbol","title":"NanoHTTPServerIO","type":"topic","url":"/documentation/nanohttp/nanohttpserverio"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls the middleware","type":"text"},{"text":" ","type":"text"},{"text":"and the handlers, and writes the responses, one request at a time. Handlers, middleware and","type":"text"},{"text":" ","type":"text"},{"text":"everything else that runs in them need no locks, because they never run at the same time.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority);","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.singleThr