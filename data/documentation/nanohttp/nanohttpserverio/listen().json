{"abstract":[{"text":"Accepts connections until the server is stopped or the listening socket fails. Runs","type":"text"},{"text":" ","type":"text"},{"text":"on the accepting thread; the server calls it by itself after ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/listen()"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12HTTPServerIOC6listenyyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":"()"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","title":"listen()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"A failed attempt to accept does not stop the server unless the listening socket","type":"text"},{"text":" ","type":"text"},{"text":"itself is gone: an interrupted call or an aborted connection is simply retried, and","type":"text"},{"text":" ","type":"text"},{"text":"running out of file descriptors or memory pauses accepting (with a growing delay of","type":"text"},{"text":" ","type":"text"},{"text":"up to a second) until the shortage is over. Connections that arrive during the","type":"text"},{"text":" ","type":"text"},{"text":"shortage can be lost, because the system discards a connection it cannot hand out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" this thread also serves the connections.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO":{"abstract":[{"text":"The part of a server that deals with sockets and threads: it listens at a port,","type":"text"},{"text":" ","type":"text"},{"text":"accepts connections, reads the requests of each connection on a thread of its own,","type":"text"},{"text":" ","type":"text"},{"text":"hands them to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/dispatch(request:)","isActive":true,"type":"reference"},{"text":" and writes the responses. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"builds routing on top of it; subclass this class to use the server without routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServerIO"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServerIO"}],"role":"symbol","title":"NanoHTTPServerIO","type":"topic","url":"/documentation/nanohttp/nanohttpserverio"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls","type":"text"},{"text":" ","type":"text"},{"text":"the middleware and the handlers, and writes the responses, one request at a","type":"text"},{"text":" ","type":"text"},{"text":"time. Handlers, middleware and everything else that runs in them need no locks,","type":"text"},{"text":" ","type":"text"},{"text":"because they never run at the same time. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority); ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses","type":"text"},{"text":" ","type":"text"},{"text":"the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.str