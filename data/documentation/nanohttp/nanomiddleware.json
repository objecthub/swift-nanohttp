{"abstract":[{"text":"Middleware for the usual jobs of a server that web pages talk to. They are values of","type":"text"},{"text":" ","type":"text"},{"text":"the type ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","isActive":true,"type":"reference"},{"text":": add them to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","isActive":true,"type":"reference"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A10MiddlewareO","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoMiddleware"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoMiddleware"}],"role":"symbol","roleHeading":"Enumeration","symbolKind":"enum","title":"NanoMiddleware"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoMiddleware"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"code":["let server = NanoHTTPServer()","server.middleware.append(","  NanoMiddleware.cors(NanoCORSPolicy(allowedOrigins: [\"https://app.example\"])))"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy":{"abstract":[{"text":"The rules of ","type":"text"},{"inlineContent":[{"text":"cross-origin resource sharing","type":"text"}],"type":"emphasis"},{"text":" (CORS), which decide what the pages of","type":"text"},{"text":" ","type":"text"},{"text":"other sites may do with a server: a browser lets a page read the answer of another","type":"text"},{"text":" ","type":"text"},{"text":"site’s server only if the answer says that the page’s origin is allowed. Use it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoMiddleware/cors(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoCORSPolicy"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoCORSPolicy","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoCORSPolicy"}],"role":"symbol","title":"NanoCORSPolicy","type":"topic","url":"/documentation/nanohttp/nanocorspolicy"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie":{"abstract":[{"text":"A cookie that a response asks the client to store (","type":"text"},{"code":"Set-Cookie","type":"codeVoice"},{"text":", RFC 6265).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPCookie"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPCookie","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPCookie"}],"role":"symbol","title":"NanoHTTPCookie","type":"topic","url":"/documentation/nanohttp/nanohttpcookie"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError":{"abstract":[{"text":"An error that a handler throws to answer a request with an error status code.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPError"}],"role":"symbol","title":"NanoHTTPError","type":"topic","url":"/documentation/nanohttp/nanohttperror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware":{"abstract":[{"text":"A function that wraps the handling of requests, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/middleware","isActive":true,"type":"reference"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"receives the request and ","type":"text"},{"code":"next","type":"codeVoice"},{"text":", which stands for the rest of the chain: the following","type":"text"},{"text":" ","type":"text"},{"text":"middleware, the router and the handler. Calling ","type":"text"},{"code":"next(request)","type":"codeVoice"},{"text":" lets the request","type":"text"},{"text":" ","type":"text"},{"text":"through and gives the response; a middleware may change the request before, change the","type":"text"},{"text":" ","type":"text"},{"text":"response afterwards, catch an error that ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" throws, or answer the request itself","type":"text"},{"text":" ","type":"text"},{"text":"and never call ","type":"text"},{"code":"next","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPMiddleware"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPMiddleware","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPMiddleware"}],"role":"symbol","title":"NanoHTTPMiddleware","type":"topic","url":"/documentation/nanohttp/nanohttpmiddleware"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser":{"abstract":[{"text":"Reads HTTP requests from a socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParser"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParser"}],"role":"symbol","title":"NanoHTTPParser","type":"topic","url":"/documentation/nanohttp/nanohttpparser"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError":{"abstract":[{"text":"The reasons why ","type":"text"},{"code":"NanoHTTPParser","type":"codeVoice"},{"text":" refuses a request. A server answers requests that","type":"text"},{"text":" ","type":"text"},{"text":"fail with one of these errors with the matching HTTP status code and closes the","type":"text"},{"text":" ","type":"text"},{"text":"connection; failures of the connection itself (peer closed, reset) surface as","type":"text"},{"text":" ","type":"text"},{"code":"NanoSocketError","type":"codeVoice"},{"text":". The error conforms to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":": its ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" ","type":"text"},{"text":"says in English what is wrong with the request. Text that the client sent is quoted","type":"text"},{"text":" ","type":"text"},{"text":"and escaped in it, so a control character cannot get into a log through it.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParserError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParserError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParserError"}],"role":"symbol","title":"NanoHTTPParserError","type":"topic","url":"/documentation/nanohttp/nanohttpparsererror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest":{"abstract":[{"text":"An HTTP request: method, path, query, headers and body, plus the address of the client","type":"text"},{"text":" ","type":"text"},{"text":"and the variables of the route that matched. The server creates one for every request","type":"text"},{"text":" ","type":"text"},{"text":"and hands it to middleware and handlers. A request is a reference type, compared and","type":"text"},{"text":" ","type":"text"},{"text":"hashed by identity.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequest"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequest"}],"role":"symbol","title":"NanoHTTPRequest","type":"topic","url":"/documentation/nanohttp/nanohttprequest"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler":{"abstract":[{"text":"A function that answers a request. It runs on the thread of the connection that sent","type":"text"},{"text":" ","type":"text"},{"text":"the request, one request at a time per connection, and many handlers run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time for different connections (unless the server has only one thread). A handler may","type":"text"},{"text":" ","type":"text"},{"text":"block (a slow handler delays only its own connection) but must protect state that it","type":"text"},{"text":" ","type":"text"},{"text":"shares with other handlers.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"role":"symbol","title":"NanoHTTPRequestHandler","type":"topic","url":"/documentation/nanohttp/nanohttprequesthandler"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse":{"abstract":[{"text":"The answer to a request: a status code, headers and a body. Use the static functions","type":"text"},{"text":" ","type":"text"},{"text":"to create the common responses:","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponse"}],"role":"symbol","title":"NanoHTTPResponse","type":"topic","url":"/documentation/nanohttp/nanohttpresponse"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)":{"abstract":[{"text":"A body that a function writes to the connection, for content that is not available as","type":"text"},{"text":" ","type":"text"},{"text":"a whole or too large to hold in memory. Whatever the function writes is sent at once.","type":"text"},{"text":" ","type":"text"},{"text":"Its length is not known, so the body is sent in chunks (","type":"text"},{"code":"Transfer-Encoding: chunked","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and the connection can be used for the next request; an HTTP/1.0 client, which does","type":"text"},{"text":" ","type":"text"},{"text":"not know chunks, gets the body up to the end of the connection. If the handler sets a","type":"text"},{"text":" ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" header, the body is sent with that length instead: the function has","type":"text"},{"text":" ","type":"text"},{"text":"to write exactly that many bytes, or the connection is closed after the response.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A22HTTPResponseBodyWriterP","text":"NanoHTTPResponseBodyWriter"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contentType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"identi