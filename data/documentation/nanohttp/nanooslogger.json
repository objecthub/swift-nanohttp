{"abstract":[{"text":"A logger that writes to the unified logging system of Apple’s platforms (","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":"): the messages","type":"text"},{"text":" ","type":"text"},{"text":"appear in the console of Xcode and in the Console app, with the subsystem ","type":"text"},{"code":"org.objecthub.NanoHTTP","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It is the default logger of a server.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A8OSLoggerC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoOSLogger"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoOSLogger"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NanoOSLogger"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoOSLogger"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The messages are logged as public: they contain paths and error descriptions of your own server,","type":"text"},{"text":" ","type":"text"},{"text":"which are what a developer wants to read. Messages of the level ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoLogLevel/debug","isActive":true,"type":"reference"},{"text":" are not","type":"text"},{"text":" ","type":"text"},{"text":"kept by the system unless debug logging is switched on for the subsystem.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A command-line tool does not see t