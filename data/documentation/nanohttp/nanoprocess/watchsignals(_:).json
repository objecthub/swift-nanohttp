rue,"type":"reference"},{"text":", but accepts connections on the calling thread, and returns","type":"text"},{"text":" ","type":"text"},{"text":"only when the server has been stopped (with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/stop()","isActive":true,"type":"reference"},{"text":", from another thread or a signal handler).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","kind":"symbol","role":"symbol","title":"run(_:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/run(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)":{"abstract":[{"text":"Starts to accept connections at ","type":"text"},{"code":"port","type":"codeVoice"},{"text":" (","type":"text"},{"code":"0","type":"codeVoice"},{"text":" picks a free port, see ","type":"text"},{"code":"port()","type":"codeVoice"},{"text":") and returns: the","type":"text"},{"text":" ","type":"text"},{"text":"connections are accepted and served on threads of the server (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/threading-swift.property","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Does nothing if the server is already running or is being started or stopped by another thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc://NanoHTTP/document