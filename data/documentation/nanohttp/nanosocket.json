{"abstract":[{"text":"A socket: a listening socket (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/tcpSocketForListen(_:_:backlog:)","isActive":true,"type":"reference"},{"text":") or one","type":"text"},{"text":" ","type":"text"},{"text":"end of a connection. It reads and writes bytes and lines, sends files, and is","type":"text"},{"text":" ","type":"text"},{"text":"where the server’s connections end up.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A6SocketC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocket"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoSocket"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NanoSocket"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocket"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"It can be used from several threads. In particular ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":" can be called while","type":"text"},{"text":" ","type":"text"},{"text":"other threads read or write: they fail or return, and the file descriptor is not","type":"text"},{"text":" ","type":"text"},{"text":"reused while any of them is running. Operations on a closed socket throw an error.","type":"text"},{"text":" ","type":"text"},{"text":"Several threads that write at the same time are not","type":"text"},{"text":" ","type":"text"},{"text":"synchronized with each other: the bytes of their writes may be mixed, so serialize","type":"text"},{"text":" ","type":"text"},{"text":"writes if a connection is written by more than one thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"does).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sockets are equal only if they are the same object.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/SH":{"identifier":"doc://NanoHTTP/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://NanoHTTP/SQ":{"identifier":"doc://NanoHTTP/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser":{"abstract":[{"text":"Reads HTTP requests from a socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPParser"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPParser"}],"role":"symbol","title":"NanoHTTPParser","type":"topic","url":"/documentation/nanohttp/nanohttpparser"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)":{"abstract":[{"text":"A body that a function writes to the connection, for content that is not available as","type":"text"},{"text":" ","type":"text"},{"text":"a whole or too large to hold in memory. Whatever the function writes is sent at once.","type":"text"},{"text":" ","type":"text"},{"text":"Its length is not known, so the body is sent in chunks (","type":"text"},{"code":"Transfer-Encoding: chunked","type":"c