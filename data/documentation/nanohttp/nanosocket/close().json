{"abstract":[{"text":"Closes the socket. Closing is idempotent and may be called from any thread, also","type":"text"},{"text":" ","type":"text"},{"text":"while other threads are reading from or writing to the socket.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoSocket"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/close()"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A6SocketC5closeyyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"()"}],"modules":[{"name":"NanoHTTP"}],"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","title":"close()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The connection is shut down first, which makes operations that are blocked right now","type":"text"},{"text":" ","type":"text"},{"text":"fail instead of waiting for the peer; then ","type":"text"},{"code":"close","type":"codeVoice"},{"text":" waits (for at most two seconds)","type":"text"},{"text":" ","type":"text"},{"text":"until all running operations have returned, and only then releases the descriptor.","type":"text"},{"text":" ","type":"text"},{"text":"Operations started afterwards fail without touching the descriptor.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket":{"abstract":[{"text":"A socket: a listening socket (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/tcpSocketForListen(_:_:backlog:)","isActive":true,"type":"reference"},{"text":") or one","type":"text"},{"text":" ","type":"text"},{"text":"end of a connection. It reads and writes bytes and lines, sends files, and is","type":"text"},{"text":" ","type":"text"},{"text":"where the server’s connections end up.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocket"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoSocket"}],"role":"symbol","title":"NanoSocket","type":"topic","url":"/documentation/nanohttp/nanosocket"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/close()":{"abstract":[{"text":"Closes the socket. Closing is idempotent and may be called from any thread, also","type":"text"},{"text":" ","type":"text"},{"text":"while other threads are reading from or writing to the socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"()"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/close()","kind":"symbol","role":"symbol","title":"close()","type":"topic","url":"/documentation/nanohttp/nanosocket/close()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/tcpSocketForListen(_:_:backlog:)":{"abstract":[{"text":"Creates a listening TCP socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tcpSocketForListen"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifie