{"abstract":[{"text":"A conversation over a connection that has been switched away from HTTP, such as a","type":"text"},{"text":" ","type":"text"},{"text":"WebSocket, which the server drives one step at a time. A response with such a session","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","isActive":true,"type":"reference"},{"text":") turns the connection over to it","type":"text"},{"text":" ","type":"text"},{"text":"once the ","type":"text"},{"code":"101","type":"codeVoice"},{"text":" response has been sent.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A13SocketSessionP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocketSession"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoSocketSession"}],"role":"symbol","roleHeading":"Protocol","symbolKind":"protocol","title":"NanoSocketSession"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocketSession"},{"kind":"text","text":" : AnyObject"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The server calls ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/start(socket:drainTimeout:logger:)","isActive":true,"type":"reference"},{"text":" once, then ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/receive()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"whenever the socket has something to read, and ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/end()","isActive":true,"type":"reference"},{"text":" once the session is over.","type":"text"},{"text":" ","type":"text"},{"text":"This lets a server that has only one thread","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":") serve many sessions and","type":"text"},{"text":" ","type":"text"},{"text":"all its other connections: it waits for all of them together, and a session never","type":"text"},{"text":" ","type":"text"},{"text":"holds the thread longer than it takes to handle one message. A server with a thread","type":"text"},{"text":" ","type":"text"},{"text":"per connection calls the same functions on the thread of the connection, which waits","type":"text"},{"text":" ","type":"text"},{"text":"for the socket between the calls.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Implement this protocol for a protocol of your own. For WebSockets, use the handler of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["// file scope","/// Answers every line it receives with the same line, in upper case.","final class ExampleUppercaseSession: NanoSocketSession {","  private var socket: NanoSocket?","","  func start(socket: NanoSocket, drainTimeout: TimeInterval, logger: NanoHTTPLogger) {","    self.socket = socket","    try? socket.writeUTF8(\"HELLO\\n\")","  }","","  func receive() -> Bool {","    guard let socket, let line = try? socket.readLine() else {","      return false                                   // the connection has ended","    }","    try? socket.writeUTF8(line.uppercased() + \"\\n\")","    return line != \"bye\"                             // false ends the session","  }","","  func end() {","    self.socket = nil","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The session is used from one thread at a time, but possibly from different threads one","type":"text"},{"text":" ","type":"text"},{"text":"after the other. A session that is shared with other code (a hub that sends to all","type":"text"},{"text":" ","type":"text"},{"text":"sessions) has to protect what it shares.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)":{"abstract":[{"text":"A ","type":"text"},{"code":"101 Switching Protocols","type":"codeVoice"},{"text":" response for a session that the server drives. After the","type":"text"},{"text":" ","type":"text"},{"text":"response was sent, the server calls the functions of ","type":"text"},{"code":"session","type":"codeVoice"},{"text":" when the socket has","type":"text"},{"text":" ","type":"text"},{"text":"something to read, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","isActive":true,"type":"reference"},{"text":". Unlike the other variant, this does","type":"text"},{"text":" ","type":"text"},{"text":"not hold the thread of a server that has only one thread: this is how the handler of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket","isActive":true,"type":"reference"},{"text":" upgrades a connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchProtocols"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A13SocketSessionP","text":"NanoSocketSession"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","kind":"symbol","role":"symbol","title":"switchProtocols(_:session:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/switchprotocols(_:session:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls","type":"text"},{"text":" ","type":"text"},{"text":"the middleware and the handlers, and writes the responses, one request at a","type":"text"},{"text":" ","type":"text"},{"text":"time. Handlers, middleware and everything else that runs in them need no locks,","type":"text"},{"text":" ","type":"text"},{"text":"because they never run at the same time. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority); ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses","type":"text"},{"text":" ","type":"text"},{"text":"the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.singleThread","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum/singlethread"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS":{"abstract":[{"text":"The priority of the thread that accepts connections.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"acceptQoS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@NSQualityOfService","text":"QualityOfService"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","kind":"symbol","role":"symbol","title":"acceptQoS","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/acceptqos"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)":{"abstract":[{"text":"Starts the server like ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":", but accepts connections on the calling thread,","type":"text"},{"text":" ","type":"text"},{"text":"and returns only when the server has been stopped (with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/stop()","isActive":true,"type":"reference"},{"text":", from another","type":"text"},{"text":" ","type":"text"},{"text":"thread or a signal handler).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","kind":"symbol","role":"symbol","title":"run(_:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/run(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)":{"abstract":[{"text":"Starts to accept connections at ","type":"text"},{"code":"port","type":"codeVoice"},{"text":" (","type":"text"},{"code":"0","type":"codeVoice"},{"text":" picks a free port, see ","type":"text"},{"code":"port()","type":"codeVoice"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"returns: the connections are accepted and served on threads of the server (see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/threading-swift.property","isActive":true,"type":"reference"},{"text":"). Does nothing if the server is already running or is","type":"text"},{"text":" ","type":"text"},{"text":"being started or stopped by another thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","kind":"symbol","role":"symbol","title":"start(_:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/start(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession":{"abstract":[{"text":"A conversation over a connection that has been switched away from HTTP, such as a","type":"text"},{"text":" ","type":"text"},{"text":"WebSocket, which the server drives one step at a time. A response with such a session","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","isActive":true,"type":"reference"},{"text":") turns the connection over to it","type":"text"},{"text":" ","type":"text"},{"text":"once the ","type":"text"},{"code":"101","type":"codeVoice"},{"text":" response has been sent.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocketSession"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoSocketSession"}],"role":"symbol","title":"NanoSocketSession","type":"topic","url":"/documentation/nanohttp/nanosocketsession"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/end()":{"abstract":[{"text":"Called once when the session is over: after ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/receive()","isActive":true,"type":"reference"},{"text":" returned ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and when","type":"text"},{"text":" ","type":"text"},{"text":"the server stops. The server closes the socket afterwards.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"end"},{"kind":"text","text":"()"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/end()","kind":"symbol","required":true,"role":"symbol","title":"end()","type":"topic","url":"/documentation/nanohttp/nanosocketsession/end()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/receive()":{"abstract":[{"text":"Called when the socket has data to read, or has been closed by the peer or the","type":"text"},{"text":" ","type":"text"},{"text":"server. Reads and handles what has arrived and returns without waiting for more: a","type":"text"},{"text":" ","type":"text"},{"text":"message that is only partly there can be waited for, up to the read timeout. Returns","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" to end the session.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"receive"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/receive()","kind":"symbol","required":true,"role":"symbol","title":"receive()","type":"topic","url":"/documentation/nanohttp/nanosocketsession/receive()"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/start(socket:drainTimeout:logger:)":{"abstract":[{"text":"Called once, after the response has been sent, on the thread that serves the connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"("},{"kind":"externalParam","text":"socket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A6SocketC","text":"NanoSocket"},{"kind":"text","text":", "},{"kind":"externalParam","text":"drainTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"externalParam","text":"logger"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPLoggerP","text":"NanoHTTPLogger"},{"kind":"text","text":")"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/start(socket:drainTimeout:logger:)","kind":"symbol","required":true,"role":"symbol","title":"start(socket:drainTimeout:logger:)","type":"topic","url":"/documentation/nanohttp/nanosocketsession/start(socket:draintimeout:logg