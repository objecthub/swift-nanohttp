{"abstract":[{"text":"Called once, after the response has been sent, on the thread that serves the connection.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP","doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession/start(socket:drainTimeout:logger:)"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A13SocketSessionP5start6socket12drainTimeout6loggeryAA0aC0C_SdAA0A10HTTPLogger_ptF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"("},{"kind":"externalParam","text":"socket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A6SocketC","text":"NanoSocket"},{"kind":"text","text":", "},{"kind":"externalParam","text":"drainTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"externalParam","text":"logger"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPLoggerP","text":"NanoHTTPLogger"},{"kind":"text","text":")"}],"modules":[{"name":"NanoHTTP"}],"required":true,"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","title":"start(socket:drainTimeout:logger:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"("},{"kind":"externalParam","text":"socket"},{"kind":"text","text":": "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A6SocketC","text":"NanoSocket"},{"kind":"text","text":", "},{"kind":"externalParam","text":"drainTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"externalParam","text":"logger"},{"kind":"text","text":": "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPLoggerP","text":"NanoHTTPLogger"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The receive timeout of the socket is the ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/readTimeout","isActive":true,"type":"reference"},{"text":" of the server: a read","type":"text"},{"text":" ","type":"text"},{"text":"that waits longer than that for the rest of a message throws ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketError/timedOut","isActive":true,"type":"reference"},{"text":". (The server waits","type":"text"},{"text":" ","type":"text"},{"text":"for the next message itself, without a limit.) ","type":"text"},{"code":"drainTimeout","type":"codeVoice"},{"text":" is how long to read and drop what a client","type":"text"},{"text":" ","type":"text"},{"text":"still sends when the connection is closed because of an error: a connection that is closed while the peer is","type":"text"},{"text":" ","type":"text"},{"text":"still sending is reset, and the peer then loses the last message that the session sent (the close frame of a","type":"text"},{"text":" ","type":"text"},{"text":"WebSocket). ","type":"text"},{"code":"logger","type":"codeVoice"},{"text":" is the logger of the server (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","isActive":true,"type":"reference"},{"text":"): report","type":"text"},{"text":" ","type":"text"},{"text":"what goes wrong in the session with it, for example a client that does not follow the protocol, instead of","type":"text"},{"text":" ","type":"text"},{"text":"printing it.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger":{"abstract":[{"text":"A logger that prints one line for every message, such as ","type":"text"},{"code":"[WARNING] Unable to accept a connection","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"for command-line tools and for tests. By default the lines are printed to the standard output, and every line is","type":"text"},{"text":" ","type":"text"},{"text":"flushed: when the output goes to a pipe or a file (","type":"text"},{"code":"tool | tee log","type":"codeVoice"},{"text":"), the standard output is buffered, and the","type":"text"},{"text":" ","type":"text"},{"text":"lines would otherwise show up late.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoConsoleLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoConsoleLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoConsoleLogger"}],"role":"symbol","title":"NanoConsoleLogger","type":"topic","url":"/documentation/nanohttp/nanoconsolelogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger":{"abstract":[{"text":"Receives the messages that a server reports: a response that could not be written, a pause in","type":"text"},{"text":" ","type":"text"},{"text":"accepting connections, a handler that threw an error, a WebSocket client that broke the protocol.","type":"text"},{"text":" ","type":"text"},{"text":"Set the logger of a server with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/logger","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPLogger"}],"role":"symbol","title":"NanoHTTPLogger","type":"topic","url":"/documentation/nanohttp/nanohttplogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)":{"abstract":[{"text":"A ","type":"text"},{"code":"101 Switching Protocols","type":"codeVoice"},{"text":" response for a session that the server drives. After the response was sent,","type":"text"},{"text":" ","type":"text"},{"text":"the server calls the functions of ","type":"text"},{"code":"session","type":"codeVoice"},{"text":" when the socket has something to read, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","isActive":true,"type":"reference"},{"text":". Unlike the other variant, this does not hold the thread of a server that has only one","type":"text"},{"text":" ","type":"text"},{"text":"thread: this is how ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket/handler(text:binary:pong:connected:disconnected:maxMessageSize:origins:protocols:hub:)","isActive":true,"type":"reference"},{"text":" upgrades a","type":"text"},{"text":" ","type":"text"},{"text":"connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchProtocols"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","p