":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoOSLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoOSLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoOSLogger"}],"role":"symbol","title":"NanoOSLogger","type":"topic","url":"/documentation/nanohttp/nanooslogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger":{"abstract":[{"text":"A logger that discards everything: use it to switch logging off.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSilentLogger"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSilentLogger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoSilentLogger"}],"role":"symbol","title":"NanoSilentLogger","type":"topic","url":"/documentation/nanohttp/nanosilentlogger"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket":{"abstract":[{"text":"A socket: a listening socket (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/tcpSocketForListen(_:_:backlog:)","isActive":true,"type":"reference"},{"text":") or one","type":"text"},{"text":" ","type":"text"},{"text":"end of a connection. It reads and writes bytes and lines, sends files, and is","type":"text"},{"text":" ","type":"text"},{"text":"where the server’s connections end up.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocket"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoSocket"}],"role":"symbol","title":"NanoSocket","type":"topic","url":"/documentation/nanohttp/nanosocket"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/setReceiveTimeout(_:)":{"abstract":[{"text":"Limits how long a read waits for data. A read that waits longer throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketError/timedOut","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero or less) waits forever, which is how","type":"text"},{"text":" ","type":"text"},{"text":"a socket starts. Does nothing on a closed socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setReceiveTimeout"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/setReceiveTimeout(_:)","kind":"symbol","role":"symbol","title":"setReceiveTimeout(_:)","type":"topic","url":"/documentation/nanohttp/nanosocket/setreceivetimeout(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/setSendTimeout(_:)":{"abstract":[{"text":"Limits how long a write waits for the peer to take data: a write that makes","type":"text"},{"text":" ","type":"text"},{"text":"no progress for that long throws ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketError/timedOut","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero","type":"text"},{"text":" ","type":"text"},{"text":"or less) waits forever, which is how a socket starts. Does nothing on a closed socket.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setSendTimeout"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?)"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/setSendTimeout(_:)","kind":"symbol","role":"symbol","title":"setSendTimeout(_:)","type":"topic","url":"/documentation/nanohttp/nanosocket/setsendtimeout(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocket/tcpSocketForListen(_:_