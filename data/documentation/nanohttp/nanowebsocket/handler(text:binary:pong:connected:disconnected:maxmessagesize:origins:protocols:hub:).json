ier":"s:SS","text":"String"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"hub"},{"kind":"text","text":": "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12WebSocketHubC","text":"NanoWebSocketHub"},{"kind":"text","text":"? = nil) -> "},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Called with every complete text message.","type":"text"}],"type":"paragraph"}],"name":"text"},{"content":[{"inlineContent":[{"text":"Called with every complete binary message.","type":"text"}],"type":"paragraph"}],"name":"binary"},{"content":[{"inlineContent":[{"text":"Called with the payload of every pong frame.","type":"text"}],"type":"paragraph"}],"name":"pong"},{"content":[{"inlineContent":[{"text":"Called once the connection is established.","type":"text"}],"type":"paragraph"}],"name":"connected"},{"content":[{"inlineContent":[{"text":"Called once the connection has ended.","type":"text"}],"type":"paragraph"}],"name":"disconnected"},{"content":[{"inlineContent":[{"text":"The largest accepted message (and frame payload) in bytes.","type":"text"}],"type":"paragraph"}],"name":"maxMessageSize"},{"content":[{"inlineContent":[{"text":"Which pages may connect, see above. The default accepts every page.","type":"text"}],"type":"paragraph"}],"name":"origins"},{"content":[{"inlineContent":[{"text":"The subprotocols that the handler speaks, in the order of its preference.","type":"text"}],"type":"paragraph"}],"name":"protocols"},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","isActive":true,"type":"reference"},{"text":" that the sessions join when they are connected, and","type":"text"},{"text":" ","type":"text"},{"text":"leave when they have ended.","type":"text"}],"type":"paragraph"}],"name":"hub"}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"code":["let server = NanoHTTPServer()","server[\"/chat\"] = NanoWebSocket.handler(text: { session, text in","  session.writeText(text)","})"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The closures run on the thread that serves the connection, one message at a time. A","type":"text"},{"text":" ","type":"text"},{"text":"closure that blocks delays the processing of later messages of the same connection","type":"text"},{"text":" ","type":"text"},{"text":"only.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Messages larger than ","type":"text"},{"code":"maxMessageSize","type":"codeVoice"},{"text":" bytes, whether sent as one frame or assembled from","type":"text"},{"text":" ","type":"text"},{"text":"fragments, end the connection.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The handshake must be a ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":" request for version 13 of the protocol; other versions","type":"text"},{"text":" ","type":"text"},{"text":"are answered with ","type":"text"},{"code":"426 Upgrade Required","type":"codeVoice"},{"text":" (and the header ","type":"text"},{"code":"Sec-WebSocket-Version: 13","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"A connection that ends because of an error is closed with the matching status code","type":"text"},{"text":" ","type":"text"},{"text":"(1002 protocol error, 1007 invalid text, 1009 message too big); a close frame of the","type":"text"},{"text":" ","type":"text"},{"text":"client is answered with its own code.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Which pages may connect.","type":"text"}],"type":"strong"},{"text":" A page of any site can open a WebSocket to a server","type":"text"},{"text":" ","type":"text"},{"text":"that its browser can reach, and the browser tells the server the page’s ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"origins","type":"codeVoice"},{"text":" makes this handler check it: a handshake that has an ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" that is not","type":"text"},{"text":" ","type":"text"},{"text":"allowed is answered with ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":". The check is in addition to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/originPolicy-swift.property","isActive":true,"type":"reference"},{"text":" of the server, which looks at every","type":"text"},{"text":" ","type":"text"},{"text":"handshake already (if it is switched on); use ","type":"text"},{"code":"origins","type":"codeVoice"},{"text":" to protect a WebSocket on a","type":"text"},{"text":" ","type":"text"},{"text":"server whose other routes are open to other sites.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Subprotocols.","type":"text"}],"type":"strong"},{"text":" A client can offer protocols that it speaks","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"new WebSocket(url, [\"chat.v2\", \"chat.v1\"])","type":"codeVoice"},{"text":"). With ","type":"text"},{"code":"protocols","type":"codeVoice"},{"text":" the handler chooses","type":"text"},{"text":" ","type":"text"},{"text":"the first of its own that the client offers, answers with it, and tells it to the","type":"text"},{"text":" ","type":"text"},{"text":"closures as ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession/subprotocol","isActive":true,"type":"reference"},{"text":". A client that offers protocols of","type":"text"},{"text":" ","type":"text"},{"text":"which the handler knows none is answered with ","type":"text"},{"code":"400 Bad Request","type":"codeVoice"},{"text":"; a client that","type":"text"},{"text":" ","type":"text"},{"text":"offers none is accepted, and no protocol is chosen. Without ","type":"text"},{"code":"protocols","type":"codeVoice"},{"text":" the header","type":"text"},{"text":" ","type":"text"},{"text":"of the client is ignored.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler":{"abstract":[{"text":"A function that answers a request. It runs on the thread of the connection that sent","type":"text"},{"text":" ","type":"text"},{"text":"the request, one request at a time per connection, and many handlers run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time for different connections (unless the server has only one thread). A handler may","type":"text"},{"text":" ","type":"text"},{"text":"block (a slow handler delays only its own connection) but must protect state that it","type":"text"},{"text":" ","type":"text"},{"text":"shares with other handlers.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequestHandler","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRequestHandler"}],"role":"symbol","title":"NanoHTTPRequestHandler","type":"topic","url":"/documentation/nanohttp/nanohttprequesthandler"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchPro