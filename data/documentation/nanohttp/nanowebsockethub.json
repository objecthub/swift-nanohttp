{"abstract":[{"text":"The WebSocket sessions of a server that belong together, such as the participants of a chat, with a way to send","type":"text"},{"text":" ","type":"text"},{"text":"a message to all of them.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub"},"kind":"symbol","metadata":{"externalID":"s:8NanoHTTP0A12WebSocketHubC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoWebSocketHub"}],"modules":[{"name":"NanoHTTP"}],"navigatorTitle":[{"kind":"identifier","text":"NanoWebSocketHub"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NanoWebSocketHub"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoWebSocketHub"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://NanoHTTP/documentation/NanoHTTP/Examples"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A hub is thread-safe: it can be used from the closures of the sessions, from request handlers, and from any other","type":"text"},{"text":" ","type":"text"},{"text":"thread, and it needs no locks on your side, also on a server that runs on one thread. The sessions join","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket/handler(text:binary:pong:connected:disconnected:maxMessageSize:origins:protocols:hub:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"is given the hub, and leave when their connections have ended.","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","let chat = NanoWebSocketHub()","server[\"/chat\"] = NanoWebSocket.handler(","  text: { session, text in chat.broadcast(text: text, except: session) },","  hub: chat)","server.post[\"/announce\"] = { request in","  chat.broadcast(text: \"Announcement: \\(request.bodyString ?? \"\")\")","  return .ok(.text(\"sent to \\(chat.count) people\"))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A message is written to the sessions one after the other. A client that does not read holds up the ones behind it","type":"text"},{"text":" ","type":"text"},{"text":"for at most the ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","isActive":true,"type":"reference"},{"text":" (5 seconds by default); its connection","type":"text"},{"text":" ","type":"text"},{"text":"is closed then, and it leaves the hub.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/Examples":{"abstract":[{"text":"Six small programs that show how the pieces fit together, and that you can run.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Examples","kind":"article","role":"article","title":"Examples","type":"topic","url":"/documentation/nanohttp/examples"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)":{"abstract":[{"text":"A ","type":"text"},{"code":"101 Switching Protocols","type":"codeVoice"},{"text":" response for a session that the server drives. After the response was sent,","type":"text"},{"text":" ","type":"text"},{"text":"the server calls the functions of ","type":"text"},{"code":"session","type":"codeVoice"},{"text":" when the socket has something to read, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","isActive":true,"type":"reference"},{"text":". Unlike the other variant, this does not hold the thread of a server that has only one","type":"text"},{"text":" ","type":"text"},{"text":"thread: this is how ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket/handler(text:binary:pong:connected:disconnected:maxMessageSize:origins:protocols:hub:)","isActive":true,"type":"reference"},{"text":" upgrades a","type":"text"},{"text":" ","type":"text"},{"text":"connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchProtocols"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A13SocketSessionP","text":"NanoSocketSession"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","kind":"symbol","role":"symbol","title":"switchProtocols(_:session:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/switchprotocols(_:session:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls the middleware","type":"text"},{"text":" ","type":"text"},{"text":"and the handlers, and writes the responses, one request at a time. Handlers, middleware and","type":"text"},{"text":" ","type":"text"},{"text":"everything else that runs in them need no locks, because they never run at the same time.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority);","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.singleThread","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum/singlethread"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout":{"abstract":[{"text":"How long a write to a connection that has been turned over to a session, such as a WebSocket, may be blocked","type":"text"},{"text":" ","type":"text"},{"text":"because the peer does not read: a write that makes no progress for that long fails, and the session ends. It is","type":"text"},{"text":" ","type":"text"},{"text":"shorter than ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","isActive":true,"type":"reference"},{"text":" because a message that is sent to many sessions (a chat, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"must not be held up for long by one client that has stopped reading, and on a server with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" a client that has stopped reading holds up the whole server for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or","type":"text"},{"text":" ","type":"text"},{"text":"zero) waits forever. The default is 5 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessionWriteTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","kind":"symbol","role":"symbol","title":"sessionWriteTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/sessionwritetimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout":{"abstract":[{"text":"How long a write may be blocked because the peer does not read: the connection is closed when","type":"text"},{"text":" ","type":"text"},{"text":"the peer takes nothing for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever. The default is 30 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","kind":"symbol","role":"symbol","title":"writeTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/writetimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession":{"abstract":[{"text":"A conversation over a connection that has been switched away from HTTP, such as a WebSocket, which the","type":"text"},{"text":" ","type":"text"},{"text":"server drives one step at a time. A response with such a session","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","isActive":true,"type":"reference"},{"text":") turns the connection over to it once the ","type":"text"},{"code":"101","type":"codeVoice"},{"text":" response","type":"text"},{"text":" ","type":"text"},{"text":"has been sent.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoSocketSession"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoSocketSession"}],"role":"symbol","title":"NanoSocketSession","type":"topic","url":"/documentation/nanohttp/nanosocketsession"},"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket":{"abstract":[{"text":"The WebSocket support of the server: ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket/handler(text:binary:pong:connected:disconnected:maxMessageSize:origins:protocols:hub:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"creates the handler that upgrades a request to a WebSocket connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoWebSocket"}],"identif