P/documentation/NanoHTTP/NanoLogLevel/info","isActive":true,"type":"reference"},{"text":" (if the session has a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession/logger","isActive":true,"type":"reference"},{"text":"), the","type":"text"},{"text":" ","type":"text"},{"text":"connection is closed, and later writes are a harmless no-op.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/SH":{"identifier":"doc://NanoHTTP/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://NanoHTTP/SQ":{"identifier":"doc://NanoHTTP/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)":{"abstract":[{"text":"A ","type":"text"},{"code":"101 Switching Protocols","type":"codeVoice"},{"text":" response for a session that the server drives. After the","type":"text"},{"text":" ","type":"text"},{"text":"response was sent, the server calls the functions of ","type":"text"},{"code":"session","type":"codeVoice"},{"text":" when the socket has","type":"text"},{"text":" ","type":"text"},{"text":"something to read, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","isActive":true,"type":"reference"},{"text":". Unlike the other variant, this does","type":"text"},{"text":" ","type":"text"},{"text":"not hold the thread of a server that has only one thread: this is how the handler of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket","isActive":true,"type":"reference"},{"text":" upgrades a connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchProtocols"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A13SocketSessionP","text":"NanoSocketSession"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","kind":"symbol","role":"symbol","title":"switchProtocols(_:session:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/switchprotocols(_:session:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls","type":"text"},{"text":" ","type":"text"},{"text":"the middleware and the handlers, and writes the responses, one request at a","type":"text"},{"text":" ","type":"text"},{"text":"time. Handlers, middleware and everything else that runs in them need no locks,","type":"text"},{"text":" ","type":"text"},{"text":"because they never run at the same time. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority); ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses","type":"text"},{"text":" ","type":"text"},{"text":"the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.singleThread","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum/singlethread"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout":{"abstract":[{"text":"How long a write to a connection that has been turned over to a session, such as a","type":"text"},{"text":" ","type":"text"},{"text":"WebSocket, may be blocked because the peer does not read: a write that makes no","type":"text"},{"text":" ","type":"text"},{"text":"progress for that long fails, and the session ends. It is shorter than ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"because a message that is sent to many sessions (a chat, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"must not be held up for long by one client that has stopped reading, and on a","type":"text"},{"text":" ","type":"text"},{"text":"server with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" a client that has stopped reading holds up","type":"text"},{"text":" ","type":"text"},{"text":"the whole server for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever. The default is 5","type":"text"},{"text":" ","type":"text"},{"text":"seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessionWriteTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","kind":"symbol","role":"symbol","title":"sessionWriteTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/sessionwritetimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout":{"abstract":[{"text":"How long a write may be blocked because the peer does not read: the connection is","type":"text"},{"text":" ","type":"text"},{"text":"closed when the peer takes nothing for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever.","type":"text"},{"text":" ","type":"text"},{"text":"The default is 30 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","kind":"symbol","role":"symbol","title":"writeTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/writetimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoLogLevel/info":{"abstract":[{"text":"Something worth knowing that is not a problem: a c