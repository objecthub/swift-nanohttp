{"abstract":[{"text":"Match the method and path of a request to a handler, and capture parts of the path.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/Routing"},"kind":"article","metadata":{"modules":[{"name":"NanoHTTP"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Routing"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Handlers are registered with the method of the request and a ","type":"text"},{"inlineContent":[{"text":"route","type":"text"}],"type":"emphasis"},{"text":": a path pattern.","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.get[\"/about\"] = { _ in .ok(.text(\"About\")) }                       // a fixed path","server.get[\"/users/:id\"] = { request in .ok(.text(request.params[\"id\"] ?? \"\")) }","server.get[\"/files/::path\"] = { request in .ok(.text(request.params[\"path\"] ?? \"\")) }","server.get[\"/a/*/c\"] = { _ in .ok(.text(\"anything in the middle\")) }","server.get[\"/docs/**\"] = { _ in .ok(.text(\"anything below /docs\")) }","server.post[\"/items\"] = { _ in .created() }","server.delete[\"/items/:id\"] = { _ in .ok(.empty) }","server[\"/status\", \"/health\"] = { _ in .ok(.text(\"ok\")) }                  // every method, two paths"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"server.get","type":"codeVoice"},{"text":", ","type":"text"},{"code":"post","type":"codeVoice"},{"text":", ","type":"text"},{"code":"put","type":"codeVoice"},{"text":", ","type":"text"},{"code":"patch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"delete","type":"codeVoice"},{"text":", ","type":"text"},{"code":"head","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"options","type":"codeVoice"},{"text":" register for one method (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","isActive":true,"type":"reference"},{"text":");","type":"text"},{"text":" ","type":"text"},{"code":"server[...]","type":"codeVoice"},{"text":" registers for every method. A handler for a specific method wins over one for every method.","type":"text"},{"text":" ","type":"text"},{"text":"Assigning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" removes a registration. A HEAD request is answered by a handler registered for HEAD, else by the","type":"text"},{"text":" ","type":"text"},{"text":"handler of a GET route (without the body), else by one for every method. A request with a method that a path does not","type":"text"},{"text":" ","type":"text"},{"text":"have gets ","type":"text"},{"code":"405","type":"codeVoice"},{"text":" and the methods that it has, and ","type":"text"},{"code":"OPTIONS","type":"codeVoice"},{"text":" requests list them, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses","isActive":true,"type":"reference"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"server.options[...]","type":"codeVoice"},{"text":" registers handlers for ","type":"text"},{"code":"OPTIONS","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Patterns","level":3,"text":"Patterns","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"In the route","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Matches","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"about","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"the segment ","type":"text"},{"code":"about","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"code":":id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"exactly one segment","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"request.params[\"id\"]","type":"codeVoice"},{"text":", percent-decoded","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"::path","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"any number of segments, also none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"request.params[\"path\"]","type":"codeVoice"},{"text":", the percent-decoded segments joined by ","type":"text"},{"code":"/","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"*","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"exactly one segment","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"code":"**","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"any number of segments, also none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Paths are split at ","type":"text"},{"code":"/","type":"codeVoice"},{"text":". Empty segments are ignored, so ","type":"text"},{"code":"/a//b/","type":"codeVoice"},{"text":" matches the route ","type":"text"},{"code":"/a/b","type":"codeVoice"},{"text":", and the query","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"?x=1","type":"codeVoice"},{"text":") is not part of the path.","type":"text"}],"type":"paragraph"},{"anchor":"Which-route-wins","level":3,"text":"Which route wins","type":"heading"},{"inlineContent":[{"text":"Fixed segments are tried before variables, and the search backtracks: with the routes ","type":"text"},{"code":"/a/b/c","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"/a/:x/d","type":"codeVoice"},{"text":", the request ","type":"text"},{"code":"/a/b/d","type":"codeVoice"},{"text":" first follows the fixed ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", finds no ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" after it, and then tries the","type":"text"},{"text":" ","type":"text"},{"text":"variable. Two variable routes that could both match the same request (","type":"text"},{"code":"/a/:x","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/a/*","type":"codeVoice"},{"text":") are tried in the order in","type":"text"},{"text":" ","type":"text"},{"text":"which they were registered, the first one that matches wins. Avoid such overlaps all the same: they are hard to read.","type":"text"}],"type":"paragraph"},{"anchor":"Percent-encoding","level":3,"text":"Percent-encoding","type":"heading"},{"inlineContent":[{"text":"The router matches the path as the client sent it (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath","isActive":true,"type":"reference"},{"text":"): the path is split at ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" first, and","type":"text"},{"text":" ","type":"text"},{"text":"then every segment is decoded before it is compared with a fixed segment or becomes the value of a variable. An encoded","type":"text"},{"text":" ","type":"text"},{"text":"slash therefore stays inside its segment:","type":"text"}],"type":"paragraph"},{"code":["GET /users/J%C3%BCrgen%20M     params[\"id\"]   == \"Jürgen M\"","GET /files/a/b%20c.txt         params[\"path\"] == \"a/b c.txt\"","GET /files/a%2Fb               params[\"path\"] == \"a/b\"        (one segment, which contains a slash)","GET /a%2Fb                     does not match the route /a/b  (but does match /:x, with x == \"a/b\")"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"All values are decoded once, also those of path variables: do not decode them again (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/ReadingRequests","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"A segment that is not valid percent-encoding (","type":"text"},{"code":"%zz","type":"codeVoice"},{"text":", or bytes that are no UTF-8) does not match anything.","type":"text"}],"type":"paragraph"},{"anchor":"A-variable-at-the-end-of-a-route","level":3,"text":"A variable at the end of a route","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":":variable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" needs its segment: with only the route ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":", the request ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":" matches nothing, and is","type":"text"},{"text":" ","type":"text"},{"text":"answered like any other unknown path (","type":"text"},{"code":"404","type":"codeVoice"},{"text":", or the ","type":"text"},{"code":"405","type":"codeVoice"},{"text":" that tells which methods the path has). Only the path variables","type":"text"},{"text":" ","type":"text"},{"code":"::name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" can stand for nothing: ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"params[\"path\"] == \"\"","type":"codeVoice"},{"text":". (In","type":"text"},{"text":" ","type":"text"},{"text":"1.x a variable at the end of a route matched a missing segment too, with the empty string; see ","type":"text"},{"code":"MIGRATION-2.0.md","type":"codeVoice"},{"text":".)","type":"text"}],"type":"paragraph"},{"anchor":"Groups-of-routes","level":3,"text":"Groups of routes","type":"heading"},{"inlineContent":[{"text":"A group of routes can be built on its own and mounted below a prefix. The routes are copied when they are","type":"text"},{"text":" ","type":"text"},{"text":"mounted:","type":"text"}],"type":"paragraph"},{"code":["let api = NanoHTTPSegmentRouter()","api.register(\"GET\", path: \"/items/:id\") { request in","  .ok(.text(\"item \\(request.params[\"id\"] ?? \"\")\"))","}","let server = NanoHTTPServer()","try server.use(\"/api/v1\", router: api)          // GET /api/v1/items/7"],"syntax":"swift","type":"codeListing"},{"anchor":"Unknown-paths","level":3,"text":"Unknown paths","type":"heading"},{"inlineContent":[{"text":"A request that matches no route is passed to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/notFoundHandler","isActive":true,"type":"reference"},{"text":"; without one the server answers","type":"text"},{"text":" ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":" with an empty body. A request for a known path with another method is answered the same way,","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"404","type":"codeVoice"},{"text":", not with ","type":"text"},{"code":"405","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.notFoundHandler = { request in","  .notFound(.text(\"There is nothing at \\(request.path)\"))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/routes","isActive":true,"type":"reference"},{"text":" lists the registered patterns, which is handy for an index page.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/Examples":{"abstract":[{"text":"Six small programs that show how the pieces fit together, and that you can run.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Examples","kind":"article","role":"article","title":"Examples","type":"topic","url":"/documentation/nanohttp/examples"},"doc://NanoHTTP/documentation/NanoHTTP/GettingStarted":{"abstract":[{"text":"Add NanoHTTP to a project, answer your first request and learn where to go next.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/GettingStarted","kind":"article","role":"article","title":"Getting Started","type":"topic","url":"/documentation/nanohttp/gettingstarted"},"doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses":{"abstract":[{"text":"Answer requests with text, JSON, bytes, redirects or streamed content.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses","kind":"article","role":"collectionGroup","title":"Handlers and Responses","type":"topic","url":"/documentation/nanohttp/handlersandresponses"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/path":{"abstract":[{"text":"The path of the request, ","type":"text"},{"inlineContent":[{"text":"decoded","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"/a%20b/%C3%A9","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"/a b/é","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" stays a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"%2F","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"that cannot be told from a separator any more (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath","isActive":true,"type":"reference"},{"text":" can). Text that is not valid percent-encoding","type":"text"},{"text":" ","type":"text"},{"text":"is kept as it is, and bytes that are not valid UTF-8 become U+FFFD.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/path","kind":"symbol","role":"symbol","title":"path","type":"topic","url":"/documentation/nanohttp/nanohttprequest/path"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath":{"abstract":[{"text":"The path of the request as the client sent it, still percent-encoded (","type":"text"},{"code":"/a%20b/%C3%A9","type":"codeVoice"},{"text":"), without the query.","type":"text"},{"text":" ","type":"text"},{"text":"The router matches this, one segment at a time, so that an encoded slash (","type":"text"},{"code":"%2F","type":"codeVoice"},{"text":") stays inside its","type":"text"},{"text":" ","type":"text"},{"text":"segment. Use ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/path","isActive":true,"type":"reference"},{"text":" to read the path; set ","type":"text"},{"code":"rawPath","type":"codeVoice"},{"text":" (for example in middleware) to route the request","type":"text"},{"text":" ","type":"text"},{"text":"to another path.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rawPath"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath","kind":"symbol","role":"symbol","title":"rawPath","type":"topic","url":"/documentation/nanohttp/nanohttprequest/rawpath"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter":{"abstract":[{"text":"Maps methods and paths to handlers. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","isActive":true,"type":"reference"},{"text":" unless","type":"text"},{"text":" ","type":"text"},{"code":"initialRouter()","type":"codeVoice"},{"text":" is overridden. A router has to be safe to use from several threads: routes are","type":"text"},{"text":" ","type":"text"},{"text":"looked up on the threads of the connections, and may be registered while the server is running.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRouter"}],"role":"symbol","title":"NanoHTTPRouter","type":"topic","url":"/documentation/nanohttp/nanohttprouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter":{"abstract":[{"text":"Class ","type":"text"},{"code":"NanoHTTPSegmentRouter","type":"codeVoice"},{"text":" implements the ","type":"text"},{"code":"NanoHTTPRouter","type":"codeVoice"},{"text":" protocol. Routing is based","type":"text"},{"text":" ","type":"text"},{"text":"on path segments that are matched in sequence. There are two differnt types of placeholders","type":"text"},{"text":" ","type":"text"},{"text":"that can be used: ","type":"text"},{"inlineContent":[{"text":"variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" being an anonymous variable) and ","type":"text"},{"inlineContent":[{"text":"path variables","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"(with ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" being an anonymous path variable). A variable matches one full path segment","type":"text"},{"text":" ","type":"text"},{"text":"and its value is being url-decoded: ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/users/7","type":"codeVoice"},{"text":", but not ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a","type":"text"},{"text":" ","type":"text"},{"text":"(potentially empty) sequence of path segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer":{"abstract":[{"text":"An HTTP/1.1 server with routing.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPServer"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPServer"}],"role":"symbol","title":"NanoHTTPServer","type":"topic","url":"/documentation/nanohttp/nanohttpserver"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute":{"abstract":[{"text":"Registers handlers for one HTTP method: ","type":"text"},{"code":"server.get[\"/a\", \"/b\"] = handler","type":"codeVoice"},{"text":" registers ","type":"text"},{"code":"handler","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"GET requests to both paths, ","type":"text"},{"code":"server.get[\"/a\"] = nil","type":"codeVoice"},{"text":" removes the handler of ","type":"text"},{"code":"/a","type":"codeVoice"},{"text":" again.","type":"text"},{"text":" ","type":"text"},{"text":"Reading the subscript always gives ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MethodRoute"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MethodRoute"}],"role":"symbol","title":"NanoHTTPServer.MethodRoute","type":"topic","url":"/documentation/nanohttp/nanohttpserver/methodroute"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/notFoundHandler":{"abstract":[{"text":"The handler for requests that no route matches. Without one, such requests are answered with","type":"text"},{"text":" ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":" and an empty body.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"notFoundHandler"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/notFoundHandler","kind":"symbol","role":"symbol","title":"notFoundHandler","type":"topic","url":"/documentation/nanohttp/nanohttpserver/notfoundhandler"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/routes":{"abstract":[{"text":"The registered route patterns (","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":"), for diagnostics or an index page.","type":"text"},{"text":" ","type":"text"},{"text":"The methods are not part of the result.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"routes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/routes","kind":"symbol","role":"symbol","title":"routes","type":"topic","url":"/documentation/nanohttp/nanohttpserver/routes"},"doc://NanoHTTP/documentation/NanoHTTP/ReadingRequests":{"abstract":[{"text":"Get at the headers, the query, the route variables, forms, uploads and JSON that a client sent.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/ReadingRequests","kind":"article","role":"collectionGroup","title":"Reading Requests","type":"topic","url":"/documentation/nanohttp/readingrequests"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Essentials","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/GettingStarted","doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses","doc://NanoHTTP/documentation/NanoHTTP/ReadingRequests","doc://NanoHTTP/documentation/NanoHTTP/Examples"],"title":"Essentials"}],"topicSections":[{"anchor":"Topics","identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter"]}],"variants":[{"paths":["/documentation/nanohttp/routing"],"traits":[{"interfaceLanguage":"swift"}]}]}