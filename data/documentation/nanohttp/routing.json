{"abstract":[{"text":"Match the method and path of a request to a handler, and capture parts of the path.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/Routing"},"kind":"article","metadata":{"modules":[{"name":"NanoHTTP"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Routing"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Handlers are registered with the method of the request and a ","type":"text"},{"inlineContent":[{"text":"route","type":"text"}],"type":"emphasis"},{"text":": a path pattern.","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.get[\"/about\"] = { _ in .ok(.text(\"About\")) }                       // a fixed path","server.get[\"/users/:id\"] = { request in .ok(.text(request.params[\"id\"] ?? \"\")) }","server.get[\"/files/::path\"] = { request in .ok(.text(request.params[\"path\"] ?? \"\")) }","server.get[\"/a/*/c\"] = { _ in .ok(.text(\"anything in the middle\")) }","server.get[\"/docs/**\"] = { _ in .ok(.text(\"anything below /docs\")) }","server.post[\"/items\"] = { _ in .created() }","server.delete[\"/items/:id\"] = { _ in .ok(.empty) }","server[\"/status\", \"/health\"] = { _ in .ok(.text(\"ok\")) }                  // every method, two paths"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"server.get","type":"codeVoice"},{"text":", ","type":"text"},{"code":"post","type":"codeVoice"},{"text":", ","type":"text"},{"code":"put","type":"codeVoice"},{"text":", ","type":"text"},{"code":"patch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"delete","type":"codeVoice"},{"text":", ","type":"text"},{"code":"head","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"options","type":"codeVoice"},{"text":" register for one method (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/MethodRoute","isActive":true,"type":"reference"},{"text":");","type":"text"},{"text":" ","type":"text"},{"code":"server[...]","type":"codeVoice"},{"text":" registers for every method. A handler for a specific method wins over one for every method.","type":"text"},{"text":" ","type":"text"},{"text":"Assigning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" removes a registration. A HEAD request is answered by a handler registered for HEAD, else by the","type":"text"},{"text":" ","type":"text"},{"text":"handler of a GET route (without the body), else by one for every method. A request with a method that a path does not","type":"text"},{"text":" ","type":"text"},{"text":"have gets ","type":"text"},{"code":"405","type":"codeVoice"},{"text":" and the methods that it has, and ","type":"text"},{"code":"OPTIONS","type":"codeVoice"},{"text":" requests list them, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses","isActive":true,"type":"reference"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"server.options[...]","type":"codeVoice"},{"text":" registers handlers for ","type":"text"},{"code":"OPTIONS","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Patterns","level":3,"text":"Patterns","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"In the route","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Matches","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"about","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"the segment ","type":"text"},{"code":"about","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"code":":id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"exactly one segment","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"request.params[\"id\"]","type":"codeVoice"},{"text":", percent-decoded; ","type":"text"},{"code":"request.rawParams[\"id\"]","type":"codeVoice"},{"text":", as sent","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"::path","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"any number of segments, also none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"request.params[\"path\"]","type":"codeVoice"},{"text":", the percent-decoded segments joined by ","type":"text"},{"code":"/","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"request.rawParams[\"path\"]","type":"codeVoice"},{"text":", the segments as sent, joined by ","type":"text"},{"code":"/","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"*","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"exactly one segment","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"code":"**","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"any number of segments, also none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Paths are split at ","type":"text"},{"code":"/","type":"codeVoice"},{"text":". Empty segments are ignored, so ","type":"text"},{"code":"/a//b/","type":"codeVoice"},{"text":" matches the route ","type":"text"},{"code":"/a/b","type":"codeVoice"},{"text":", and the query","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"?x=1","type":"codeVoice"},{"text":") is not part of the path.","type":"text"}],"type":"paragraph"},{"anchor":"Which-route-wins","level":3,"text":"Which route wins","type":"heading"},{"inlineContent":[{"text":"Fixed segments are tried before variables, and the search backtracks: with the routes ","type":"text"},{"code":"/a/b/c","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"/a/:x/d","type":"codeVoice"},{"text":", the request ","type":"text"},{"code":"/a/b/d","type":"codeVoice"},{"text":" first follows the fixed ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", finds no ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" after it, and then tries the","type":"text"},{"text":" ","type":"text"},{"text":"variable. Two variable routes that could both match the same request (","type":"text"},{"code":"/a/:x","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/a/*","type":"codeVoice"},{"text":") are tried in the order in","type":"text"},{"text":" ","type":"text"},{"text":"which they were registered, the first one that matches wins. Avoid such overlaps all the same: they are hard to read.","type":"text"}],"type":"paragraph"},{"anchor":"Percent-encoding","level":3,"text":"Percent-encoding","type":"heading"},{"inlineContent":[{"text":"The router matches the path as the client sent it (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath","isActive":true,"type":"reference"},{"text":"): the path is split at ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" first, and","type":"text"},{"text":" ","type":"text"},{"text":"then every segment is decoded before it is compared with a fixed segment or becomes the value of a variable. An encoded","type":"text"},{"text":" ","type":"text"},{"text":"slash therefore stays inside its segment:","type":"text"}],"type":"paragraph"},{"code":["GET /users/J%C3%BCrgen%20M     params[\"id\"]   == \"Jürgen M\"","GET /files/a/b%20c.txt         params[\"path\"] == \"a/b c.txt\"","GET /files/a%2Fb               params[\"path\"] == \"a/b\"        (one segment, which contains a slash)","GET /a%2Fb                     does not match the route /a/b  (but does match /:x, with x == \"a/b\")"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"All values are decoded once, also those of path variables: do not decode them again (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/ReadingRequests","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"A segment that is not valid percent-encoding (","type":"text"},{"code":"%zz","type":"codeVoice"},{"text":", or bytes that are no UTF-8) does not match anything.","type":"text"}],"type":"paragraph"},{"anchor":"The-values-as-the-client-sent-them","level":3,"text":"The values as the client sent them","type":"heading"},{"inlineContent":[{"text":"A decoded value cannot tell ","type":"text"},{"code":"a%2Fb/c","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"a/b/c","type":"codeVoice"},{"text":": both are ","type":"text"},{"code":"a/b/c","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawParams","isActive":true,"type":"reference"},{"text":" has the same","type":"text"},{"text":" ","type":"text"},{"text":"variables with their values as the client sent them, still percent-encoded and not decoded at all (a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" stays a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":"):","type":"text"},{"text":" ","type":"text"},{"text":"a variable ","type":"text"},{"code":":name","type":"codeVoice"},{"text":" gets its segment, and a path variable ","type":"text"},{"code":"::name","type":"codeVoice"},{"text":" its segments joined by ","type":"text"},{"code":"/","type":"codeVoice"},{"text":". Use it where the","type":"text"},{"text":" ","type":"text"},{"text":"difference matters, for example to pass a path on to another service in the form that the client sent it.","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.get[\"/files/::path\"] = { request in","  let decoded = request.params[\"path\"] ?? \"\"     // \"a/b/c\" for GET /files/a%2Fb/c","  let raw = request.rawParams[\"path\"] ?? \"\"      // \"a%2Fb/c\"","  return .ok(.text(\"\\(decoded) was sent as \\(raw)\"))","}"],"syntax":"swift","type":"codeListing"},{"code":["GET /users/caf%C3%A9         params[\"id\"]   == \"café\"        rawParams[\"id\"]   == \"caf%C3%A9\"","GET /users/a%2Fb             params[\"id\"]   == \"a/b\"         rawParams[\"id\"]   == \"a%2Fb\"","GET /users/%252e%252e        params[\"id\"]   == \"%2e%2e\"      rawParams[\"id\"]   == \"%252e%252e\"","GET /files/caf%C3%A9/x%20y   params[\"path\"] == \"café/x y\"    rawParams[\"path\"] == \"caf%C3%A9/x%20y\"","GET /files                   params[\"path\"] == \"\"            rawParams[\"path\"] == \"\""],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"The names are those of ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/params","isActive":true,"type":"reference"},{"text":": the anonymous ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" have no entry in either. As there, empty","type":"text"},{"text":" ","type":"text"},{"text":"segments are left out, a path variable that matches no segment has the value ","type":"text"},{"code":"\"\"","type":"codeVoice"},{"text":", and the query is not part of a","type":"text"},{"text":" ","type":"text"},{"text":"value. The raw value is that of the segments that the route matched, also where the search backtracks","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"/files/::path/edit","type":"codeVoice"},{"text":"). Like ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/params","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawParams","isActive":true,"type":"reference"},{"text":" is known in the handler, and in","type":"text"},{"text":" ","type":"text"},{"text":"middleware after ","type":"text"},{"code":"next","type":"codeVoice"},{"text":" has returned; a ","type":"text"},{"code":"HEAD","type":"codeVoice"},{"text":" request answered by the route for ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":" has both.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A raw value is untrusted input, too: decode it at most once, and do not use it as a file path without checking it","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/ReadingRequests","isActive":true,"type":"reference"},{"text":"). A router that does not offer raw values (see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending","isActive":true,"type":"reference"},{"text":") leaves","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawParams","isActive":true,"type":"reference"},{"text":" empty, and so does a request that you create yourself in a test.","type":"text"}],"type":"paragraph"},{"anchor":"A-variable-at-the-end-of-a-route","level":3,"text":"A variable at the end of a route","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":":variable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" needs its segment: with only the route ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":", the request ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":" matches nothing, and is","type":"text"},{"text":" ","type":"text"},{"text":"answered like any other unknown path (","type":"text"},{"code":"404","type":"codeVoice"},{"text":", or the ","type":"text"},{"code":"405","type":"codeVoice"},{"text":" that tells which methods the path has). Only the path variables","type":"text"},{"text":" ","type":"text"},{"code":"::name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" can stand for nothing: ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"params[\"path\"] == \"\"","type":"codeVoice"},{"text":". (In","type":"text"},{"text":" ","type":"text"},{"text":"1.x a variable at the end of a route matched a missing segment too, with the empty string; see ","type":"text"},{"code":"MIGRATION-2.0.md","type":"codeVoice"},{"text":".)","type":"text"}],"type":"paragraph"},{"anchor":"Groups-of-routes","level":3,"text":"Groups of routes","type":"heading"},{"inlineContent":[{"text":"A group of routes can be built on its own and mounted below a prefix. The routes are copied when they are","type":"text"},{"text":" ","type":"text"},{"text":"mounted:","type":"text"}],"type":"paragraph"},{"code":["let api = NanoHTTPSegmentRouter()","api.register(\"GET\", path: \"/items/:id\") { request in","  .ok(.text(\"item \\(request.params[\"id\"] ?? \"\")\"))","}","let server = NanoHTTPServer()","try server.use(\"/api/v1\", router: api)          // GET /api/v1/items/7"],"syntax":"swift","type":"codeListing"},{"anchor":"Unknown-paths","level":3,"text":"Unknown paths","type":"heading"},{"inlineContent":[{"text":"A request that matches no route is passed to ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/notFoundHandler","isActive":true,"type":"reference"},{"text":"; without one the server answers","type":"text"},{"text":" ","type":"text"},{"code":"404 Not Found","type":"codeVoice"},{"text":" with an empty body. A request for a known path with another method is answered the same way,","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"404","type":"codeVoice"},{"text":", not with ","type":"text"},{"code":"405","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.notFoundHandler = { request in","  .notFound(.text(\"There is nothing at \\(request.path)\"))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer/routes","isActive":true,"type":"reference"},{"text":" lists the registered patterns, which is handy for an index page.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/Examples":{"abstract":[{"text":"Six small programs that show how the pieces fit together, and that you can run.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/Examples","kind":"article","role":"article","title":"Examples","type":"topic","url":"/documentation/nanohttp/examples"},"doc://NanoHTTP/documentation/NanoHTTP/GettingStarted":{"abstract":[{"text":"Add NanoHTTP to a project, answer your first request and learn where to go next.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/GettingStarted","kind":"article","role":"article","title":"Getting Started","type":"topic","url":"/documentation/nanohttp/gettingstarted"},"doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses":{"abstract":[{"text":"Answer requests with text, JSON, bytes, redirects or streamed content.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/HandlersAndResponses","kind":"article","role":"collectionGroup","title":"Handlers and Responses","type":"topic","url":"/documentation/nanohttp/handlersandresponses"},"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending":{"abstract":[{"text":"Look at every request before it is routed, and replace parts of the server by subclassing.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/MiddlewareAndExtending","kind":"article","role":"collectionGroup","title":"Middleware and Extending the Server","type":"topic","url":"/documentation/nanohttp/middlewareandextending"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/params":{"abstract":[{"text":"The variables of the route that matched (","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" gives ","type":"text"},{"code":"[\"id\": \"42\"]","type":"codeVoice"},{"text":"); empty","type":"text"},{"text":" ","type":"text"},{"text":"if the route has none. Their values are ","type":"text"},{"inlineContent":[{"text":"decoded","type":"text"}],"type":"strong"},{"text":", also those of path variables","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":"), which are the decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawParams","isActive":true,"type":"reference"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"the values as the client sent them.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"params"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/params","kind":"symbol","role":"symbol","title":"params","type":"topic","url":"/documentation/nanohttp/nanohttprequest/params"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/path":{"abstract":[{"text":"The path of the request, ","type":"text"},{"inlineContent":[{"text":"decoded","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"/a%20b/%C3%A9","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"/a b/é","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" stays a","type":"text"},{"text":" ","type":"text"},{"code":"+","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"%2F","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" that cannot be told from a separator any more (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"can). Text that is not valid percent-encoding is kept as it is, and bytes that are","type":"text"},{"text":" ","type":"text"},{"text":"not valid UTF-8 become U+FFFD.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/path","kind":"symbol","role":"symbol","title":"path","type":"topic","url":"/documentation/nanohttp/nanohttprequest/path"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawParams":{"abstract":[{"text":"The values of ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/params","isActive":true,"type":"reference"},{"text":" as the client sent them, still percent-encoded and ","type":"text"},{"inlineContent":[{"text":"not","type":"text"},{"text":" ","type":"text"},{"text":"decoded","type":"text"}],"type":"strong"},{"text":" (a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" stays a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" as well): ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" with the path ","type":"text"},{"code":"/users/a%2Fb","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"code":"[\"id\": \"a%2Fb\"]","type":"codeVoice"},{"text":" where ","type":"text"},{"code":"params","type":"codeVoice"},{"text":" has ","type":"text"},{"code":"[\"id\": \"a/b\"]","type":"codeVoice"},{"text":". A variable (","type":"text"},{"code":":name","type":"codeVoice"},{"text":") has its","type":"text"},{"text":" ","type":"text"},{"text":"segment, and a path variable (","type":"text"},{"code":"::name","type":"codeVoice"},{"text":") its segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"/files/caf%C3%A9/x%20y","type":"codeVoice"},{"text":" gives ","type":"text"},{"code":"caf%C3%A9/x%20y","type":"codeVoice"},{"text":"), so an encoded slash can be told","type":"text"},{"text":" ","type":"text"},{"text":"from a separator. The names are those of ","type":"text"},{"code":"params","type":"codeVoice"},{"text":": the anonymous ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" have no","type":"text"},{"text":" ","type":"text"},{"text":"entry. As in ","type":"text"},{"code":"params","type":"codeVoice"},{"text":", empty segments are left out, a path variable that matches no","type":"text"},{"text":" ","type":"text"},{"text":"segment has the value ","type":"text"},{"code":"\"\"","type":"codeVoice"},{"text":", and the query is not part of a value.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rawParams"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawParams","kind":"symbol","role":"symbol","title":"rawParams","type":"topic","url":"/documentation/nanohttp/nanohttprequest/rawparams"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath":{"abstract":[{"text":"The path of the request as the client sent it, still percent-encoded (","type":"text"},{"code":"/a%20b/%C3%A9","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"without the query. The router matches this, one segment at a time, so that an","type":"text"},{"text":" ","type":"text"},{"text":"encoded slash (","type":"text"},{"code":"%2F","type":"codeVoice"},{"text":") stays inside its segment. Use ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/path","isActive":true,"type":"reference"},{"text":" to read the path; set","type":"text"},{"text":" ","type":"text"},{"code":"rawPath","type":"codeVoice"},{"text":" (for example in middleware) to route the request to another path.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rawPath"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRequest/rawPath","kind":"symbol","role":"symbol","title":"rawPath","type":"topic","url":"/documentation/nanohttp/nanohttprequest/rawpath"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter":{"abstract":[{"text":"Maps methods and paths to handlers. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServer","isActive":true,"type":"reference"},{"text":" uses a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"unless ","type":"text"},{"code":"initialRouter()","type":"codeVoice"},{"text":" is overridden. A router has to be safe to use from several","type":"text"},{"text":" ","type":"text"},{"text":"threads: routes are looked up on the threads of the connections, and may be registered","type":"text"},{"text":" ","type":"text"},{"text":"while the server is running.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPRouter"}],"role":"symbol","title":"NanoHTTPRouter","type":"topic","url":"/documentation/nanohttp/nanohttprouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter":{"abstract":[{"text":"Class ","type":"text"},{"code":"NanoHTTPSegmentRouter","type":"codeVoice"},{"text":" implements the ","type":"text"},{"code":"NanoHTTPRouter","type":"codeVoice"},{"text":" protocol. Routing is","type":"text"},{"text":" ","type":"text"},{"text":"based on path segments that are matched in sequence. There are two differnt types of","type":"text"},{"text":" ","type":"text"},{"text":"placeholders that can be used: ","type":"text"},{"inlineContent":[{"text":"variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" being an anonymous variable) and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"path variables","type":"text"}],"type":"emphasis"},{"text":" (with ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" being an anonymous path variable). A variable matches one","type":"text"},{"text":" ","type":"text"},{"text":"full path segment and its value is being url-decoded: ","type":"text"},{"code":"/users/:id","type":"codeVoice"},{"text":" answers ","type":"text"},{"code":"/users/7","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"but not ","type":"text"},{"code":"/users","type":"codeVoice"},{"text":". A path variable matches a (potentially empty) sequence of path","type":"text"},{"text":" ","type":"text"},{"text":"segments and its value is the url-decoded segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":": ","type":"text"},{"code":"/files/::path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"/files/a/b","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"/files","type":"codeVoice"},{"text":". The values are also available as the client sent","type":"text"},{"text":" ","type":"text"},{"text":"them, still percent-encoded (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/routeWithRawParams(_:path:)","isActive":true,"type":"reference"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPSegmentRouter"}],"role":"symbol","title":"NanoHTTPSegmentRouter","type":"topic","url":"/documentation/nanohttp/nanohttpsegmentrouter"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/routeWithRawParams(_:path:)":{"abstract":[{"text":"Finds the handler for a request like ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/route(_:path:)","isActive":true,"type":"reference"},{"text":" does, and returns the variables","type":"text"},{"text":" ","type":"text"},{"text":"of the route twice: as ","type":"text"},{"code":"params","type":"codeVoice"},{"text":" (decoded) and as ","type":"text"},{"code":"rawParams","type":"codeVoice"},{"text":", the values as the client","type":"text"},{"text":" ","type":"text"},{"text":"sent them, still percent-encoded (","type":"text"},{"code":"a%2Fb","type":"codeVoice"},{"text":", not ","type":"text"},{"code":"a/b","type":"codeVoice"},{"text":"; a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" stays a ","type":"text"},{"code":"+","type":"codeVoice"},{"text":"). A variable","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":":name","type":"codeVoice"},{"text":") has its raw segment as its raw value, and a path variable (","type":"text"},{"code":"::name","type":"codeVoice"},{"text":") its raw","type":"text"},{"text":" ","type":"text"},{"text":"segments joined with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":"; empty segments are left out, a path variable that matches no","type":"text"},{"text":" ","type":"text"},{"text":"segment has ","type":"text"},{"code":"\"\"","type":"codeVoice"},{"text":", and the query is not part of a value. Both have the same names: the","type":"text"},{"text":" ","type":"text"},{"text":"anonymous ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" have no entry in either. They are taken from the same segments,","type":"text"},{"text":" ","type":"text"},{"text":"also where the search backtracks (","type":"text"},{"code":"/files/::path/edit","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"routeWithRawParams"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> (params"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], rawParams"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], handler"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"},{"kind":"text","text":")?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPSegmentRouter/routeWithRawParams(_:path:)","kind":"symbol","role":"symbol