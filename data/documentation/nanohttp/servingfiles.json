{"abstract":[{"text":"Share a file, a directory, or a browsable listing.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/ServingFiles"},"kind":"article","metadata":{"modules":[{"name":"NanoHTTP"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Serving Files"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Three handler factories serve files from disk:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","let directory = NSHomeDirectory() + \"/Public\"","server[\"/logo\"] = NanoFiles.share(file: directory + \"/logo.png\")","server[\"/static/::path\"] = NanoFiles.share(directory: directory)","server[\"/browse/::path\"] = NanoFiles.browse(directory: directory)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(file:)","isActive":true,"type":"reference"},{"text":" serves one file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(directory:defaults:followSymlinks:)","isActive":true,"type":"reference"},{"text":" serves the files below a directory. The route must end in a","type":"text"},{"text":" ","type":"text"},{"text":"path variable (","type":"text"},{"code":"::path","type":"codeVoice"},{"text":"): its value selects the file. A request for a directory is redirected to the same","type":"text"},{"text":" ","type":"text"},{"text":"address with a ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" at the end (so that the relative links of its pages work: ","type":"text"},{"code":"301","type":"codeVoice"},{"text":", the query is kept); with the ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"it serves the first existing file of ","type":"text"},{"code":"defaults","type":"codeVoice"},{"text":" (","type":"text"},{"code":"index.html","type":"codeVoice"},{"text":", ","type":"text"},{"code":"default.html","type":"codeVoice"},{"text":") in the directory, or answers ","type":"text"},{"code":"404","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/browse(directory:followSymlinks:)","isActive":true,"type":"reference"},{"text":" is like it, but answers requests for a directory with an HTML list of","type":"text"},{"text":" ","type":"text"},{"text":"links (without the entries ","type":"text"},{"code":".","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"..","type":"codeVoice"},{"text":"). Everything in the directory is listed, hidden files included.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" comes from the extension of the file (","type":"text"},{"code":".html","type":"codeVoice"},{"text":" gives ","type":"text"},{"code":"text/html","type":"codeVoice"},{"text":", an unknown extension gives","type":"text"},{"text":" ","type":"text"},{"code":"application/octet-stream","type":"codeVoice"},{"text":"), and ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" is the size of the file, so that the connection can be used for the","type":"text"},{"text":" ","type":"text"},{"text":"next request. A missing file is answered with ","type":"text"},{"code":"404","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Validators-conditional-requests-and-ranges","level":3,"text":"Validators, conditional requests and ranges","type":"heading"},{"inlineContent":[{"text":"Every file is sent with an ","type":"text"},{"code":"ETag","type":"codeVoice"},{"text":" (it changes when the file is replaced or modified, also without a change of its","type":"text"},{"text":" ","type":"text"},{"text":"size) and ","type":"text"},{"code":"Last-Modified","type":"codeVoice"},{"text":". A client that has a copy asks whether it is good with ","type":"text"},{"code":"If-None-Match","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"If-Modified-Since","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and gets ","type":"text"},{"code":"304 Not Modified","type":"codeVoice"},{"text":", without the body, if it is: pages that are reloaded cost the headers only.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A client can ask for a part of a file with a ","type":"text"},{"code":"Range","type":"codeVoice"},{"text":" header (","type":"text"},{"code":"bytes=0-1023","type":"codeVoice"},{"text":", ","type":"text"},{"code":"bytes=1024-","type":"codeVoice"},{"text":", ","type":"text"},{"code":"bytes=-500","type":"codeVoice"},{"text":"), which is","type":"text"},{"text":" ","type":"text"},{"text":"what video players, download managers and clients that resume a download do. The answer is ","type":"text"},{"code":"206 Partial Content","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"Content-Range","type":"codeVoice"},{"text":" header and the bytes, or ","type":"text"},{"code":"416 Range Not Satisfiable","type":"codeVoice"},{"text":" if the file has nothing there (with","type":"text"},{"text":" ","type":"text"},{"code":"Content-Range: bytes */size","type":"codeVoice"},{"text":"). ","type":"text"},{"code":"If-Range","type":"codeVoice"},{"text":" makes the range depend on the file being the version that the client has","type":"text"},{"text":" ","type":"text"},{"text":"(otherwise the whole file is sent). Only one range per request is served; a header with several ranges, or one that is","type":"text"},{"text":" ","type":"text"},{"text":"not understood, is ignored, which the protocol allows (the whole file is sent). The parts are sent without the","type":"text"},{"text":" ","type":"text"},{"text":"bytes passing through the process, where the system has ","type":"text"},{"code":"sendfile","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"HEAD","type":"codeVoice"},{"text":" requests get the headers of these responses, including ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":", without a body.","type":"text"}],"type":"paragraph"},{"anchor":"Files-are-only-served-from-inside-the-directory","level":3,"text":"Files are only served from inside the directory","type":"heading"},{"inlineContent":[{"text":"The part of the path that selects the file is the value of the route’s path variable. The router has percent-decoded it","type":"text"},{"text":" ","type":"text"},{"text":"once (","type":"text"},{"code":"a%20b.txt","type":"codeVoice"},{"text":" is the file ","type":"text"},{"code":"a b.txt","type":"codeVoice"},{"text":"); the handlers do not decode it again, so ","type":"text"},{"code":"%252e%252e","type":"codeVoice"},{"text":" is a file that is called","type":"text"},{"text":" ","type":"text"},{"code":"%2e%2e","type":"codeVoice"},{"text":", and not a way to ","type":"text"},{"code":"..","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Requests that try to reach beyond the directory are answered with ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":": paths with ","type":"text"},{"code":"..","type":"codeVoice"},{"text":" segments","type":"text"},{"text":" ","type":"text"},{"text":"(also percent-encoded, as ","type":"text"},{"code":"%2e%2e","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"..%2f","type":"codeVoice"},{"text":"), paths with a NUL character, and paths that lead out of the","type":"text"},{"text":" ","type":"text"},{"text":"directory through a symbolic link. Symbolic links that stay inside the directory are followed, and so is a shared","type":"text"},{"text":" ","type":"text"},{"text":"directory that is itself a symbolic link.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you really want links that lead outside to be served, opt in:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server[\"/static/::path\"] = NanoFiles.share(directory: \"/var/www\", followSymlinks: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Only do this if everyone who can create files in the directory is trusted: a link in it can expose any file that","type":"text"},{"text":" ","type":"text"},{"text":"the process can read. ","type":"text"},{"code":"..","type":"codeVoice"},{"text":" and NUL characters in the request are refused in either case.","type":"text"}],"type":"paragraph"},{"anchor":"Limits","level":3,"text":"Limits","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Files are streamed from disk, so their size does not matter for the memory of the server. The connection is","type":"text"},{"text":" ","type":"text"},{"text":"closed after each file response, which is cheap for single files and slow for pages with many assets.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Requests for a byte range (","type":"text"},{"code":"Range","type":"codeVoice"},{"text":"), conditional requests (","type":"text"},{"code":"If-Modified-Since","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ETag","type":"codeVoice"},{"text":") and compression are not","type":"text"},{"text":" ","type":"text"},{"text":"supported: the whole file is always sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A request for a directory that is not the route itself (","type":"text"},{"code":"/static/sub","type":"codeVoice"},{"text":") opens the directory like a file and","type":"text"},{"text":" ","type":"text"},{"text":"produces an empty answer. Link to files, or use ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/browse(directory:followSymlinks:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoFile":{"abstract":[{"text":"An open file, for the content of a response (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter","isActive":true,"type":"reference"},{"text":" sends it).","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoFile"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFile","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoFile"}],"role":"symbol","title":"NanoFile","type":"topic","url":"/documentation/nanohttp/nanofile"},"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles":{"abstract":[{"text":"The functions that serve files: single files, directories and listings of directories.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoFiles"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoFiles"}],"role":"symbol","title":"NanoFiles","type":"topic","url":"/documentation/nanohttp/nanofiles"},"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/browse(directory:followSymlinks:)":{"abstract":[{"text":"Returns a handler that lists the directories and serves the files below a directory.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"browse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"followSymlinks"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/browse(directory:followSymlinks:)","kind":"symbol","role":"symbol","title":"browse(directory:followSymlinks:)","type":"topic","url":"/documentation/nanohttp/nanofiles/browse(directory:followsymlinks:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(directory:defaults:followSymlinks:)":{"abstract":[{"text":"Returns a handler that serves the files of a directory.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"share"},{"kind":"text","text":"("},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"defaults"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"followSymlinks"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(directory:defaults:followSymlinks:)","kind":"symbol","role":"symbol","title":"share(directory:defaults:followSymlinks:)","type":"topic","url":"/documentation/nanohttp/nanofiles/share(directory:defaults:followsymlinks:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(file:)":{"abstract":[{"text":"Returns a handler that serves one file.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"share"},{"kind":"text","text":"("},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A18HTTPRequestHandlera","text":"NanoHTTPRequestHandler"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(file:)","kind":"symbol","role":"symbol","title":"share(file:)","type":"topic","url":"/documentation/nanohttp/nanofiles/share(file:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter":{"abstract":[{"text":"Receives the body of a response while a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/Body-swift.enum/custom(_:contentType:)","isActive":true,"type":"reference"},{"text":" function","type":"text"},{"text":" ","type":"text"},{"text":"produces it. The writer is the connection: whatever is written is sent to the client at once, so the","type":"text"},{"text":" ","type":"text"},{"text":"function can stream content of any size.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponseBodyWriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPResponseBodyWriter"}],"role":"symbol","title":"NanoHTTPResponseBodyWriter","type":"topic","url":"/documentation/nanohttp/nanohttpresponsebodywriter"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Files","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoFiles","doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(file:)","doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(directory:defaults:followSymlinks:)","doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/browse(directory:followSymlinks:)","doc://NanoHTTP/documentation/NanoHTTP/NanoFile"],"title":"Files"}],"topicSections":[{"anchor":"Topics","identifiers":["doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(file:)","doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/share(directory:defaults:followSymlinks:)","doc://NanoHTTP/documentation/NanoHTTP/NanoFiles/browse(directory:followSymlinks:)"]}],"variants":[{"paths":["/documentation/nanohttp/servingfiles"],"traits":[{"interfaceLanguage":"swift"}]}]}