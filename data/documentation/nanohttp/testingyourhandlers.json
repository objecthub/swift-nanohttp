{"abstract":[{"text":"Test a handler on its own, or the whole server over a real connection.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/TestingYourHandlers"},"kind":"article","metadata":{"modules":[{"name":"NanoHTTP"}],"role":"article","roleHeading":"Article","title":"Testing Your Handlers"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"anchor":"Call-the-handler-directly","level":3,"text":"Call the handler directly","type":"heading"},{"inlineContent":[{"text":"A handler is a function. Create a request and call it:","type":"text"}],"type":"paragraph"},{"code":["let handler: NanoHTTPRequestHandler = { request in","  .ok(.text(\"Hello, \\(request.params[\"name\"] ?? \"stranger\")!\"))","}","let request = NanoHTTPRequest(method: \"GET\", path: \"/hello/Ada\")","request.params = [\"name\": \"Ada\"]                         // what the router would have set (decoded)","let response = try handler(request)","assert(response.statusCode == 200)","if case .text(let text) = response.body {","  assert(text == \"Hello, Ada!\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A handler that throws a ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","isActive":true,"type":"reference"},{"text":" is tested by catching it; the server turns it into a response, which","type":"text"},{"text":" ","type":"text"},{"text":"a test of a running server sees as a status code:","type":"text"}],"type":"paragraph"},{"code":["let handler: NanoHTTPRequestHandler = { request in","  guard request.params[\"id\"] != nil else {","    throw NanoHTTPError.badRequest(\"No id\")","  }","  return .ok(.text(\"fine\"))","}","do {","  _ = try handler(NanoHTTPRequest(method: \"GET\", path: \"/items\"))","} catch let error as NanoHTTPError {","  assert(error.status == 400)","  assert(error.response.statusCode == 400)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This is fast and needs no network. It does not test routing, headers that the server adds, or limits.","type":"text"}],"type":"paragraph"},{"anchor":"Run-a-server-on-a-free-port","level":3,"text":"Run a server on a free port","type":"heading"},{"inlineContent":[{"text":"To test everything, start a server on port ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (the system chooses a free port). A server listens on the loopback","type":"text"},{"text":" ","type":"text"},{"text":"address only unless you configure it otherwise, so tests neither collide with each other nor open your machine to the","type":"text"},{"text":" ","type":"text"},{"text":"network:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.get[\"/ping\"] = { _ in .ok(.text(\"pong\")) }","try server.start(0)","defer { server.stop() }","let url = URL(string: \"http://127.0.0.1:\\(try server.port())/ping\")!","let (data, response) = try await URLSession.shared.data(from: url)","assert((response as? HTTPURLResponse)?.statusCode == 200)","assert(String(decoding: data, as: UTF8.self) == \"pong\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Start a new server for each test and stop it at the end (","type":"text"},{"code":"tearDown","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"defer","type":"codeVoice"},{"text":"). A stopped server releases its port.","type":"text"}],"type":"paragraph"},{"anchor":"Tips","level":3,"text":"Tips","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"URLSession","type":"codeVoice"},{"text":" cleans up what it sends (it resolves ","type":"text"},{"code":"..","type":"codeVoice"},{"text":" in paths, retries failed requests and adds headers). To test","type":"text"},{"text":" ","type":"text"},{"text":"how the server reacts to odd or hostile requests, send the bytes yourself with a socket. The tests of NanoHTTP do","type":"text"},{"text":" ","type":"text"},{"text":"this with a small client (","type":"text"},{"code":"RawClient","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Tests/NanoHTTPTests/Support","type":"codeVoice"},{"text":"), which you can copy.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Handlers run on other threads than the test. Collect results in thread-safe variables, and wait for them with an","type":"text"},{"text":" ","type":"text"},{"code":"XCTestExpectation","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Set ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits","isActive":true,"type":"reference"},{"text":" to small values to test how your handlers cope with the answers ","type":"text"},{"code":"413","type":"codeVoice"},{"text":", ","type":"text"},{"code":"414","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"431","type":"codeVoice"},{"text":" of the server.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError":{"abstract":[{"text":"An error that a handler throws to answer a request with an error status code.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NanoHTTPError"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NanoHTTPError"}],"role":"symbol","title":"NanoHTTPError","type":"topic","url":"/documentation/nanohttp/nanohttperror"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits":{"abstract":[{"text":"The largest requests the server accepts. A request that exceeds a limit is answered with","type":"text"},{"text":" ","type":"text"},{"code":"413","type":"codeVoice"},{"text":", ","type":"text"},{"code":"414","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"431","type":"codeVoice"},{"text":" and the connection is closed.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"limits"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPParserV","text":"NanoHTTPParser"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A10HTTPParserV6LimitsV","text":"Limits"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/limits","kind":"symbol","role":"symbol","title":"limits","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/limits"},"doc://NanoHTTP/documentation/NanoHTTP/UsingNanoHTTPOnIOS":{"abstract":[{"text":"Run a server inside an app, and let other devices find it.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/UsingNanoHTTPOnIOS","kind":"article","role":"article","title":"Using NanoHTTP on iOS","type":"topic","url":"/documentation/nanohttp/usingnanohttponios"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Platforms-and-testing","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/UsingNanoHTTPOnIOS"],"title":"Platforms and testing"}],"variants":[{"paths":["/documentation/nanohttp/testingyourhandlers"],"traits":[{"interfaceLanguage":"swift"}]}]}