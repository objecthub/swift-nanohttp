{"abstract":[{"text":"Run a server inside an app, and let other devices find it.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/UsingNanoHTTPOnIOS"},"kind":"article","metadata":{"modules":[{"name":"NanoHTTP"}],"role":"article","roleHeading":"Article","title":"Using NanoHTTP on iOS"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A server inside an iOS or tvOS app works like a server in a command-line tool, with the following differences.","type":"text"}],"type":"paragraph"},{"anchor":"Starting-and-stopping-with-the-app","level":3,"text":"Starting and stopping with the app","type":"heading"},{"inlineContent":[{"text":"An app that goes to the background is suspended soon after, and a suspended app does not serve requests. Start the","type":"text"},{"text":" ","type":"text"},{"text":"server when the app becomes active and stop it when it resigns, or tell the user that the server is only available","type":"text"},{"text":" ","type":"text"},{"text":"while the app is on screen:","type":"text"}],"type":"paragraph"},{"code":["// file scope","final class ExampleServerController {","  let server = NanoHTTPServer()","","  init() {","    server.get[\"/hello\"] = { _ in .ok(.text(\"Hello from the app\")) }","  }","","  func appDidBecomeActive() {","    try? server.start(8080)","  }","","  func appWillResignActive() {","    server.stop()","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" does nothing if the server is already running,","type":"text"},{"text":" ","type":"text"},{"text":"and a stopped server can be started again, so both calls are safe to repeat.","type":"text"}],"type":"paragraph"},{"anchor":"Finding-the-address","level":3,"text":"Finding the address","type":"heading"},{"inlineContent":[{"code":"NanoNetworkInterface.localIP","type":"codeVoice"},{"text":" is the address of the device on the local network, to show to the user (for example as","type":"text"},{"text":" ","type":"text"},{"code":"http://192.168.1.20:8080","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.configuration.listenAddress = .allInterfaces   // the default, loopback, cannot be reached by other devices","try server.start(8080)","if let address = NanoNetworkInterface.localIP {","  print(\"Open http://\\(address):\\(try server.port()) on another device\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoNetworkInterface/available()","isActive":true,"type":"reference"},{"text":" lists all addresses of the interfaces that are up.","type":"text"}],"type":"paragraph"},{"anchor":"Permissions","level":3,"text":"Permissions","type":"heading"},{"inlineContent":[{"text":"Since iOS 14 the system asks the user for permission before an app uses the local network. Add a short explanation","type":"text"},{"text":" ","type":"text"},{"text":"under the key ","type":"text"},{"code":"NSLocalNetworkUsageDescription","type":"codeVoice"},{"text":" to the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" of the app. If other devices cannot reach the","type":"text"},{"text":" ","type":"text"},{"text":"app’s server, look at the setting of the app in Settings > Privacy > Local Network.","type":"text"}],"type":"paragraph"},{"anchor":"Reaching-the-server-from-the-same-app","level":3,"text":"Reaching the server from the same app","type":"heading"},{"inlineContent":[{"text":"App Transport Security applies to the requests that an app makes with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":", also to its own server, unless","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" allows local networking (","type":"text"},{"code":"NSAppTransportSecurity","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"NSAllowsLocalNetworking","type":"codeVoice"},{"text":"). For a web view","type":"text"},{"text":" ","type":"text"},{"text":"that shows pages of the app’s server, the same applies.","type":"text"}],"type":"paragraph"},{"anchor":"The-demo-app","level":3,"text":"The demo app","type":"heading"},{"inlineContent":[{"text":"The Xcode project of the repository contains an iOS app (","type":"text"},{"code":"DemoServer iOS","type":"codeVoice"},{"text":") that runs the demo server and shows its","type":"text"},{"text":" ","type":"text"},{"text":"log.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/threading-swift.property":{"abstract":[{"text":"Which threads run the server, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum","isActive":true,"type":"reference"},{"text":". The default is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/perConnection","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"threading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPServerIOC13ConfigurationV9ThreadingO","text":"Threading"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/threading-swift.property","kind":"symbol","role":"symbol","title":"threading","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.property"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)":{"abstract":[{"text":"Starts to accept connections at ","type":"text"},{"code":"port","type":"codeVoice"},{"text":" (","type":"text"},{"code":"0","type":"codeVoice"},{"text":" picks a free port, see ","type":"text"},{"code":"port()","type":"codeVoice"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"returns: the connections are accepted and served on threads of the server (see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/threading-swift.property","isActive":true,"type":"reference"},{"text":"). Does nothing if the server is already running or is","type":"text"},{"text":" ","type":"text"},{"text":"being started or stopped by another thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","kind":"symbol","role":"symbol","title":"start(_:)","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/start(_:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoNetworkInterface/available()":{"abstract":[{"text":"All addresses of the interfaces that are up and running, except loopback.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"available"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A16NetworkInterfaceV","text":"NanoNetworkInterface"},{"kind":"text","text":">"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoNetworkInterface/available()","kind":"symbol","role":"symbol","title":"available()","type":"topic","url":"/documentation/nanohttp/nanonetworkinterface/available()"},"doc://NanoHTTP/documentation/NanoHTTP/TestingYourHandlers":{"abstract":[{"text":"Test a handler on its own, or the whole server over a real connection.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/TestingYourHandlers","kind":"article","role":"article","title":"Testing Your Handlers","type":"topic","url":"/documentation/nanohttp/testingyourhandlers"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Platforms-and-testing","generated":true,"identifiers":["doc://NanoHTTP/documentation/NanoHTTP/TestingYourHandlers"],"title":"Platforms and testing"}],"variants":[{"paths":["/documentation/nanohttp/usingnanohttponios"],"traits":[{"interfaceLanguage":"swift"}]}]}