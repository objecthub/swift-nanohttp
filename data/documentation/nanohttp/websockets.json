{"abstract":[{"text":"Exchange messages with browsers and apps over a connection that stays open.","type":"text"}],"hierarchy":{"paths":[["doc://NanoHTTP/documentation/NanoHTTP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://NanoHTTP/documentation/NanoHTTP/WebSockets"},"kind":"article","metadata":{"modules":[{"name":"NanoHTTP"}],"role":"collectionGroup","roleHeading":"API Collection","title":"WebSockets"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket/handler(text:binary:pong:connected:disconnected:maxMessageSize:origins:protocols:hub:)","isActive":true,"type":"reference"},{"text":" creates a handler that upgrades a request","type":"text"},{"text":" ","type":"text"},{"text":"to a WebSocket connection (RFC 6455) and calls closures for what happens on it. Register it like any other handler:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server[\"/echo\"] = NanoWebSocket.handler(","  text: { session, text in session.writeText(text) },","  binary: { session, bytes in session.writeBinary(bytes) })"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each closure receives the ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession","isActive":true,"type":"reference"},{"text":" of the connection. A session sends text with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession/writeText(_:)","isActive":true,"type":"reference"},{"text":" and binary data with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession/writeBinary(_:)-7drjz","isActive":true,"type":"reference"},{"text":". Pings are answered","type":"text"},{"text":" ","type":"text"},{"text":"automatically; the ","type":"text"},{"code":"pong","type":"codeVoice"},{"text":" closure sees the pongs that the client sends.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"From a page, the server of the example is reached with:","type":"text"}],"type":"paragraph"},{"code":["const socket = new WebSocket(\"ws://localhost:8080/echo\");","socket.onmessage = event => console.log(event.data);","socket.onopen = () => socket.send(\"hello\");"],"syntax":"javascript","type":"codeListing"},{"anchor":"Threads","level":3,"text":"Threads","type":"heading"},{"inlineContent":[{"text":"Every connection runs on a thread of its own, and the closures of one connection are called one after another, on","type":"text"},{"text":" ","type":"text"},{"text":"that thread. A closure that blocks delays the messages of its own connection only.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sessions may be written from ","type":"text"},{"inlineContent":[{"text":"any thread","type":"text"}],"type":"strong"},{"text":" at any time: concurrent writes are serialized, so frames never","type":"text"},{"text":" ","type":"text"},{"text":"interleave.","type":"text"}],"type":"paragraph"},{"anchor":"Sending-to-many-sessions-the-hub","level":3,"text":"Sending to many sessions: the hub","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","isActive":true,"type":"reference"},{"text":" keeps the sessions that belong together, a chat for example, and sends a message to all of them.","type":"text"},{"text":" ","type":"text"},{"text":"Give it to the handler: the sessions join when they are connected and leave when their connections have ended.","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","let chat = NanoWebSocketHub()","server[\"/chat\"] = NanoWebSocket.handler(","  text: { session, message in chat.broadcast(text: message, except: session) },   // to everybody else","  hub: chat)","server.post[\"/announce\"] = { request in","  chat.broadcast(text: request.bodyString ?? \"\")      // an HTTP handler can send to the sessions, too","  return .ok(.text(\"sent to \\(chat.count) clients\"))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The hub is thread-safe: use it from the closures, from handlers and from any thread, without a lock of your own.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub/sessions","isActive":true,"type":"reference"},{"text":" is the list of the sessions at this moment, and ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub/broadcast(binary:except:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"sends binary messages. A hub writes to the sessions one after the other. A client that stops reading would hold up the","type":"text"},{"text":" ","type":"text"},{"text":"ones behind it, so a write that makes no progress for ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","isActive":true,"type":"reference"},{"text":" (5 seconds","type":"text"},{"text":" ","type":"text"},{"text":"by default) ends that session: its connection is closed, and it leaves the hub. If you need something that the hub does not","type":"text"},{"text":" ","type":"text"},{"text":"offer (rooms, users), keep your own collections: sessions are ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", and a session that has ended must be removed","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"disconnected","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Writing to a session whose connection has ended does nothing harmful (the first failed write is logged at the level","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoLogLevel/info","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"anchor":"On-a-server-with-one-thread","level":3,"text":"On a server with one thread","type":"heading"},{"inlineContent":[{"text":"A server that runs on one thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":") serves WebSockets on that","type":"text"},{"text":" ","type":"text"},{"text":"thread as well: it waits for all sockets together, and handles the messages of the sessions one at a time between the","type":"text"},{"text":" ","type":"text"},{"text":"requests of the other connections. A session does not hold the thread while it waits for the next message. The","type":"text"},{"text":" ","type":"text"},{"text":"closures of all sessions, the handlers and the middleware therefore never run at the same time, so the code above","type":"text"},{"text":" ","type":"text"},{"text":"works unchanged, and a collection of your own needs ","type":"text"},{"inlineContent":[{"text":"no lock","type":"text"}],"type":"strong"},{"text":", also when HTTP handlers write to the sessions:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server.configuration.threading = .singleThread","var sessions = [NanoWebSocketSession]()           // used by all closures and handlers: they all run on one thread","server[\"/chat\"] = NanoWebSocket.handler(","  text: { _, message in sessions.forEach { $0.writeText(message) } },","  connected: { session in sessions.append(session) },","  disconnected: { session in sessions.removeAll { $0 === session } })","server.post[\"/announce\"] = { request in","  let message = String(decoding: request.body, as: UTF8.self)","  sessions.forEach { $0.writeText(message) }","  return .ok(.text(\"sent to \\(sessions.count) clients\"))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"What the one thread cannot do is more than one thing at a time: a closure that takes a second delays all other","type":"text"},{"text":" ","type":"text"},{"text":"messages and requests by a second, and a client that sends the beginning of a message and then stops delays the server","type":"text"},{"text":" ","type":"text"},{"text":"until the ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/readTimeout","isActive":true,"type":"reference"},{"text":" has passed, after which its session is closed. The same is true","type":"text"},{"text":" ","type":"text"},{"text":"for a client that does not read what is sent to it, for ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","isActive":true,"type":"reference"},{"text":". Sessions","type":"text"},{"text":" ","type":"text"},{"text":"are not subject to the idle timeout, but they count towards ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Messages-and-limits","level":3,"text":"Messages and limits","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Messages may arrive in several frames; the closures receive complete messages. Text must be valid UTF-8.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A message (or a single frame) larger than ","type":"text"},{"code":"maxMessageSize","type":"codeVoice"},{"text":" (16 MiB unless you pass another value) ends the","type":"text"},{"text":" ","type":"text"},{"text":"connection with close code 1009.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Violations of the protocol (unmasked frames, unknown operation codes, control frames above 125 bytes, invalid","type":"text"},{"text":" ","type":"text"},{"text":"close codes) end it with 1002; text that is not UTF-8 with 1007. When the client closes, the server answers with the","type":"text"},{"text":" ","type":"text"},{"text":"code of the client.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The handshake must be a ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":" request with ","type":"text"},{"code":"Sec-WebSocket-Version: 13","type":"codeVoice"},{"text":"; other versions get ","type":"text"},{"code":"426 Upgrade Required","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Extensions (compression) are not negotiated; subprotocols are, see below.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A write that fails ends the session, because a frame that was written in part would make the client misread all that","type":"text"},{"text":" ","type":"text"},{"text":"follows.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Subprotocols","level":3,"text":"Subprotocols","type":"heading"},{"inlineContent":[{"text":"A page can say which protocols it speaks on top of WebSocket: ","type":"text"},{"code":"new WebSocket(url, [\"chat.v2\", \"chat.v1\"])","type":"codeVoice"},{"text":". Give the handler","type":"text"},{"text":" ","type":"text"},{"text":"the ones that it speaks, in the order that it prefers them:","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server[\"/chat\"] = NanoWebSocket.handler(","  connected: { session in","    // session.subprotocol is \"chat.v2\" or \"chat.v1\"","  },","  protocols: [\"chat.v2\", \"chat.v1\"])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The handler answers with the first of its protocols that the client offers. A client that offers protocols of which the","type":"text"},{"text":" ","type":"text"},{"text":"handler knows none is refused with ","type":"text"},{"code":"400 Bad Request","type":"codeVoice"},{"text":" (a browser would not accept an answer without a protocol anyway), and","type":"text"},{"text":" ","type":"text"},{"text":"a client that offers none is accepted without a protocol: ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketSession/subprotocol","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Without ","type":"text"},{"code":"protocols","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the handler ignores what the client offers. The names are compared as they are written, upper and lower case differ.","type":"text"}],"type":"paragraph"},{"anchor":"Security","level":3,"text":"Security","type":"heading"},{"inlineContent":[{"text":"A web page in any browser tab can open a WebSocket to a server that is reachable from the browser, including one on the","type":"text"},{"text":" ","type":"text"},{"text":"user’s own machine or network, and use it with the privileges of the user. By default the handshake does not look at the","type":"text"},{"text":" ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" header, which a browser sends with it. Servers that are not meant for such pages switch on the origin check:","type":"text"},{"text":" ","type":"text"},{"code":"server.configuration.originPolicy = .sameOrigin","type":"codeVoice"},{"text":" refuses handshakes of pages of other sites (and lists the origins that","type":"text"},{"text":" ","type":"text"},{"text":"are allowed with ","type":"text"},{"code":".origins([...])","type":"codeVoice"},{"text":"), for every route; see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/SecurityAndLimits","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To protect one WebSocket on a server whose other routes are open to other sites, give its handler the ","type":"text"},{"code":"origins","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let server = NanoHTTPServer()","server[\"/chat\"] = NanoWebSocket.handler(","  text: { session, message in session.writeText(message) },","  origins: .origins([\"https://app.example\"]))       // pages of the server itself, and of this site"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A handshake from a page of another site is answered with ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":". Clients that are no browsers send no ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and are served.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://NanoHTTP/documentation/NanoHTTP":{"abstract":[{"text":"A small HTTP/1.1 server for apps and tools: routing, files, forms, uploads and WebSockets, without dependencies.","type":"text"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP","kind":"symbol","role":"collection","title":"NanoHTTP","type":"topic","url":"/documentation/nanohttp"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)":{"abstract":[{"text":"A ","type":"text"},{"code":"101 Switching Protocols","type":"codeVoice"},{"text":" response for a session that the server drives. After the","type":"text"},{"text":" ","type":"text"},{"text":"response was sent, the server calls the functions of ","type":"text"},{"code":"session","type":"codeVoice"},{"text":" when the socket has","type":"text"},{"text":" ","type":"text"},{"text":"something to read, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoSocketSession","isActive":true,"type":"reference"},{"text":". Unlike the other variant, this does","type":"text"},{"text":" ","type":"text"},{"text":"not hold the thread of a server that has only one thread: this is how the handler of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocket","isActive":true,"type":"reference"},{"text":" upgrades a connection.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchProtocols"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A13SocketSessionP","text":"NanoSocketSession"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8NanoHTTP0A12HTTPResponseV","text":"NanoHTTPResponse"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPResponse/switchProtocols(_:session:)","kind":"symbol","role":"symbol","title":"switchProtocols(_:session:)","type":"topic","url":"/documentation/nanohttp/nanohttpresponse/switchprotocols(_:session:)"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread":{"abstract":[{"inlineContent":[{"text":"One thread does everything","type":"text"}],"type":"strong"},{"text":": it accepts connections, reads requests, calls","type":"text"},{"text":" ","type":"text"},{"text":"the middleware and the handlers, and writes the responses, one request at a","type":"text"},{"text":" ","type":"text"},{"text":"time. Handlers, middleware and everything else that runs in them need no locks,","type":"text"},{"text":" ","type":"text"},{"text":"because they never run at the same time. ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"that thread (","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","isActive":true,"type":"reference"},{"text":" is its priority); ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)","isActive":true,"type":"reference"},{"text":" uses","type":"text"},{"text":" ","type":"text"},{"text":"the calling thread.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"singleThread"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","kind":"symbol","role":"symbol","title":"NanoHTTPServerIO.Configuration.Threading.singleThread","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/threading-swift.enum/singlethread"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS":{"abstract":[{"text":"The priority of the thread that accepts connections.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"acceptQoS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@NSQualityOfService","text":"QualityOfService"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/acceptQoS","kind":"symbol","role":"symbol","title":"acceptQoS","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/acceptqos"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections":{"abstract":[{"text":"The most connections the server serves at the same time (WebSocket sessions","type":"text"},{"text":" ","type":"text"},{"text":"included). When that many are open, a new connection is answered with","type":"text"},{"text":" ","type":"text"},{"code":"503 Service Unavailable","type":"codeVoice"},{"text":" and closed. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" accepts any number; every connection","type":"text"},{"text":" ","type":"text"},{"text":"uses a thread and a file descriptor. The default is 128.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxConnections"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/maxConnections","kind":"symbol","role":"symbol","title":"maxConnections","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/maxconnections"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/readTimeout":{"abstract":[{"text":"How long the server waits for more of a request once it has begun: the longest","type":"text"},{"text":" ","type":"text"},{"text":"pause between two parts of the request that arrive. A request that stalls longer","type":"text"},{"text":" ","type":"text"},{"text":"is answered with ","type":"text"},{"code":"408 Request Timeout","type":"codeVoice"},{"text":". It is a pause, not the total time: a","type":"text"},{"text":" ","type":"text"},{"text":"request that keeps arriving, slowly, is not cut off. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits","type":"text"},{"text":" ","type":"text"},{"text":"forever. The default is 30 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"readTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/readTimeout","kind":"symbol","role":"symbol","title":"readTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/readtimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout":{"abstract":[{"text":"How long a write to a connection that has been turned over to a session, such as a","type":"text"},{"text":" ","type":"text"},{"text":"WebSocket, may be blocked because the peer does not read: a write that makes no","type":"text"},{"text":" ","type":"text"},{"text":"progress for that long fails, and the session ends. It is shorter than ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"because a message that is sent to many sessions (a chat, see ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoWebSocketHub","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"must not be held up for long by one client that has stopped reading, and on a","type":"text"},{"text":" ","type":"text"},{"text":"server with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/Threading-swift.enum/singleThread","isActive":true,"type":"reference"},{"text":" a client that has stopped reading holds up","type":"text"},{"text":" ","type":"text"},{"text":"the whole server for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever. The default is 5","type":"text"},{"text":" ","type":"text"},{"text":"seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessionWriteTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/sessionWriteTimeout","kind":"symbol","role":"symbol","title":"sessionWriteTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/sessionwritetimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout":{"abstract":[{"text":"How long a write may be blocked because the peer does not read: the connection is","type":"text"},{"text":" ","type":"text"},{"text":"closed when the peer takes nothing for that long. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (or zero) waits forever.","type":"text"},{"text":" ","type":"text"},{"text":"The default is 30 seconds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":"?"}],"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/Configuration-swift.struct/writeTimeout","kind":"symbol","role":"symbol","title":"writeTimeout","type":"topic","url":"/documentation/nanohttp/nanohttpserverio/configuration-swift.struct/writetimeout"},"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/run(_:)":{"abstract":[{"text":"Starts the server like ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/start(_:)","isActive":true,"type":"reference"},{"text":", but accepts connections on the calling thread,","type":"text"},{"text":" ","type":"text"},{"text":"and returns only when the server has been stopped (with ","type":"text"},{"identifier":"doc://NanoHTTP/documentation/NanoHTTP/NanoHTTPServerIO/stop()","isActive":true,"type":"reference"},{"text":", from another","type":"text"},{"text":" ","type":"text"},{"text":"thread or a signal handler).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc:/